<%= form_with model: @collection do |f| %>
  <%= render "shared/errors", record: @collection %>
  <div class="field">
    <%= f.label :name, "Collection name" %>
    <%= f.text_field :name, placeholder: "Summer essentials" %>
  </div>
  <div class="field">
    <%= f.label :position, "Display order" %>
    <%= f.number_field :position, min: 0, step: 1, inputmode: "numeric", class: "num", aria: { describedby: "position_hint" } %>
    <small id="position_hint">Lower numbers appear first on your page.</small>
  </div>
  <div class="form-actions">
    <%= f.submit(@collection.persisted? ? "Save collection" : "Create collection", class: "button accent", data: { disable_with: "Saving…" }) %>
    <%= link_to "Cancel", dashboard_path, class: "button light" %>
  </div>
<% end %>
