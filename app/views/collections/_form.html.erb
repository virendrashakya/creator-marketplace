<%= form_with model: @collection do |f| %><%= render "shared/errors", record: @collection %><div class="field"><%= f.label :name, "Collection name" %><%= f.text_field :name, placeholder: "Summer essentials", autofocus: true %></div><div class="field"><%= f.label :position, "Display order" %><%= f.number_field :position, min: 0 %></div><div class="form-actions"><%= f.submit class: "button pink" %><%= link_to "Cancel", dashboard_path, class: "button light" %></div><% end %>
