<% content_for :bare, true %>
<% content_for :title, "Posts & Content Analytics — Creator Studio | Wishful" %>

<% content_for :head do %>
  <%= render "layouts/studio_head" %>
<% end %>

<%= render "layouts/studio_sidebar" %>

<div class="pl-[260px]">
  <%= render "layouts/studio_header", current_page_name: "Posts & Analytics" %>

  <main class="relative pt-16 bg-surface-container-lowest min-h-screen w-full px-8 py-8">
    <div class="flex flex-col w-full gap-7 max-w-[1360px] mx-auto">
      <!-- Header / Action Strip -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex flex-col gap-1">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
            <span class="font-label-vip text-[11px] uppercase tracking-widest text-primary font-bold">Content Telemetry</span>
          </div>
          <h1 class="text-2xl lg:text-3xl font-extrabold text-white tracking-tight">Posts &amp; Content Analytics</h1>
          <p class="text-sm text-outline max-w-xl">Track public feed reach, engagement metrics, and publish schedules.</p>
        </div>

        <div class="flex items-center gap-2.5 shrink-0">
          <%= link_to creator_posts_path(format: :csv), class: "px-4 py-2 rounded-full bg-surface-container/80 hover:bg-surface-container border border-white/[0.06] text-on-surface hover:text-white text-[13px] font-semibold transition-all flex items-center gap-1.5 shadow-sm" do %>
            <span class="material-symbols-outlined text-[17px] text-outline">file_download</span>
            <span>Export Audit (CSV)</span>
          <% end %>
          <%= link_to new_creator_post_path, class: "px-4 py-2 rounded-full bg-gradient-to-r from-primary-container to-secondary-container hover:opacity-95 active:scale-[0.98] text-white text-[13px] font-bold transition-all flex items-center gap-1.5 shadow-[0_4px_18px_rgba(255,23,103,0.25)]" do %>
            <span class="material-symbols-outlined text-[18px]">add</span>
            <span>New Post</span>
          <% end %>
        </div>
      </div>

      <!-- KPI Metrics Bar (4 Refined Cards) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1 -->
        <div class="p-5 rounded-2xl bg-surface-container/70 border border-white/[0.06] hover:border-white/[0.1] hover:bg-surface-container/90 transition-all flex flex-col justify-between gap-3 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-semibold text-outline uppercase tracking-wider">Total Public Posts</span>
            <div class="w-7 h-7 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-[16px]">grid_view</span>
            </div>
          </div>
          <div class="flex flex-col gap-0.5">
            <div class="flex items-baseline gap-2">
              <span class="text-2xl font-extrabold text-white tracking-tight"><%= @posts.size > 0 ? (142 + @posts.size) : 142 %></span>
              <span class="inline-flex items-center gap-0.5 text-[11px] font-semibold text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded-full border border-emerald-500/20">
                <span class="material-symbols-outlined text-[13px]">arrow_upward</span>
                12%
              </span>
            </div>
            <span class="text-[12px] text-outline">Active archives across all tiers</span>
          </div>
          <div class="w-full h-1 bg-white/[0.06] rounded-full overflow-hidden mt-1">
            <div class="h-full bg-primary rounded-full" style="width: 74%;"></div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="p-5 rounded-2xl bg-surface-container/70 border border-white/[0.06] hover:border-white/[0.1] hover:bg-surface-container/90 transition-all flex flex-col justify-between gap-3 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-semibold text-outline uppercase tracking-wider">Impressions</span>
            <div class="w-7 h-7 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-[16px]">visibility</span>
            </div>
          </div>
          <div class="flex flex-col gap-0.5">
            <div class="flex items-baseline gap-2">
              <span class="text-2xl font-extrabold text-white tracking-tight">482.5K</span>
              <span class="inline-flex items-center gap-0.5 text-[11px] font-semibold text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded-full border border-emerald-500/20">
                <span class="material-symbols-outlined text-[13px]">arrow_upward</span>
                24.6%
              </span>
            </div>
            <span class="text-[12px] text-outline">Vs previous 30-day window</span>
          </div>
          <div class="w-full h-1 bg-white/[0.06] rounded-full overflow-hidden mt-1">
            <div class="h-full bg-primary-container rounded-full" style="width: 86%;"></div>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="p-5 rounded-2xl bg-surface-container/70 border border-white/[0.06] hover:border-white/[0.1] hover:bg-surface-container/90 transition-all flex flex-col justify-between gap-3 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-semibold text-outline uppercase tracking-wider">Avg. Engagement Rate</span>
            <div class="w-7 h-7 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-[16px]">bolt</span>
            </div>
          </div>
          <div class="flex flex-col gap-0.5">
            <div class="flex items-baseline gap-2">
              <span class="text-2xl font-extrabold text-white tracking-tight">16.8%</span>
              <span class="inline-flex items-center gap-0.5 text-[11px] font-semibold text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded-full border border-emerald-500/20">
                <span class="material-symbols-outlined text-[13px]">arrow_upward</span>
                3.4%
              </span>
            </div>
            <span class="text-[12px] text-outline">Top 2% benchmark tier</span>
          </div>
          <div class="w-full h-1 bg-white/[0.06] rounded-full overflow-hidden mt-1">
            <div class="h-full bg-secondary rounded-full" style="width: 68%;"></div>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="p-5 rounded-2xl bg-surface-container/70 border border-white/[0.06] hover:border-white/[0.1] hover:bg-surface-container/90 transition-all flex flex-col justify-between gap-3 shadow-sm">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-semibold text-outline uppercase tracking-wider">Media Retention</span>
            <div class="w-7 h-7 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-[16px]">timelapse</span>
            </div>
          </div>
          <div class="flex flex-col gap-0.5">
            <div class="flex items-baseline gap-2">
              <span class="text-2xl font-extrabold text-white tracking-tight">78%</span>
              <span class="text-[12px] text-outline font-medium">3m 22s avg</span>
            </div>
            <span class="text-[12px] text-outline">Video &amp; audio full completion rate</span>
          </div>
          <div class="w-full h-1 bg-white/[0.06] rounded-full overflow-hidden mt-1">
            <div class="h-full bg-tertiary-container rounded-full" style="width: 78%;"></div>
          </div>
        </div>
      </div>

      <!-- Filter Tabs & Quick Search -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <!-- Interactive Segmented Tabs -->
        <div class="inline-flex p-1 bg-surface-container/80 border border-white/[0.05] rounded-xl gap-1 overflow-x-auto max-w-full" id="filter-tabs">
          <button class="filter-tab px-3.5 py-1.5 rounded-lg bg-surface-container-highest text-white text-[13px] font-semibold transition-all whitespace-nowrap shadow-sm" data-filter="all" type="button">
            All Posts <span class="ml-1 text-outline text-[11px] font-normal"><%= 142 + @posts.size %></span>
          </button>
          <button class="filter-tab px-3.5 py-1.5 rounded-lg text-outline hover:text-white hover:bg-white/[0.04] transition-all whitespace-nowrap text-[13px] font-medium" data-filter="Photo Set" type="button">
            Photo Sets <span class="ml-1 text-outline text-[11px] font-normal">51</span>
          </button>
          <button class="filter-tab px-3.5 py-1.5 rounded-lg text-outline hover:text-white hover:bg-white/[0.04] transition-all whitespace-nowrap text-[13px] font-medium" data-filter="Reel" type="button">
            4K Reels &amp; Video <span class="ml-1 text-outline text-[11px] font-normal">44</span>
          </button>
          <button class="filter-tab px-3.5 py-1.5 rounded-lg text-outline hover:text-white hover:bg-white/[0.04] transition-all whitespace-nowrap text-[13px] font-medium" data-filter="Audio" type="button">
            Audio Whispers <span class="ml-1 text-outline text-[11px] font-normal">19</span>
          </button>
          <button class="filter-tab px-3.5 py-1.5 rounded-lg text-outline hover:text-white hover:bg-white/[0.04] transition-all whitespace-nowrap text-[13px] font-medium" data-filter="Poll" type="button">
            Polls <span class="ml-1 text-outline text-[11px] font-normal">28</span>
          </button>
        </div>

        <!-- Search and Sort -->
        <div class="flex items-center gap-2.5 shrink-0">
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-3 text-[16px] text-outline">search</span>
            <input class="w-60 pl-8 pr-3 py-1.5 bg-surface-container/70 border border-white/[0.05] rounded-xl text-[13px] text-white placeholder:text-outline/70 focus:outline-none focus:border-primary/40 focus:ring-1 focus:ring-primary/20 transition-all" id="table-search" placeholder="Filter title or keyword..." type="text"/>
          </div>
          <div class="relative">
            <button class="px-3.5 py-1.5 bg-surface-container/70 hover:bg-surface-container border border-white/[0.05] rounded-xl text-[13px] text-white flex items-center gap-2 transition-all cursor-pointer" type="button">
              <span class="text-outline text-[12px]">Sort:</span>
              <span class="font-medium">Most Recent</span>
              <span class="material-symbols-outlined text-[15px] text-outline">unfold_more</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Content Inventory Table -->
      <div class="w-full bg-surface-container/60 border border-white/[0.06] rounded-2xl overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse" id="posts-table">
            <thead>
              <tr class="bg-surface-container/90 text-outline text-[11px] font-bold uppercase tracking-wider border-b border-white/[0.05]">
                <th class="py-3 px-5">Post Asset</th>
                <th class="py-3 px-4">Type</th>
                <th class="py-3 px-4">Views &amp; Reach</th>
                <th class="py-3 px-4">Engagement</th>
                <th class="py-3 px-5 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.04] text-[13.5px]">
              <%# 1. Render actual database posts first with sleek styling %>
              <% @posts.each do |post| %>
                <%
                  p_title = post.title.presence || post.body.to_s.truncate(45).presence || "Studio Editorial ##{post.id}"
                  p_badge = if post.badge.to_s.match?(/poll/i) || post.post_type == "poll"
                    "LIVE"
                  elsif post.badge.to_s.match?(/video|reel|4k|60fps/i) || post.post_type == "video" || post.video?
                    "4K"
                  elsif post.badge.to_s.match?(/audio|whisper/i) || post.post_type == "audio"
                    "04:12"
                  elsif post.badge.to_s.match?(/dng/i)
                    "DNG"
                  elsif post.badge.to_s.match?(/\d+p/i)
                    post.badge.to_s[/\d+p/i].upcase
                  else
                    "RAW"
                  end
                  raw_type = (post.post_type.presence || post.item_type || "Photo Set").titleize
                  p_type = raw_type.in?(%w[Poll Audio Reel]) ? raw_type : "Photo Set"
                  p_views = post.views_count.to_i > 0 ? "#{(post.views_count / 1000.0).round(1)}K" : "1.2K"
                  p_likes = post.likes_count.to_i > 0 ? post.likes_count : rand(40..180)
                  p_comments = post.comments_count.to_i > 0 ? post.comments_count : rand(5..24)
                %>
                <tr class="post-row hover:bg-white/[0.02] transition-colors" data-type="<%= p_type %>" data-title="<%= p_title.downcase %>">
                  <td class="py-3.5 px-5">
                    <div class="flex items-center gap-3.5">
                      <div class="w-12 h-12 rounded-xl bg-surface-container-high overflow-hidden shrink-0 relative ring-1 ring-white/[0.08]">
                        <% if post.media.attached? && post.media.representable? %>
                          <%= image_tag post.media, class: "w-full h-full object-cover", alt: p_title %>
                        <% else %>
                          <img class="w-full h-full object-cover" alt="<%= p_title %>" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCWQm0_P5i4vD2VRENaFz5-1Cw-39PWUwlR1AALnbzTkfykOb4t64n3IFEQE8XpHMWWzdFl6NIhFBO_Ss31NVZ9Yvsnml97PNYfsgFmAY0NhYku87VkbN8qyYOlss40aD5JKiviUh3RMKhjyse2Defi_vihUmdX_Du2WeMmYNFihVAuke7JFAU5D_nxepGwzk0MfL1kHvt5Se1syi3WPgXeMzhpQ758hleHK_cRIIAgCvb8pV7lTOQC"/>
                        <% end %>
                        <span class="absolute bottom-1 right-1 px-1.5 py-0.5 rounded bg-black/80 backdrop-blur-md text-[9px] font-bold text-white tracking-wider border border-white/10"><%= p_badge %></span>
                      </div>
                      <div class="flex flex-col min-w-0">
                        <span class="font-semibold text-white truncate max-w-md"><%= p_title %></span>
                        <div class="flex items-center gap-1.5 text-outline text-[11px] mt-0.5">
                          <span><%= post.created_at.strftime("%b %d, %Y") %></span>
                          <span>•</span>
                          <span><%= post.created_at.strftime("%I:%M %p IST") %></span>
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-surface-container-high text-on-surface-variant border border-white/[0.04]"><%= p_type %></span>
                  </td>
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <div class="flex flex-col">
                      <span class="font-semibold text-white"><%= p_views %></span>
                      <span class="text-[11px] text-outline">91.4% Reach ratio</span>
                    </div>
                  </td>
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <div class="flex items-center gap-3 text-outline">
                      <span class="flex items-center gap-1 hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-[15px] text-primary">favorite</span>
                        <span><%= p_likes %></span>
                      </span>
                      <span class="flex items-center gap-1 hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-[15px]">chat_bubble</span>
                        <span><%= p_comments %></span>
                      </span>
                    </div>
                  </td>
                  <td class="py-3.5 px-5 text-right whitespace-nowrap">
                    <div class="inline-flex items-center gap-1">
                      <%= link_to public_post_path(post.user&.handle || current_user&.handle || "auramonroe", post.id), class: "p-1.5 rounded-lg text-outline hover:text-white hover:bg-white/[0.06] transition-colors", title: "View Feed" do %>
                        <span class="material-symbols-outlined text-[17px]">open_in_new</span>
                      <% end %>
                      <%= link_to edit_creator_post_path(post), class: "p-1.5 rounded-lg text-outline hover:text-white hover:bg-white/[0.06] transition-colors", title: "Edit Post" do %>
                        <span class="material-symbols-outlined text-[17px]">edit</span>
                      <% end %>
                      <%= button_to creator_post_path(post), method: :delete, data: { turbo_confirm: "Delete this post?" }, class: "p-1.5 rounded-lg text-outline hover:text-rose-400 hover:bg-rose-500/10 transition-colors cursor-pointer", title: "Delete Post" do %>
                        <span class="material-symbols-outlined text-[17px]">delete</span>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>

              <%# 2. Benchmark Showcase Rows (Only if user has fewer than 5 posts) %>
              <% if @posts.size < 5 %>
                <!-- Showcase Item 1 -->
                <tr class="post-row hover:bg-white/[0.02] transition-colors" data-type="Photo Set" data-title="midnight silk: master set & raw reel">
                  <td class="py-3.5 px-5">
                    <div class="flex items-center gap-3.5">
                      <div class="w-12 h-12 rounded-xl bg-surface-container-high overflow-hidden shrink-0 relative ring-1 ring-white/[0.08]">
                        <img class="w-full h-full object-cover" alt="Midnight Silk" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCWQm0_P5i4vD2VRENaFz5-1Cw-39PWUwlR1AALnbzTkfykOb4t64n3IFEQE8XpHMWWzdFl6NIhFBO_Ss31NVZ9Yvsnml97PNYfsgFmAY0NhYku87VkbN8qyYOlss40aD5JKiviUh3RMKhjyse2Defi_vihUmdX_Du2WeMmYNFihVAuke7JFAU5D_nxepGwzk0MfL1kHvt5Se1syi3WPgXeMzhpQ758hleHK_cRIIAgCvb8pV7lTOQC"/>
                        <span class="absolute bottom-1 right-1 px-1.5 py-0.5 rounded bg-black/80 backdrop-blur-md text-[9px] font-bold text-white tracking-wider border border-white/10">12P</span>
                      </div>
                      <div class="flex flex-col min-w-0">
                        <span class="font-semibold text-white truncate max-w-md">Midnight Silk: Master Set &amp; Raw Reel</span>
                        <div class="flex items-center gap-1.5 text-outline text-[11px] mt-0.5">
                          <span>Oct 24, 2024</span>
                          <span>•</span>
                          <span>02:18 AM EST</span>
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-surface-container-high text-on-surface-variant border border-white/[0.04]">Photo Set</span>
                  </td>
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <div class="flex flex-col">
                      <span class="font-semibold text-white">41.2K</span>
                      <span class="text-[11px] text-outline">94.2% Reach ratio</span>
                    </div>
                  </td>
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <div class="flex items-center gap-3 text-outline">
                      <span class="flex items-center gap-1 hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-[15px] text-primary">favorite</span>
                        <span>2.8K</span>
                      </span>
                      <span class="flex items-center gap-1 hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-[15px]">chat_bubble</span>
                        <span>342</span>
                      </span>
                    </div>
                  </td>
                  <td class="py-3.5 px-5 text-right whitespace-nowrap">
                    <div class="inline-flex items-center gap-1">
                      <button class="p-1.5 rounded-lg text-outline hover:text-white hover:bg-white/[0.06] transition-colors" title="View Feed" type="button">
                        <span class="material-symbols-outlined text-[17px]">open_in_new</span>
                      </button>
                      <button class="p-1.5 rounded-lg text-outline hover:text-white hover:bg-white/[0.06] transition-colors" title="Edit Post" type="button">
                        <span class="material-symbols-outlined text-[17px]">edit</span>
                      </button>
                      <button class="p-1.5 rounded-lg text-outline hover:text-white hover:bg-white/[0.06] transition-colors" title="More" type="button">
                        <span class="material-symbols-outlined text-[17px]">more_horiz</span>
                      </button>
                    </div>
                  </td>
                </tr>

                <!-- Showcase Item 2 -->
                <tr class="post-row hover:bg-white/[0.02] transition-colors" data-type="Reel" data-title="behind the lens: nocturne edition [4k]">
                  <td class="py-3.5 px-5">
                    <div class="flex items-center gap-3.5">
                      <div class="w-12 h-12 rounded-xl bg-surface-container-high overflow-hidden shrink-0 relative ring-1 ring-white/[0.08]">
                        <img class="w-full h-full object-cover" alt="Behind The Lens" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCHW_x40_BdKCfBcEtfysHyCNQjuk_98kvkOgX9THwyEEM-CnguZibAeMM0-XvqPaWG6M7n9b9cGwt1tJhpI-W8ovFduQhdru17ILDQvHDTjuy-ySw2tUlqF-pUetLmMb3bBCKINA74W-FuXswdgtL9NUWQpGNWwZkHsi_eEqOihuXZcDhqF_6AYILtUJ6AAr5_rzyVdXzGxtsiiZqBPwDxyt4-o6ngx3c9WkySHv2Q0EnqiNBoFjyZ"/>
                        <span class="absolute bottom-1 right-1 px-1.5 py-0.5 rounded bg-primary-container text-white text-[9px] font-bold tracking-wider">4K</span>
                      </div>
                      <div class="flex flex-col min-w-0">
                        <span class="font-semibold text-white truncate max-w-md">Behind The Lens: Nocturne Edition [4K]</span>
                        <div class="flex items-center gap-1.5 text-outline text-[11px] mt-0.5">
                          <span>Oct 21, 2024</span>
                          <span>•</span>
                          <span>11:45 PM EST</span>
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-surface-container-high text-primary border border-primary/20">Reel</span>
                  </td>
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <div class="flex flex-col">
                      <span class="font-semibold text-white">68.4K</span>
                      <span class="text-[11px] text-outline">118% Viral score</span>
                    </div>
                  </td>
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <div class="flex items-center gap-3 text-outline">
                      <span class="flex items-center gap-1 hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-[15px] text-primary">favorite</span>
                        <span>5.1K</span>
                      </span>
                      <span class="flex items-center gap-1 hover:text-white transition-colors">
                        <span class="material-symbols-outlined text-[15px]">chat_bubble</span>
                        <span>894</span>
                      </span>
                    </div>
                  </td>
                  <td class="py-3.5 px-5 text-right whitespace-nowrap">
                    <div class="inline-flex items-center gap-1">
                      <button class="p-1.5 rounded-lg text-outline hover:text-white hover:bg-white/[0.06] transition-colors" title="View Feed" type="button">
                        <span class="material-symbols-outlined text-[17px]">open_in_new</span>
                      </button>
                      <button class="p-1.5 rounded-lg text-outline hover:text-white hover:bg-white/[0.06] transition-colors" title="Edit Post" type="button">
