<%= form_with model: @contact_reveal do |f| %>
  <%= render "shared/errors", record: @contact_reveal %>
  <div class="field">
    <%= f.label :label, "What are you sharing?" %>
    <%= f.text_field :label, placeholder: "My personal WhatsApp" %>
  </div>
  <div class="field">
    <%= f.label :secret_value, "The details" %>
    <%= f.text_area :secret_value, placeholder: "Shown only to people whose payment you confirm…", spellcheck: false %>
    <small>Stays hidden until you approve a payment.</small>
  </div>
  <div class="field-row">
    <%= render "shared/price_field", f: f, record: @contact_reveal, field: :price_cents, label: "Price", placeholder: "49900" %>
    <div class="field">
      <%= f.label :currency, "Currency" %>
      <%= f.select :currency, [ [ "Rupees (₹)", "INR" ], [ "Dollars ($)", "USD" ] ] %>
    </div>
  </div>
  <label class="check">
    <%= f.check_box :published %>
    Show this on my page
  </label>
  <div class="form-actions">
    <%= f.submit(@contact_reveal.persisted? ? "Save contact reveal" : "Create contact reveal", class: "button accent", data: { disable_with: "Saving…" }) %>
    <%= link_to "Cancel", dashboard_path, class: "button light" %>
  </div>
<% end %>
