<%= form_with model: @contact_reveal do |f| %>
  <%= render "shared/errors", record: @contact_reveal %>
  <div class="field"><%= f.label :label, "What are you sharing?" %><%= f.text_field :label, placeholder: "My personal WhatsApp" %></div>
  <div class="field"><%= f.label :secret_value, "The contact details" %><%= f.text_area :secret_value, placeholder: "Only shown to people who pay" %><small class="muted">Kept private until someone purchases.</small></div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><div class="field"><%= f.label :price_cents, "Price (paise/cents)" %><%= f.number_field :price_cents, min: 1, placeholder: "49900" %></div><div class="field"><%= f.label :currency %><%= f.select :currency, [["INR", "INR"], ["USD", "USD"]] %></div></div>
  <div class="field"><label><%= f.check_box :published %> Show on my public profile</label></div>
  <div class="form-actions"><%= f.submit class: "button pink" %><%= link_to "Cancel", dashboard_path, class: "button light" %></div>
<% end %>
