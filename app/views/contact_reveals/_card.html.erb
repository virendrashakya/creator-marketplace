<% revealed = card.revealed_for?(current_user) %>
<article class="reveal">
  <div class="min0" style="flex: 1 1 240px">
    <div class="reveal-label break"><%= card.label %></div>
    <div class="reveal-value ref" translate="no">
      <%= revealed ? card.secret_value : "+91 98••• •••••" %>
    </div>
    <div class="reveal-note">
      <%= revealed ? "Revealed to you" : "Unlocks after #{card.user.name.split.first} approves your payment" %>
    </div>
  </div>
  <div style="flex: none">
    <% if revealed %>
      <span class="badge badge--ok">Revealed</span>
    <% else %>
      <%= render "shared/buy_button", purchasable: card, creator: card.user,
            label: "Unlock for #{card.price_label}", signed_out_label: "Sign in to unlock",
            price_label: card.price_label, fallback_path: purchase_contact_reveal_path(card) %>
    <% end %>
  </div>
</article>
