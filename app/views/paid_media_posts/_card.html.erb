<% unlocked = card.unlocked_for?(current_user) %>
<% share_ref = current_user&.handle || "vip" %>
<% share_url = profile_url(card.user.handle, tab: "vault", drop: card.id, ref: share_ref) %>
<% share_text = "Check out '#{card.title}' by #{card.user.name} on Wishful (#{card.price_label}): #{share_url}" %>
<% is_featured = card_counter.zero? if defined?(card_counter) %>
<article class="media-card media-card--teaser <%= 'is-unlocked' if unlocked %>" id="post-<%= card.id %>">
  <div class="media-preview">
    <!-- Top Tags Overlay -->
    <div class="media-preview-tags">
      <div class="media-preview-tags-left">
        <% if is_featured %>
          <span class="preview-badge preview-badge--featured">FEATURED DROP</span>
        <% elsif card.media_type == "video" %>
          <span class="preview-badge preview-badge--video">VIDEO DROP</span>
        <% else %>
          <span class="preview-badge preview-badge--exclusive">Exclusive Shoot</span>
        <% end %>
        <span class="preview-badge preview-badge--dark">
          <%= card.media_type == "video" ? "4K Video • 6 mins" : "16 Photos • 2 Clips" %>
        </span>
      </div>
      <div class="media-preview-tags-right">
        <span class="preview-badge preview-badge--dark">SET • RAW • 4K</span>
      </div>
    </div>

    <% if unlocked && card.media.attached? && card.media_type == "image" %>
      <div class="media-shield" aria-hidden="true" oncontextmenu="return false;"></div>
      <%= image_tag media_paid_media_post_path(card), alt: card.title, width: 480, height: 380, loading: "lazy", draggable: false, oncontextmenu: "return false;", class: "media-protected-img" %>
    <% elsif card.preview.attached? || (card.media.attached? && card.media_type == "image") %>
      <div class="media-shield" aria-hidden="true" oncontextmenu="return false;"></div>
      <%= image_tag preview_paid_media_post_path(card), alt: "", width: 480, height: 380, loading: "lazy", draggable: false, oncontextmenu: "return false;", class: (unlocked ? "" : "media-blur-img") %>
    <% end %>

    <% if unlocked %>
      <span class="media-unlocked">
        <span aria-hidden="true">✨</span> Unlocked &amp; Yours
      </span>
      <% if current_user.present? && current_user != card.user %>
        <span class="media-license-pill">
          🔒 Licensed to @<%= current_user.handle %>
        </span>
      <% end %>
    <% else %>
      <!-- Center Lock Disc Overlay -->
      <div class="media-lock-overlay">
        <div class="media-lock-disc">
          <% if card.media_type == "video" %>
            <svg viewBox="0 0 24 24" fill="currentColor" style="width: 20px; height: 20px; margin-left: 2px;" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3"/>
            </svg>
          <% else %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px;" aria-hidden="true">
              <rect x="4.5" y="10" width="15" height="11" rx="2.5"/>
              <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
              <circle cx="12" cy="15.5" r="1.5" fill="currentColor"/>
            </svg>
          <% end %>
        </div>
        <div class="media-lock-title">
          <%= card.media_type == "video" ? "4K Video Teaser • 6 mins" : "4K UNCENSORED SET LOCKED" %>
        </div>
        <div class="media-lock-sub">
          <%= card.media_type == "video" ? "Behind the scenes try-on & uncut clips" : "High-frequency facial detail & raw camera-roll previews securely sealed" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="media-body">
    <div class="media-header-row">
      <div class="media-title"><%= card.title %></div>
      <div class="media-price-block">
        <span class="media-price-num"><%= money(card.price_cents) %></span>
        <span class="media-price-channel">Direct UPI</span>
      </div>
    </div>

    <div class="media-desc">
      <%= card.caption.presence || "Exclusive private drop. Tap below to unlock via direct UPI." %>
    </div>

    <% if unlocked %>
      <div class="media-actions-row">
        <% if card.media_type == "video" && card.media.attached? %>
          <%= link_to media_paid_media_post_path(card), class: "btn btn--block btn--accent", target: "_blank", rel: "noopener noreferrer" do %>
            Watch 4K Video<span class="visually-hidden"> (opens in a new tab)</span>
          <% end %>
        <% else %>
          <span class="badge badge--ok" style="display: block; text-align: center; padding: 10px; width: 100%;">Full 4K Set Unlocked</span>
        <% end %>
      </div>
    <% else %>
      <div class="media-footer-row">
        <div class="media-watermark-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 12px; height: 12px; display: inline-block; vertical-align: -1px;" aria-hidden="true">
            <rect x="4.5" y="10" width="15" height="11" rx="2.5"/>
            <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
          </svg>
          Stamped with your @<%= current_user&.handle || "handle" %>
        </div>
        <%= link_to new_payment_claim_path("PaidMediaPost", card.id), class: "btn btn--accent pf-instant-unlock-btn" do %>
          Instant UPI Unlock ➔
        <% end %>
      </div>
    <% end %>

    <!-- Subtle Share Dropdown -->
    <div class="media-sub-share">
      <button type="button" class="btn-share-inline btn-share-teaser"
              data-share-url="<%= share_url %>"
              data-share-title="<%= card.title %>"
              data-share-text="<%= share_text %>"
              onclick="handleShareTeaser(this)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 12px; height: 12px; margin-right: 4px; vertical-align: -1px;" aria-hidden="true">
          <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
        </svg>
        Share preview link
      </button>
    </div>
  </div>
</article>
