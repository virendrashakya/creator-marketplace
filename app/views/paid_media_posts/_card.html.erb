<% unlocked = unlocked_post_ids.include?(card.id) || signed_in? && (current_user == card.user || card.subscription_plan && current_user.subscribed_to?(card.subscription_plan)) %>
<article class="public-card paid-card">
  <% if unlocked && card.media.attached? && card.media_type == "image" %><%= image_tag card.media, class: "public-image", alt: card.title %><% elsif card.preview.attached? %><%= image_tag card.preview, class: "public-image", alt: "Preview of #{card.title}" %><% else %><div class="public-image" style="display:grid;place-items:center">🔒</div><% end %>
  <div><div class="public-title"><%= card.title %></div><div class="public-note"><%= card.caption.presence || "Exclusive #{card.media_type}" %></div><% if unlocked %><% if card.media_type == "video" && card.media.attached? %><%= link_to "Watch video →", url_for(card.media), target: "_blank", rel: "noopener", style: "font-size:12px;color:#ff5a7b;font-weight:700" %><% else %><span style="font-size:12px;color:#43845e;font-weight:700">Unlocked</span><% end %><% else %><div style="margin-top:8px"><% if signed_in? %><%= button_to "Unlock for #{card.price_label}", purchase_paid_media_post_path(card), class: "button pink", style: "padding:8px 11px;font-size:12px" %><% else %><%= link_to "Sign in to unlock · #{card.price_label}", sign_in_path, class: "button pink", style: "padding:8px 11px;font-size:12px" %><% end %></div><% end %></div>
  <span class="arrow"><%= unlocked ? "✦" : "🔒" %></span>
</article>
