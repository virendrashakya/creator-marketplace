<% if @shared_drop.present? %>
  <% content_for :title, "#{@shared_drop.title} — VIP Drop by #{@user.name} | Wishful" %>
  <% content_for :description, "Exclusive Vault drop (#{@shared_drop.price_label}) by #{@user.name}. Unlock via direct UPI on Wishful." %>
  <% content_for :og_image, preview_paid_media_post_url(@shared_drop) %>
<% else %>
  <% content_for :title, "#{@user.name} (@#{@user.handle}) | Wishful" %>
  <% content_for :description, @user.bio.presence || "Exclusive vault drops, recommendations, and direct channels by #{@user.name} on Wishful." %>
  <% if @user.profile_picture.attached? %>
    <% content_for :og_image, url_for(@user.profile_picture) %>
  <% end %>
<% end %>

<% content_for :chrome, "creator" %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&display=swap">
  <link rel="stylesheet" href="/assets/profile.css" data-turbo-track="reload">
  <% if @own_page %>
    <link rel="stylesheet" href="/assets/inline-edit.css" data-turbo-track="reload">
    <script src="/assets/js/inline-edit.js" data-turbo-track="reload" defer></script>
  <% end %>
<% end %>

<div class="profile theme-<%= @user.theme %> layout-<%= @user.profile_layout %>"
     <%= 'data-ie-root' if @own_page %>>
  <div class="profile-inner">

    <% if @own_page %>
      <%= render "profiles/edit_layer", user: @user, active_tab: @active_tab %>
    <% end %>

    <!-- ============================================================== -->
    <!-- DESKTOP TOP NAVBAR (>= 900px)                                  -->
    <!-- ============================================================== -->
    <header class="cv-desktop-navbar show-desktop">
      <div class="cv-nav-left">
        <a href="/" class="cv-brand">
          <span class="cv-brand-icon">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
          </span>
          <span class="cv-brand-text">CreatorVault</span>
        </a>
        <div class="cv-nav-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" class="cv-search-icon">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" placeholder="Search creator drops, styling tags..." aria-label="Search">
        </div>
      </div>
      <nav class="cv-nav-links">
        <a href="/" class="cv-nav-link">Discover</a>
        <a href="/trending" class="cv-nav-link">
          Trending Drops
          <span class="cv-flame-tag">🔥</span>
        </a>
        <a href="/creators" class="cv-nav-link">VIP Creators</a>
        <a href="/my-purchases" class="cv-nav-link">My Purchases</a>
      </nav>
      <div class="cv-nav-right">
        <%= link_to new_payment_claim_path("User", @user.id), class: "cv-direct-upi-btn" do %>
          <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
          Direct UPI Pay
        <% end %>
        <% if signed_in? %>
          <%= link_to "Dashboard", dashboard_path, class: "cv-login-btn" %>
          <% if current_user.profile_picture.attached? %>
            <%= image_tag current_user.profile_picture, class: "cv-user-avatar", alt: current_user.name %>
          <% else %>
            <div class="cv-user-avatar cv-user-avatar--fallback"><%= current_user.name.first&.upcase %></div>
          <% end %>
        <% else %>
          <%= link_to "Login", sign_in_path, class: "cv-login-btn" %>
          <div class="cv-user-avatar cv-user-avatar--guest">👤</div>
        <% end %>
      </div>
    </header>

    <!-- ============================================================== -->
    <!-- MOBILE TOP BAR (< 900px)                                       -->
    <!-- ============================================================== -->
    <header class="cv-mobile-navbar show-mobile">
      <div class="cv-mob-brand">
        <span class="cv-mob-icon">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
          </svg>
        </span>
        <span class="cv-mob-title">Wishful</span>
        <span class="cv-mob-creator-pill">CREATOR &amp; FAN</span>
      </div>
      <div class="cv-mob-actions">
        <button type="button" class="cv-mob-share-btn" data-share-url="<%= profile_url(@user.handle) %>" data-share-title="<%= @user.name %> on Wishful" aria-label="Share">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
            <polyline points="16 6 12 2 8 6"></polyline>
            <line x1="12" y1="2" x2="12" y2="15"></line>
          </svg>
        </button>
        <% if signed_in? %>
          <%= link_to "Dashboard", dashboard_path, class: "cv-mob-open-btn" %>
        <% else %>
          <%= link_to "Open App ➔", sign_in_path, class: "cv-mob-open-btn" %>
        <% end %>
      </div>
    </header>

    <!-- ============================================================== -->
    <!-- COVER HERO BANNER                                              -->
    <!-- ============================================================== -->
    <div class="cv-banner-container"<%= ' data-ie-zone'.html_safe if @own_page %>>
      <div class="cv-banner-media">
        <% if @user.banner.attached? %>
          <%= image_tag @user.banner, alt: "", width: 1600, height: 600, class: "cv-banner-img" %>
        <% elsif @user.avatar_url.present? %>
          <%= image_tag @user.avatar_url, alt: "", width: 1600, height: 600, class: "cv-banner-img" %>
        <% else %>
          <div class="cv-banner-placeholder"></div>
        <% end %>

        <!-- Banner Overlays -->
        <div class="cv-banner-badge cv-banner-badge--top-left show-desktop">
          <span class="cv-pulse-dot"></span>
          Mumbai • Active VIP Drops
        </div>
        <div class="cv-banner-badge cv-banner-badge--top-right-desktop show-desktop">
          <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13">
            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
          </svg>
          Direct UPI Payout Verified
        </div>

        <div class="cv-banner-badge cv-banner-badge--top-right-mobile show-mobile">
          <span class="cv-pulse-dot"></span>
          Mumbai • Active VIP Drops
        </div>

        <!-- Desktop Bottom Banner Text -->
        <div class="cv-banner-overlay-bottom show-desktop">
          <div class="cv-banner-couture">COUTURE VAULT 2026</div>
          <h2 class="cv-banner-headline">Architectural Silhouettes &amp; Contemporary Drapes</h2>
        </div>
        <div class="cv-banner-cam-tag show-desktop">
          📷 Sony Alpha 7R V • 4K 60fps HDR
        </div>
      </div>

      <% if @own_page %>
        <%= render "profiles/photo_drop", user: @user, field: :banner,
              variant: "cover",
              title: @user.banner.attached? ? "Change cover photo" : "Add a cover photo",
              hint: "Drop a photo here, or click to choose" %>
      <% end %>
    </div>

    <!-- ============================================================== -->
    <!-- DESKTOP CREATOR PROFILE CARD (>= 900px)                        -->
    <!-- ============================================================== -->
    <section class="cv-desktop-profile-card show-desktop">
      <div class="cv-dp-top-row">
        <!-- Left: Avatar Stack with Layered Reel Thumbnails -->
        <div class="cv-dp-avatar-box">
          <div class="cv-dp-avatar-frame cv-dp-avatar-frame--back2"></div>
          <div class="cv-dp-avatar-frame cv-dp-avatar-frame--back1"></div>
          <div class="cv-dp-avatar">
            <% if @user.profile_picture.attached? %>
              <%= image_tag @user.profile_picture, alt: @user.name, width: 220, height: 220 %>
            <% elsif @user.avatar_url.present? %>
              <%= image_tag @user.avatar_url, alt: @user.name, width: 220, height: 220 %>
            <% else %>
              <%= @user.name.first&.upcase %>
            <% end %>
            <div class="cv-verified-disc">
              <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- Center: Name, Category, Bio -->
        <div class="cv-dp-info">
          <div class="cv-dp-name-row">
            <h1 class="cv-dp-name"><%= @user.name %></h1>
            <span class="cv-dp-verified-pill">
              👑 Verified Fashion VIP
            </span>
          </div>
          <div class="cv-dp-category">
            Fashion &amp; Fusion, Indo-Western Drapes • Mumbai, India
          </div>
          <p class="cv-dp-bio">
            32 | Mumbai. Contemporary fusion drapes, jacket blouses &amp; architectural saree silhouettes. Direct VIP unlocks below.
          </p>
        </div>

        <!-- Right: Actions -->
        <div class="cv-dp-actions">
          <% if @own_page %>
            <%= link_to "Edit Profile", profile_path(@user.handle, tab: @active_tab, edit: 1), class: "cv-btn cv-btn--outline", data: { ie_open: true } %>
          <% elsif !signed_in? %>
            <%= link_to "+ Follow Creator", sign_in_path, class: "cv-btn cv-btn--outline" %>
          <% elsif @following %>
            <%= button_to "Following", unfollow_creator_path(@user.handle), method: :delete, class: "cv-btn cv-btn--outline" %>
          <% else %>
            <%= button_to "+ Follow Creator", follow_creator_path(@user.handle), method: :post, class: "cv-btn cv-btn--outline" %>
          <% end %>

          <% fan_ref = current_user&.handle || "fan" %>
          <% fan_share_url = profile_url(@user.handle, ref: fan_ref) %>
          <button type="button" class="cv-btn cv-btn--ruby" data-share-url="<%= fan_share_url %>" data-share-title="<%= @user.name %> on Wishful">
            Share (?ref=<%= fan_ref %>)
          </button>
        </div>
      </div>

      <!-- 4-Column Stats Row -->
      <div class="cv-dp-stats-row">
        <div class="cv-stat-box">
          <div class="cv-stat-icon cv-stat-icon--pink">📦</div>
          <div class="cv-stat-details">
            <div class="cv-stat-num"><%= @paid_media_posts.size > 0 ? @paid_media_posts.size : 24 %></div>
            <div class="cv-stat-lbl">Vault Drops Active</div>
          </div>
        </div>
        <div class="cv-stat-box">
          <div class="cv-stat-icon cv-stat-icon--yellow">⭐</div>
          <div class="cv-stat-details">
            <div class="cv-stat-num"><%= @user.followers_count > 0 ? number_to_human(@user.followers_count, units: { thousand: "k", million: "m" }, format: "%n%u", precision: 2, significant: true) : "18.4k" %></div>
            <div class="cv-stat-lbl">VIP Fan Circle</div>
          </div>
        </div>
        <div class="cv-stat-box">
          <div class="cv-stat-icon cv-stat-icon--green">⚡</div>
          <div class="cv-stat-details">
            <div class="cv-stat-num cv-stat-num--green">Instant</div>
            <div class="cv-stat-lbl">Direct UPI Settlement</div>
          </div>
        </div>
        <div class="cv-stat-box">
          <div class="cv-stat-icon cv-stat-icon--red">🛡️</div>
          <div class="cv-stat-details">
            <div class="cv-stat-num cv-stat-num--red">0% Cut</div>
            <div class="cv-stat-lbl">100% to Creator</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- MOBILE CREATOR PROFILE HEADER (< 900px)                        -->
    <!-- ============================================================== -->
    <header class="cv-mobile-profile show-mobile">
      <div class="cv-mp-avatar-row">
        <div class="cv-mp-avatar">
          <% if @user.profile_picture.attached? %>
            <%= image_tag @user.profile_picture, alt: @user.name, width: 180, height: 180 %>
          <% elsif @user.avatar_url.present? %>
            <%= image_tag @user.avatar_url, alt: @user.name, width: 180, height: 180 %>
          <% else %>
            <%= @user.name.first&.upcase %>
          <% end %>
          <div class="cv-verified-disc">
            <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13">
              <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
            </svg>
          </div>
        </div>

        <% instagram_url = @social_links.find { |s| s[0].downcase == "instagram" }&.then { |s| social_url(s[2], s[1]) } || "https://instagram.com/#{@user.handle}" %>
        <%= link_to instagram_url, class: "cv-mp-handle-pill", target: "_blank", rel: "noopener noreferrer" do %>
          📷 @<%= @user.handle %> <span aria-hidden="true">↗</span>
        <% end %>
      </div>

      <div class="cv-mp-name-row">
        <h1 class="cv-mp-name"><%= @user.name %></h1>
        <span class="cv-mp-check-icon">
          <svg viewBox="0 0 24 24" fill="#C2185B" width="18" height="18">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
          </svg>
        </span>
      </div>

      <div class="cv-mp-category">
        Fashion &amp; Fusion, Indo-Western Drapes • Mumbai, India
      </div>

      <p class="cv-mp-bio">
        32 | Mumbai. Contemporary fusion drapes, jacket blouses &amp; architectural saree silhouettes. Direct VIP unlocks below.
      </p>

      <!-- 3-Column Stats Card -->
      <div class="cv-mp-stats-card">
        <div class="cv-mp-stat-cell">
          <div class="cv-mp-stat-val"><%= @paid_media_posts.size > 0 ? @paid_media_posts.size : 24 %></div>
          <div class="cv-mp-stat-tag">Vault Drops</div>
        </div>
        <div class="cv-mp-stat-cell">
          <div class="cv-mp-stat-val"><%= @user.followers_count > 0 ? number_to_human(@user.followers_count, units: { thousand: "k", million: "m" }, format: "%n%u", precision: 2, significant: true) : "18.4k" %></div>
          <div class="cv-mp-stat-tag">VIP Fans</div>
        </div>
        <div class="cv-mp-stat-cell">
          <div class="cv-mp-stat-val cv-mp-stat-val--green">Instant</div>
          <div class="cv-mp-stat-tag">Direct UPI</div>
        </div>
      </div>

      <!-- Action Buttons Row -->
      <div class="cv-mp-actions-row">
        <% if @own_page %>
          <%= link_to "Edit Profile", profile_path(@user.handle, tab: @active_tab, edit: 1), class: "cv-mp-btn cv-mp-btn--dark", data: { ie_open: true } %>
        <% elsif !signed_in? %>
          <%= link_to sign_in_path, class: "cv-mp-btn cv-mp-btn--dark" do %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            Follow Creator
          <% end %>
        <% elsif @following %>
          <%= button_to unfollow_creator_path(@user.handle), method: :delete, class: "cv-mp-btn cv-mp-btn--dark" do %>
            Following
          <% end %>
        <% else %>
          <%= button_to follow_creator_path(@user.handle), method: :post, class: "cv-mp-btn cv-mp-btn--dark" do %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            Follow Creator
          <% end %>
        <% end %>

        <% fan_ref = current_user&.handle || "fan" %>
        <% fan_share_url = profile_url(@user.handle, ref: fan_ref) %>
        <button type="button" class="cv-mp-btn cv-mp-btn--pink" data-share-url="<%= fan_share_url %>" data-share-title="<%= @user.name %> on Wishful">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><polyline points="16 6 12 2 8 6"></polyline><line x1="12" y1="2" x2="12" y2="15"></line></svg>
          Share (?ref=<%= fan_ref %>)
        </button>
      </div>
    </header>

    <!-- ============================================================== -->
    <!-- DESKTOP HERO GRID: VIP PASS (60%) + 100% GUARANTEE (40%)       -->
    <!-- ============================================================== -->
    <% vip_plan = @subscription_plans.first %>
    <% default_plan_price = vip_plan ? money(vip_plan.price_cents) : "₹499" %>
    <section class="cv-desktop-hero-grid show-desktop">
      <!-- Left: VIP Pass Hero Card -->
      <div class="cv-dh-vip-card">
        <div class="cv-dh-vip-top">
          <span class="cv-dh-pill cv-dh-pill--red">★ MOST POPULAR PASS</span>
          <span class="cv-dh-price"><%= default_plan_price %> <span class="cv-dh-term">/ month</span></span>
        </div>
        <h3 class="cv-dh-title">Ananya's Inner Circle &amp; VIP Vault Pass</h3>
        <p class="cv-dh-sub">
          Monthly recurring or direct single-month access. Cancel anytime directly in GPay or PhonePe.
        </p>
        <ul class="cv-dh-perks">
          <li>
            <span class="cv-dh-chk">✔</span>
            <span><strong>Auto-unlock all 24+ Vault photoshoot drops</strong> (High-resolution 4K uncensored editorial series + raw grading files).</span>
          </li>
          <li>
            <span class="cv-dh-chk">✔</span>
            <span><strong>Private Close Friends Instagram &amp; WhatsApp Broadcast circle</strong> for real-time behind-the-scenes fittings &amp; Mumbai fashion week invites.</span>
          </li>
          <li>
            <span class="cv-dh-chk">✔</span>
            <span><strong>Direct 1:1 priority saree drape styling feedback</strong> via dedicated VIP DMs and customized lookbook critiques.</span>
          </li>
        </ul>
        <div class="cv-dh-actions">
          <% if vip_plan %>
            <%= render "shared/buy_button", purchasable: vip_plan, creator: @user,
                  label: "⚡ JOIN VIP PASS VIA INSTANT UPI (#{default_plan_price})",
