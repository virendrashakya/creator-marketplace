<% content_for :title, "#{@user.name} (@#{@user.handle}) | Wishful" %>
<% content_for :description, @user.bio.presence || "#{@user.name}'s collections, looks and Close Friends on Wishful. Pay directly over UPI." %>
<% content_for :chrome, "fan" %>
<% content_for :body_class, "is-profile" %>
<% if (og = wf_banner_src(@user)) %>
  <% content_for :og_image, og.start_with?("http") ? og : "#{request.base_url}#{og}" %>
<% end %>

<div class="w-phone">
  <header class="w-topbar">
    <div class="w-topbar-handle">
      <span class="w-ellipsis" translate="no"><%= @user.handle %></span><%= wf_verified if @user.upi_id.present? %>
    </div>
    <div class="w-topbar-actions">
      <%= render "shared/theme_switch", compact: true %>
      <button type="button" class="w-icon-btn" data-share-url="<%= profile_url(@user.handle) %>" data-share-title="<%= @user.name %> on Wishful" aria-label="Share this profile">
        <%= wf_icon(:share) %>
      </button>
      <% if @own_page %>
        <%= link_to "Studio", dashboard_path, class: "w-btn w-btn--sm w-btn--outline" %>
      <% end %>
    </div>
  </header>

  <div class="w-desk-head">
    <div class="w-profile-head">
      <div class="w-ring">
        <% if (src = wf_avatar_src(@user)) %>
          <%= image_tag src, alt: @user.name %>
        <% else %>
          <span class="w-initial" style="font-size:30px"><%= @user.name.first.upcase %></span>
        <% end %>
      </div>
      <div class="w-profile-stats">
        <div><strong><%= @posts.size %></strong> <span><%= "post".pluralize(@posts.size) %></span></div>
        <div><strong><%= wf_compact(@user.followers_count) %></strong> <span><%= @user.followers_count == 1 ? "fan" : "fans" %></span></div>
        <div><strong><%= @collection_count %></strong> <span><%= "collection".pluralize(@collection_count) %></span></div>
      </div>
    </div>

    <div class="w-profile-bio">
      <div class="w-profile-name"><%= @user.name %></div>
      <% cat = [ @user.creator_category, @user.creator_subcategory, @user.location ].compact_blank %>
      <% if cat.any? %><div class="w-profile-cat"><%= cat.join(" · ") %></div><% end %>
      <% if @user.bio.present? %>
        <div class="w-profile-text"><%= @user.bio %></div>
      <% elsif @own_page %>
        <%= link_to "Add a bio so fans know what you post", creator_settings_path, class: "w-profile-text w-dim" %>
      <% end %>
    </div>

    <div class="w-profile-actions">
      <% if @own_page %>
        <%= link_to "Edit profile", creator_settings_path, class: "w-btn" %>
        <%= link_to "New post", creator_posts_path, class: "w-btn w-btn--pink" %>
      <% else %>
        <% if @following %>
          <%= button_to "Following", unfollow_creator_path(@user.handle), method: :delete, class: "w-btn", form: { class: "w-inline" } %>
        <% else %>
          <%= button_to "Follow", follow_creator_path(@user.handle), class: "w-btn w-btn--pink", form: { class: "w-inline" } %>
        <% end %>
        <%= button_to "Message", message_creator_path(@user.handle), class: "w-btn", form: { class: "w-inline" } %>
        <% if @wishlist_items.any? %>
          <%= link_to spoil_me_path(@user.handle), class: "w-btn w-btn--icon", title: "Spoil #{@user.first_name}" do %>
            <%= wf_icon(:gift, size: 16) %><span class="w-sr">Spoil <%= @user.first_name %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% highlights = [] %>
  <% highlights << [ "VIP", close_friends_path(@user.handle), :vip ] if @plan %>
  <% highlights << [ "Lives", live_session_path(@lives.first), :live ] if @lives.any? %>
  <% @link_lists.first(4).each { |list| highlights << [ list.title.truncate(10), public_link_list_path(@user.handle, list.slug), list ] } %>
  <% highlights << [ "Spoil me", spoil_me_path(@user.handle), :gift ] if @wishlist_items.any? %>
  <% highlights << [ "Book", profile_path(@user.handle, tab: "book"), :calendar ] if @meet_offers.any? || @contact_reveals.any? %>
  <% if highlights.any? %>
    <nav class="w-highlights" aria-label="Highlights">
      <% highlights.each do |label, path, kind| %>
        <%= link_to path, class: "w-highlight" do %>
          <span class="w-highlight-ring <%= "w-highlight-ring--gold" if kind == :vip %>">
            <% if kind == :vip %><span>★</span>
            <% elsif kind == :live %>
              <% if (src = wf_avatar_src(@user)) %><%= image_tag src, alt: "" %><% else %><span><%= wf_icon(:video) %></span><% end %>
            <% elsif kind == :gift %><span><%= wf_icon(:gift) %></span>
            <% elsif kind == :calendar %><span><%= wf_icon(:calendar) %></span>
            <% else %>
              <% item = kind.fallback_image_item %>
              <% if kind.cover.attached? %><%= image_tag url_for(kind.cover), alt: "" %>
              <% elsif item && item.image_source.is_a?(String) %><%= image_tag item.image_source, alt: "" %>
              <% elsif item %><%= image_tag wf_post_image_src(item.image_source), alt: "" %>
              <% else %><span><%= wf_icon(:link) %></span><% end %>
            <% end %>
          </span>
          <span><%= label %></span>
        <% end %>
      <% end %>
    </nav>
  <% end %>

  <nav class="w-tabs" aria-label="Sections">
    <% [ [ "posts", "Posts", :grid ], [ "collections", "Collections", :stack ], [ "shop", "Shop", :bag ], [ "book", "Book", :calendar ] ].each do |id, label, icon| %>
      <%= link_to profile_path(@user.handle, tab: id), class: "w-tab", aria: { current: (@tab == id ? "page" : nil) } do %>
        <%= wf_icon(icon) %><%= label %>
      <% end %>
    <% end %>
  </nav>

  <%= render "profiles/tab_#{@tab}" %>
</div>

<% if @plan && !@own_page && !current_user&.subscribed_to?(@plan) %>
  <%= link_to close_friends_path(@user.handle), class: "w-dock" do %>
    <% if @tab == "collections" && @collection_count.positive? %>
      <span><span class="w-gold">★</span> All <%= @collection_count %> with Close Friends</span>
      <span class="w-btn w-btn--pink"><%= @plan.price_label %>/mo</span>
    <% else %>
      <span><span class="w-gold">★</span> Get every collection</span>
      <span class="w-btn w-btn--pink">Close Friends</span>
    <% end %>
  <% end %>
<% end %>

<%= render "shared/install_prompt", creator: @user unless @own_page %>
