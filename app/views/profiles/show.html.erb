                  price_label: "#{default_plan_price}/mo",
                  button_class: "cv-btn cv-btn--ruby cv-btn--large",
                  fallback_path: subscribe_subscription_plan_path(vip_plan) %>
          <% else %>
            <%= link_to "⚡ JOIN VIP PASS VIA INSTANT UPI (#{default_plan_price})", sign_in_path, class: "cv-btn cv-btn--ruby cv-btn--large" %>
          <% end %>
          <div class="cv-dh-meta-note">
            💬 Instant WhatsApp Invite link on UPI approval
          </div>
        </div>
      </div>

      <!-- Right: 100% Direct Settlement Guarantee Card -->
      <div class="cv-dh-guarantee-card">
        <div class="cv-dh-guarantee-icon">🏛️</div>
        <h3 class="cv-dh-guarantee-title">100% Direct Settlement Guarantee</h3>
        <p class="cv-dh-guarantee-sub">
          Zero middleman transaction cuts. Payments flow directly to Ananya's verified creator bank handle under the National Payments Corporation of India (NPCI) protocol.
        </p>
        <div class="cv-dh-upi-box">
          <div class="cv-dh-upi-label">SUPPORTED UPI APPS</div>
          <div class="cv-dh-upi-pills">
            <span class="cv-upi-pill">GPay</span>
            <span class="cv-upi-pill">PhonePe</span>
            <span class="cv-upi-pill">Paytm</span>
            <span class="cv-upi-pill">BHIM</span>
          </div>
        </div>
        <ul class="cv-dh-guarantee-checks">
