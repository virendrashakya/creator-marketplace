<% if @shared_drop.present? %>
  <% content_for :title, "#{@shared_drop.title} — VIP Drop by #{@user.name} | Wishful" %>
  <% content_for :description, "Exclusive Vault drop (#{@shared_drop.price_label}) by #{@user.name}. Unlock via direct UPI on Wishful." %>
  <% content_for :og_image, preview_paid_media_post_url(@shared_drop) %>
<% else %>
  <% content_for :title, "#{@user.name} (@#{@user.handle}) | Wishful" %>
  <% content_for :description, @user.bio.presence || "Exclusive vault drops, recommendations, and direct channels by #{@user.name} on Wishful." %>
  <% if @user.profile_picture.attached? %>
    <% content_for :og_image, url_for(@user.profile_picture) %>
  <% end %>
<% end %>
<%# This is the creator's page, not ours: no top nav, one quiet credit in the
    footer. Set for signed-in visitors too, so a fan browsing someone else's
    page does not get our app bar over it. %>
<% content_for :chrome, "creator" %>
<% content_for :head do %>
  <%# The atelier theme is the only one that needs a serif display face, so
      its fonts load only on the pages using it rather than for every
      creator. Playfair for headlines, Inter for UI. %>
  <% if @user.theme == "atelier" %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap">
  <% end %>
  <link rel="stylesheet" href="/assets/profile.css" data-turbo-track="reload">
  <%# The inline editor ships only to the one person who can use it. A fan
      downloads none of this. %>
  <% if @own_page %>
    <link rel="stylesheet" href="/assets/inline-edit.css" data-turbo-track="reload">
    <script src="/assets/js/inline-edit.js" data-turbo-track="reload" defer></script>
  <% end %>
<% end %>

<div class="profile theme-<%= @user.theme %> layout-<%= @user.profile_layout %>"
     <%= 'data-ie-root' if @own_page %>>
  <div class="profile-inner">

    <% if @own_page %>
      <%= render "profiles/edit_layer", user: @user, active_tab: @active_tab %>
    <% end %>

    <div class="pf-banner"<%= ' data-ie-zone' .html_safe if @own_page %>>
      <% if @user.banner.attached? %>
        <%= image_tag @user.banner, alt: "", width: 1600, height: 500 %>
      <% end %>
      <% if @own_page %>
        <%= render "profiles/photo_drop", user: @user, field: :banner,
              variant: "cover",
              title: @user.banner.attached? ? "Change cover photo" : "Add a cover photo",
              hint: "Drop a photo here, or click to choose" %>
      <% end %>
    </div>

    <header class="pf-id">
      <div class="pf-avatar"<%= ' data-ie-zone'.html_safe if @own_page %>>
        <% if @user.profile_picture.attached? %>
          <%= image_tag @user.profile_picture, alt: "", width: 208, height: 208 %>
        <% elsif @user.avatar_url.present? %>
          <%= image_tag @user.avatar_url, alt: "", width: 208, height: 208 %>
        <% else %>
          <%= @user.name.to_s.strip.first&.upcase %>
        <% end %>
        <% if @own_page %>
          <%= render "profiles/photo_drop", user: @user, field: :profile_picture,
                variant: "avatar", title: "Change", hint: nil %>
        <% end %>
      </div>

      <div class="pf-head">
        <div class="min0" style="flex: 1 1 320px">
          <h1 class="pf-name"><%= @user.name %></h1>
          <div class="actions" style="gap: 9px">
            <span class="pf-handle" translate="no">@<%= @user.handle %></span>
            <% category = [ @user.creator_category, @user.creator_subcategory ].select(&:present?).join(", ") %>
            <% if category.present? %><span class="pf-badge"><%= category %></span><% end %>
          </div>
          <% details = [ @user.pronouns, @user.location ].select(&:present?) %>
          <% if details.any? %>
            <div class="pf-meta"><%= details.join(" · ") %></div>
          <% end %>
          <% if @user.bio.present? %>
            <p class="pf-bio"><%= @user.bio %></p>
          <% end %>
        </div>

        <% if @social_links.any? || @user.website_url.present? %>
          <div class="pf-socials">
            <% @social_links.each do |name, handle, base_url| %>
              <%= link_to social_url(base_url, handle), class: "pf-social", target: "_blank", rel: "noopener noreferrer" do %>
                <span translate="no"><%= name %></span><span class="visually-hidden"> (opens in a new tab)</span>
              <% end %>
            <% end %>
            <% if @user.website_url.present? %>
              <%= link_to @user.website_url, class: "pf-social", target: "_blank", rel: "noopener noreferrer" do %>
                Website<span class="visually-hidden"> (opens in a new tab)</span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </header>

    <%# Stats and follow. The counts are the two numbers a visitor uses to
        decide whether this page is worth their money: how much is here, and
        how many other people are already here. %>
    <div class="pf-stats">
      <% if @paid_media_posts.any? %>
        <div class="pf-stat">
          <span class="pf-stat-value num" style="color: var(--p-accent); display: flex; align-items: center; gap: 5px;">
            <span><%= @paid_media_posts.size %></span>
            <span style="font-size: 10px; font-weight: 700; background: rgba(255,92,138,0.15); border: 1px solid rgba(255,92,138,0.3); border-radius: 999px; padding: 1px 6px; letter-spacing: 0.04em;">VIP</span>
          </span>
          <span class="pf-stat-label"><%= "vault drop".pluralize(@paid_media_posts.size) %></span>
        </div>
      <% elsif @all_links.any? %>
        <div class="pf-stat">
          <span class="pf-stat-value num"><%= number_to_human(@all_links.size, units: { thousand: "K", million: "M" }, format: "%n%u", precision: 2, significant: true) %></span>
          <span class="pf-stat-label"><%= "recommendation".pluralize(@all_links.size) %></span>
        </div>
      <% end %>
      <div class="pf-stat">
        <span class="pf-stat-value num"><%= number_to_human(@user.followers_count, units: { thousand: "K", million: "M" }, format: "%n%u", precision: 2, significant: true) %></span>
        <span class="pf-stat-label"><%= "follower".pluralize(@user.followers_count) %></span>
      </div>
      <% if @subscription_plans.any? %>
        <div class="pf-stat">
          <span class="pf-stat-value num" style="color: #10b981;">VIP</span>
          <span class="pf-stat-label">Close Friends</span>
        </div>
      <% elsif @all_links.any? && @paid_media_posts.any? %>
        <div class="pf-stat">
          <span class="pf-stat-value num"><%= @all_links.size %></span>
          <span class="pf-stat-label">curated fits</span>
        </div>
      <% end %>
      <div class="pf-stat-action">
        <% if @own_page %>
          <%= link_to "Edit page", profile_path(@user.handle, tab: @active_tab, edit: 1),
                class: "btn btn--light btn--small", data: { ie_open: true } %>
        <% elsif !signed_in? %>
          <%= link_to "Follow", sign_in_path, class: "btn btn--accent btn--small" %>
        <% elsif @following %>
          <%= button_to "Following", unfollow_creator_path(@user.handle), method: :delete,
                class: "btn btn--light btn--small", form_class: "pf-follow-form" %>
        <% else %>
          <%= button_to "Follow", follow_creator_path(@user.handle), method: :post,
                class: "btn btn--accent btn--small", form_class: "pf-follow-form" %>
        <% end %>
      </div>
    </div>

    <%# Five dedicated tabs: Posts, Vault, Recommendations, Wishlist, About. %>
    <nav class="pf-tabs" aria-label="Sections of this page">
      <div class="pf-tabs-inner">
        <% @sections.each do |sec| %>
          <% on = @active_tab == sec[:id] %>
          <%= link_to profile_path(@user.handle, tab: sec[:id]),
                class: "pf-tab#{' is-on' if on}",
                aria: { current: (on ? "page" : nil) } do %>
            <span class="pf-tab-icon" aria-hidden="true"><%= render "profiles/tab_icon", kind: sec[:icon] %></span>
            <span class="pf-tab-label"><%= sec[:label] %></span>
            <% if sec[:badge].present? %>
              <span class="pf-tab-badge"><%= sec[:badge] %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </nav>

    <%# 1. POSTS TAB: All creator feed %>
    <% if @active_tab == "posts" %>
      <section class="pf-section" id="posts"<%= ' data-ie-zone'.html_safe if @own_page %>>
        <div class="pf-section-head">
          <h2><%= @user.posts_heading_text %></h2>
          <span class="pf-count"><%= pluralize(@creator_posts.size, "post") %></span>
          <% if @own_page %>
            <%= render "profiles/manage", label: "Write a post", path: new_creator_post_path,
                  extra: [ "Manage posts", dashboard_path ] %>
          <% end %>
        </div>
        <% if @creator_posts.any? %>
          <div class="posts"><%= render partial: "creator_posts/post", collection: @creator_posts %></div>
        <% else %>
          <div class="pf-empty">
            <div class="empty-title">No posts yet</div>
            <p class="empty-body">
              <% if @own_page %>
                Share updates, thoughts, and behind-the-scenes moments with your community.
                <br>
                <%= link_to "Write your first post", new_creator_post_path, class: "btn btn--accent btn--small", style: "margin-top: 14px; display: inline-flex;" %>
              <% else %>
                Follow @<%= @user.handle %> to be notified when they publish their next update.
              <% end %>
            </p>
          </div>
        <% end %>
      </section>
    <% end %>

    <%# 2. RECOMMENDATIONS TAB: Curated products & referral links %>
    <% if @active_tab == "recommendations" %>
      <section class="pf-section" id="recommendations"<%= ' data-ie-zone'.html_safe if @own_page %>>
        <div class="pf-section-head">
          <h2><%= @user.links_heading_text %></h2>
          <span class="pf-count"><%= pluralize(@all_links.size, "item") %></span>
          <% if @own_page %>
            <%= render "profiles/manage", label: "Add a recommendation", path: new_product_link_path,
                  extra: [ "Collections", new_collection_path ] %>
          <% end %>
        </div>
        <p class="rec-note"><%= @user.links_note_text %></p>

        <% if @filterable %>
          <div class="pf-filters">
            <%= form_with url: profile_path(@user.handle, tab: "recommendations"), method: :get, class: "pf-search" do %>
              <%= hidden_field_tag :tab, "recommendations" %>
              <label class="visually-hidden" for="pf_q">Search @<%= @user.handle %>'s recommendations</label>
              <%= search_field_tag :q, @query, id: "pf_q", placeholder: "Search #{@all_links.size} recommendations",
                    autocomplete: "off", class: "pf-search-input" %>
              <%= submit_tag "Search", class: "pf-search-go" %>
              <% if @query.present? %>
                <%= link_to "Clear", profile_path(@user.handle, tab: "recommendations"), class: "pf-search-clear" %>
              <% end %>
            <% end %>

            <% if @categories.size > 1 %>
              <div class="pf-chips" role="list" aria-label="Categories">
                <a class="pf-chip<%= " is-on" if @query.blank? %>" role="listitem" href="#recommendations">All</a>
                <% @categories.each do |cat| %>
                  <a class="pf-chip" role="listitem" href="#cat-<%= cat.id %>"><%= cat.name %></a>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if @query.present? %>
          <p class="pf-result-count">
            <%= pluralize(@matched_links.size, "match") %> for &ldquo;<%= @query %>&rdquo;
          </p>
          <% if @matched_links.any? %>
            <div class="rec-list wf-stagger"><%= render partial: "product_links/card", collection: @matched_links %></div>
          <% else %>
            <div class="pf-empty-inline">
              Nothing matched that. <%= link_to "See everything", profile_path(@user.handle, tab: "recommendations") %>.
            </div>
          <% end %>
        <% elsif @all_links.any? %>
          <% @categories.each do |collection| %>
            <div class="pf-group" id="cat-<%= collection.id %>">
              <% if @categories.size > 1 || @uncategorized_links.any? %>
                <h3 class="pf-group-name"><%= collection.name %></h3>
              <% end %>
              <div class="rec-list wf-stagger"><%= render partial: "product_links/card", collection: collection.product_links %></div>
            </div>
          <% end %>
          <% if @uncategorized_links.any? %>
            <div class="pf-group">
              <% if @categories.any? %>
                <h3 class="pf-group-name">Everything else</h3>
              <% end %>
              <div class="rec-list wf-stagger"><%= render partial: "product_links/card", collection: @uncategorized_links %></div>
            </div>
          <% end %>
        <% else %>
          <div class="pf-empty">
            <div class="empty-title">No recommendations yet</div>
            <p class="empty-body">
              <% if @own_page %>
                Add your favorite gear, fashion, or tech with referral links.
                <br>
                <%= link_to "Add a recommendation", new_product_link_path, class: "btn btn--accent btn--small", style: "margin-top: 14px; display: inline-flex;" %>
              <% else %>
                @<%= @user.handle %> has not recommended any products yet.
              <% end %>
            </p>
          </div>
        <% end %>
      </section>
    <% end %>

    <%# 3. VAULT TAB: Private drops, uncut sets, Close Friends / VIP tiers %>
    <% if @active_tab == "vault" || @active_tab == "collections" %>
      <section class="pf-section" id="vault"<%= ' data-ie-zone'.html_safe if @own_page %>>
        <div class="pf-section-head">
          <div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <h2><%= @user.name.split.first %>'s Vault</h2>
              <span class="badge" style="background: rgba(255,92,138,0.15); color: var(--p-accent); border: 1px solid rgba(255,92,138,0.3); font-size: 11px; font-weight: 700; text-transform: uppercase;">Exclusive</span>
            </div>
            <p class="rec-note" style="margin-top: 4px; margin-bottom: 0;">
              Private uncensored drops, 4K sets, and VIP Close Friends access &middot; Unlocks via direct UPI.
            </p>
          </div>
          <span class="pf-count"><%= pluralize(@paid_media_posts.size + @paid_media_collections.size + @subscription_plans.size, "drop") %></span>
          <% if @own_page %>
            <%= render "profiles/manage", label: "Add vault drop", path: new_paid_media_post_path,
                  extra: [ "New bundle", new_paid_media_collection_path ] %>
          <% end %>
        </div>

        <% if @shared_drop.present? %>
          <div class="shared-teaser-banner" style="margin-bottom: 24px; padding: 14px 18px; border-radius: var(--r-lg); background: rgba(255,92,138,0.12); border: 1.5px solid var(--p-accent); display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 10px;">
              <span style="font-size: 22px;">🎁</span>
              <div>
                <div style="font-weight: 700; font-size: 14px; color: var(--p-ink);">
                  <%= @referring_user ? "Shared by @#{@referring_user.handle}" : "Exclusive Teaser Shared with You" %>
                </div>
                <div style="font-size: 12px; color: var(--p-sub);">
                  Viewing preview for <strong>"<%= @shared_drop.title %>"</strong>. Tap below to unlock via direct UPI.
                </div>
              </div>
            </div>
            <a href="#post-<%= @shared_drop.id %>" class="btn btn--small btn--accent">View Drop ↓</a>
          </div>
        <% end %>

        <%# VIP / Close Friends All-Access Membership Pass %>
        <% if @subscription_plans.any? %>
          <div class="vip-pass-card" style="margin-bottom: 28px; border: 1.5px solid var(--p-accent); border-radius: var(--r-xl); padding: clamp(16px, 3vw, 24px); background: linear-gradient(135deg, rgba(233,30,99,0.12) 0%, rgba(20,20,42,0.4) 100%); box-shadow: 0 4px 20px rgba(233,30,99,0.15);">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 8px;">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 20px;" aria-hidden="true">⭐</span>
                <h3 style="font-size: 20px; font-weight: 700; margin: 0; color: var(--p-ink);">Close Friends / VIP Pass</h3>
              </div>
              <span class="badge" style="background: var(--p-accent); color: #fff; font-weight: 700; font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase;">All-Access</span>
            </div>
            <p style="font-size: 14px; color: var(--p-sub); line-height: 1.5; margin-bottom: 16px;">
              Get all private vault drops automatically unlocked, priority 1:1 direct messages, and close friends updates.
            </p>
            <div class="pf-offers-grid" style="border: 1px solid var(--p-line); border-radius: var(--r-lg); overflow: hidden; background: var(--p-card);">
              <% @subscription_plans.each do |plan| %>
                <div class="pf-offer" style="background: transparent;">
                  <div class="pf-offer-top">
                    <span class="pf-offer-name" style="font-size: 16px; font-weight: 700;"><%= plan.name %></span>
                    <span class="pf-offer-price" style="font-size: 16px; color: var(--p-accent); font-weight: 700;"><%= money(plan.price_cents) %>/mo</span>
                  </div>
                  <div class="pf-offer-desc"><%= plan.description.presence || "Full access to all exclusive photos, videos, and private feed." %></div>
                  <div style="margin-top: 14px;">
                    <%= render "shared/buy_button", purchasable: plan, creator: @user,
                          label: "Join VIP (#{money(plan.price_cents)}/mo)",
                          signed_out_label: "Sign in to join VIP",
                          price_label: "#{money(plan.price_cents)}/mo",
                          fallback_path: subscribe_subscription_plan_path(plan) %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# Paid media collections if any %>
        <% if @paid_media_collections.any? %>
          <div class="pf-group" style="margin-bottom: 24px;">
            <h3 class="pf-group-name">Exclusive Bundles & Sets</h3>
            <div class="pf-offers-grid" style="border: 1px solid var(--p-line); border-radius: var(--r-xl); overflow: hidden; background: var(--p-card);">
              <% @paid_media_collections.each do |col| %>
                <div class="pf-offer">
                  <div class="pf-offer-top">
                    <span class="pf-offer-name"><%= col.title %></span>
                    <span class="pf-offer-price"><%= col.price_cents.present? ? money(col.price_cents) : "Free" %></span>
                  </div>
                  <div class="pf-offer-desc"><%= col.description.presence || "#{pluralize(col.paid_media_posts.size, 'drop')} inside" %></div>
                  <% if col.price_cents.present? %>
                    <div style="margin-top: 12px;">
                      <%= link_to "Unlock Set (#{money(col.price_cents)})", new_payment_claim_path("PaidMediaCollection", col.id), class: "btn btn--accent btn--small btn--block" %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# Private media posts %>
        <% if @paid_media_posts.any? %>
          <div class="media-grid wf-stagger"><%= render partial: "paid_media_posts/card", collection: @paid_media_posts %></div>
        <% end %>

        <% if @paid_media_posts.empty? && @paid_media_collections.empty? && @subscription_plans.empty? %>
          <div class="pf-empty">
            <div class="empty-title">The Vault is empty</div>
            <p class="empty-body">
              <% if @own_page %>
                Lock exclusive photos, uncensored videos, or private sets behind manual UPI verification.
                <br>
                <span style="display: inline-flex; gap: 8px; margin-top: 14px;">
                  <%= link_to "Add private photo or video", new_paid_media_post_path, class: "btn btn--accent btn--small" %>
                  <%= link_to "Create VIP tier", new_subscription_plan_path, class: "btn btn--light btn--small" %>
                </span>
              <% else %>
                @<%= @user.handle %> has not unlocked any vault drops yet. Check back soon!
              <% end %>
            </p>
          </div>
        <% end %>
      </section>
    <% end %>

    <%# 4. WISHLIST TAB: Fan gifting wishlists %>
    <% if @active_tab == "wishlist" %>
      <% if @wishlists.any? { |w| w.wishlist_items.any? } %>
        <% @wishlists.each do |wishlist| %>
          <% next if wishlist.wishlist_items.empty? %>
          <section class="pf-section" id="wishlist"<%= ' data-ie-zone'.html_safe if @own_page %>>
            <div class="pf-section-head">
              <h2><%= wishlist.title %></h2>
              <span class="pf-count"><%= pluralize(wishlist.wishlist_items.size, "gift") %></span>
              <% if @own_page %>
                <%= render "profiles/manage", label: "Add a gift",
                      path: new_wishlist_wishlist_item_path(wishlist),
                      extra: [ "Edit list", edit_wishlist_path(wishlist) ] %>
              <% end %>
            </div>
            <p class="rec-note">
              These are gifts, not things to buy for yourself. What you send goes
              straight to <%= @user.name.to_s.split.first.presence || "the creator" %> over UPI.
            </p>
            <% if wishlist.description.present? %>
              <p class="rec-note"><%= wishlist.description %></p>
            <% end %>
            <div class="wish-grid wf-stagger"><%= render partial: "wishlists/item", collection: wishlist.wishlist_items %></div>
          </section>
        <% end %>
      <% else %>
        <section class="pf-section" id="wishlist"<%= ' data-ie-zone'.html_safe if @own_page %>>
          <div class="pf-section-head">
            <h2>Gifting Wishlist</h2>
            <% if @own_page %>
              <%= render "profiles/manage", label: "Create wishlist", path: new_wishlist_path %>
            <% end %>
          </div>
          <div class="pf-empty">
            <div class="empty-title">No wishlist items right now</div>
            <p class="empty-body">
              <% if @own_page %>
                Create a wishlist for gear, tools, or goals so fans can chip in via UPI.
                <br>
                <%= link_to "Create your first wishlist", new_wishlist_path, class: "btn btn--accent btn--small", style: "margin-top: 14px; display: inline-flex;" %>
              <% else %>
                @<%= @user.handle %> does not have an active wishlist right now.
              <% end %>
            </p>
          </div>
        </section>
      <% end %>
    <% end %>

    <%# 5. ABOUT TAB: Direct VIP Access & Connect, overview, & bio details %>
    <% if @active_tab == "about" %>
      <section class="pf-section" id="about"<%= ' data-ie-zone'.html_safe if @own_page %>>
        <div class="pf-section-head">
          <div>
            <h2>Direct VIP Access &amp; Connect</h2>
            <p class="rec-note" style="margin-top: 4px; margin-bottom: 0;">
              Private 1:1 video calls, exclusive contact channels, and creator bio. Settle directly over UPI.
            </p>
          </div>
          <% if @own_page %>
            <%= render "profiles/manage", label: "Manage time slots", path: new_meet_offer_path,
                  extra: [ "Manage contacts", new_contact_reveal_path ] %>
          <% end %>
        </div>

        <%# Bookable meet offers / 1:1 sessions %>
        <% if @meet_offers.any? %>
          <div class="pf-group" style="margin-bottom: 24px;">
            <div class="section-head" style="margin-bottom: 12px; border: none; padding-top: 0;">
              <h3 style="font-size: 18px; font-weight: 700; margin: 0;"><%= @user.meet_heading_text %></h3>
              <span class="pf-count"><%= pluralize(@meet_offers.size, "offer") %></span>
            </div>
            <div class="stack"><%= render partial: "meet_offers/card", collection: @meet_offers %></div>
          </div>
        <% end %>

        <%# Contact reveals %>
        <% if @contact_reveals.any? %>
          <div class="pf-group" style="margin-bottom: 24px;">
            <div class="section-head" style="margin-bottom: 12px; border: none; padding-top: 0;">
              <h3 style="font-size: 18px; font-weight: 700; margin: 0;"><%= @user.reveal_heading_text %></h3>
              <span class="pf-count"><%= pluralize(@contact_reveals.size, "contact") %></span>
            </div>
            <div class="stack"><%= render partial: "contact_reveals/card", collection: @contact_reveals %></div>
          </div>
        <% end %>

        <% if @meet_offers.empty? && @contact_reveals.empty? %>
          <div class="pf-empty" style="margin-bottom: 30px;">
            <div class="empty-title">Direct VIP Access &amp; Connect</div>
            <p class="empty-body">
              <% if @own_page %>
                Offer 1:1 video call dates, priority chat, or private channels with manual UPI verification.
                <br>
                <span style="display: inline-flex; gap: 8px; margin-top: 14px;">
                  <%= link_to "Add video call slot", new_meet_offer_path, class: "btn btn--accent btn--small" %>
                  <%= link_to "Add VIP channel", new_contact_reveal_path, class: "btn btn--light btn--small" %>
                </span>
              <% else %>
                @<%= @user.handle %> has not listed any 1:1 video calls or private contact channels yet.
              <% end %>
            </p>
          </div>
        <% end %>

        <%# Overview of everything on offer %>
        <%= render "profiles/offers_index", user: @user, collections: @collections,
              uncategorized: @uncategorized_links, media: @paid_media_posts,
              meet_offers: @meet_offers, reveals: @contact_reveals, wishlists: @wishlists %>

        <%# Creator bio and profile details %>
        <div class="card" style="margin-top: 32px; padding: clamp(18px, 3vw, 28px); border-radius: var(--r-xl); background: var(--p-card); border: 1px solid var(--p-line);">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px;">
            <h3 style="font-size: 20px; font-weight: 700; margin: 0;">About <%= @user.name %></h3>
            <span class="pf-handle" translate="no">@<%= @user.handle %></span>
          </div>

          <% if @user.bio.present? %>
            <p style="font-size: 15px; line-height: 1.6; color: var(--p-ink); margin-bottom: 16px;"><%= @user.bio %></p>
          <% end %>

          <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px;">
            <% if @user.creator_category.present? %>
              <span class="pf-badge"><%= [@user.creator_category, @user.creator_subcategory].select(&:present?).join(", ") %></span>
            <% end %>
            <% if @user.location.present? %>
              <span class="pf-badge" style="opacity: 0.85;">📍 <%= @user.location %></span>
            <% end %>
            <% if @user.pronouns.present? %>
              <span class="pf-badge" style="opacity: 0.85;"><%= @user.pronouns %></span>
            <% end %>
            <% if @user.upi_id.present? %>
              <span class="pf-badge" style="opacity: 0.85;">⚡ UPI: <%= @user.upi_id %></span>
            <% end %>
          </div>

          <% if @social_links.any? || @user.website_url.present? %>
            <div class="pf-socials" style="margin-top: 14px;">
              <% @social_links.each do |name, handle, base_url| %>
                <%= link_to social_url(base_url, handle), class: "pf-social", target: "_blank", rel: "noopener noreferrer" do %>
                  <span translate="no"><%= name %></span>
                <% end %>
              <% end %>
              <% if @user.website_url.present? %>
                <%= link_to @user.website_url, class: "pf-social", target: "_blank", rel: "noopener noreferrer" do %>
                  Website
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

  </div>
</div>
