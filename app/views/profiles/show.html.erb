<% content_for :title, "#{@user.name} (@#{@user.handle}) | Wishful" %>
<% content_for :description, @user.bio.presence || "Things #{@user.name} vouches for, on Wishful." %>
<% content_for :head do %>
  <link rel="stylesheet" href="/assets/profile.css">
<% end %>

<div class="page">
  <section class="profile theme-<%= @user.theme %> layout-<%= @user.profile_layout %>">
    <% if @user.banner.attached? %>
      <%= image_tag @user.banner, alt: "", width: 1200, height: 400, class: "profile-banner" %>
    <% end %>

    <header class="profile-id">
      <div class="profile-avatar">
        <% if @user.profile_picture.attached? %>
          <%= image_tag @user.profile_picture, alt: "", width: 144, height: 144 %>
        <% elsif @user.avatar_url.present? %>
          <%= image_tag @user.avatar_url, alt: "", width: 144, height: 144 %>
        <% else %>
          <%= @user.name.to_s.strip.first&.upcase %>
        <% end %>
      </div>
      <div class="min0">
        <h1><%= @user.name %></h1>
        <div class="profile-handle" translate="no">@<%= @user.handle %></div>
        <% details = [ @user.creator_category, @user.creator_subcategory, @user.pronouns, @user.location ].select(&:present?) %>
        <% if details.any? %>
          <div class="profile-meta"><%= details.join(" · ") %></div>
        <% end %>
        <% if @user.bio.present? %>
          <p class="profile-bio break"><%= @user.bio %></p>
        <% end %>
        <% if @social_links.any? || @user.website_url.present? %>
          <div class="profile-socials">
            <% @social_links.each do |name, handle, base_url| %>
              <%= link_to social_url(base_url, handle), class: "button light small", target: "_blank", rel: "noopener noreferrer" do %>
                <span translate="no"><%= name %></span><span class="visually-hidden"> (opens in a new tab)</span>
              <% end %>
            <% end %>
            <% if @user.website_url.present? %>
              <%= link_to @user.website_url, class: "button light small", target: "_blank", rel: "noopener noreferrer" do %>
                Website<span class="visually-hidden"> (opens in a new tab)</span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </header>

    <% has_links = @collections.any? { |c| c.product_links.any? } || @uncategorized_links.any? %>

    <% if has_links %>
      <% @collections.each do |collection| %>
        <% next if collection.product_links.empty? %>
        <h2 class="band"><%= collection.name %></h2>
        <div class="vouch-list"><%= render partial: "product_links/card", collection: collection.product_links %></div>
      <% end %>
      <% if @uncategorized_links.any? %>
        <h2 class="band">Things I use</h2>
        <div class="vouch-list"><%= render partial: "product_links/card", collection: @uncategorized_links %></div>
      <% end %>
    <% end %>

    <% if @paid_media_posts.any? %>
      <h2 class="band">Behind the paywall</h2>
      <%= render partial: "paid_media_posts/card", collection: @paid_media_posts %>
    <% end %>

    <% if @meet_offers.any? %>
      <h2 class="band">Meet me</h2>
      <%= render partial: "meet_offers/card", collection: @meet_offers %>
    <% end %>

    <% if @contact_reveals.any? %>
      <h2 class="band">Reach me directly</h2>
      <%= render partial: "contact_reveals/card", collection: @contact_reveals %>
    <% end %>

    <% @wishlists.each do |wishlist| %>
      <% next if wishlist.wishlist_items.empty? %>
      <h2 class="band">Gift: <%= wishlist.title %></h2>
      <%= render partial: "wishlists/item", collection: wishlist.wishlist_items %>
    <% end %>

    <% if @creator_posts.any? %>
      <h2 class="band">Lately</h2>
      <%= render partial: "creator_posts/post", collection: @creator_posts %>
    <% end %>

    <% unless has_links || @paid_media_posts.any? || @meet_offers.any? || @contact_reveals.any? || @creator_posts.any? || @wishlists.any? { |w| w.wishlist_items.any? } %>
      <div class="empty-profile">
        <strong>@<%= @user.handle %></strong> hasn’t added anything yet.
        <% if signed_in? && current_user == @user %>
          <%= link_to "Add your first recommendation", new_product_link_path %>.
        <% end %>
      </div>
    <% end %>
  </section>
</div>
