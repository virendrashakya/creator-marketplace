        <a href="#about" class="cv-dh-policy-link">
          Read Creator Direct Settlement &amp; Anti-Piracy Policy <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- ============================================================== -->
    <!-- MOBILE VIP HERO CARD & SETTLEMENT BANNER (< 900px)             -->
    <!-- ============================================================== -->
