<style>
  .profile { --accent:#ff5a7b; --card:#fff; --surface:#fffdfa; max-width:620px; margin:10px auto 45px; text-align:center; padding:8px; border-radius:24px }.profile-avatar { width:82px; height:82px; display:grid; place-items:center; margin:0 auto 13px; border-radius:50%; background:#f6ced7; font-size:32px; overflow:hidden }.profile-avatar img { width:100%; height:100%; object-fit:cover }.profile h1 { margin:0; letter-spacing:-1.5px }.profile .bio { color:var(--muted); line-height:1.5; margin:10px auto 25px; max-width:460px }.collection-title { text-align:left; font-size:13px; text-transform:uppercase; letter-spacing:1px; color:#8b8285; font-weight:800; margin:29px 0 10px }.public-card { display:grid; grid-template-columns:64px 1fr 20px; gap:13px; align-items:center; padding:10px; text-align:left; border:1px solid var(--line); background:var(--card); border-radius:15px; margin-bottom:10px; transition:transform .15s, box-shadow .15s }.public-card:hover { transform:translateY(-2px); box-shadow:0 8px 20px #30252b12 }.public-image { height:64px; width:64px; border-radius:10px; object-fit:cover; background:#f3eeee }.public-title { font-weight:800; font-size:14px }.public-note { color:var(--muted); font-size:12px; line-height:1.35; margin-top:4px }.arrow { color:var(--accent); font-size:20px }.profile-link { color:var(--muted); font-size:13px }.empty-profile { padding:35px; color:var(--muted); background:#faf8f6; border-radius:15px }.theme-luxury { --accent:#c8a45b; --card:#1c1920; --muted:#afa8b0; color:#f7f2e8; background:#131116; box-shadow:0 18px 45px #1d151d22 }.theme-luxury .profile-avatar { background:#c8a45b; color:#211a15 }.theme-adventure { --accent:#df612f; --card:#fff8e9; --muted:#5b6558; color:#243c35; background:#dcebd9; }.theme-adventure .profile-avatar { background:#ebaa49 }.theme-after_dark { --accent:#e42d6c; --card:#24151f; --muted:#c4aab6; color:#f9e8f0; background:#120b10; box-shadow:0 18px 45px #18050f44 }.theme-after_dark .profile-avatar { background:#e42d6c }.layout-editorial { max-width:780px; text-align:left; padding:32px }.layout-editorial .profile-avatar { margin:0 0 13px }.layout-editorial .bio { margin-left:0 }.layout-gallery .public-card { display:inline-grid; vertical-align:top; width:calc(50% - 7px); margin:3px; grid-template-columns:1fr; }.layout-gallery .public-image { width:100%; height:180px }.layout-gallery .arrow { display:none } @media(max-width:600px){.layout-gallery .public-card{width:100%;margin:0 0 10px}}
</style>
<main class="page"><section class="profile theme-<%= @user.theme %> layout-<%= @user.profile_layout %>"><% if @user.banner.attached? %><%= image_tag @user.banner, alt: "", style: "width:100%;height:180px;object-fit:cover;border-radius:18px;margin-bottom:18px" %><% end %><div class="profile-avatar"><% if @user.profile_picture.attached? %><%= image_tag @user.profile_picture, alt: @user.name %><% elsif @user.avatar_url.present? %><%= image_tag @user.avatar_url, alt: @user.name %><% else %>✦<% end %></div><h1><%= @user.name %></h1><div class="profile-link">@<%= @user.handle %><%= " · #{@user.creator_category}" if @user.creator_category.present? %><%= " / #{@user.creator_subcategory}" if @user.creator_subcategory.present? %><%= " · #{@user.pronouns}" if @user.pronouns.present? %></div><% if @user.location.present? %><div class="profile-link"><%= @user.location %></div><% end %><% if @user.bio.present? %><p class="bio"><%= @user.bio %></p><% end %><% if @social_links.any? || @user.website_url.present? %><div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:16px 0 23px"><% @social_links.each do |name, handle, base_url| %><%= link_to name, "#{base_url}#{handle.delete_prefix('@').delete_prefix('u/')}", target: "_blank", rel: "noopener", class: "button light", style: "padding:7px 10px;font-size:12px" %><% end %><% if @user.website_url.present? %><%= link_to "Website", @user.website_url, target: "_blank", rel: "noopener", class: "button light", style: "padding:7px 10px;font-size:12px" %><% end %></div><% end %>
  <% if @collections.any? || @uncategorized_links.any? %>
    <% @collections.each do |collection| %><% next if collection.product_links.empty? %><div class="collection-title"><%= collection.name %></div><%= render partial: "product_links/card", collection: collection.product_links %><% end %>
    <% if @uncategorized_links.any? %><div class="collection-title">My current favorites</div><%= render partial: "product_links/card", collection: @uncategorized_links %><% end %>
  <% else %><div class="empty-profile">@<%= @user.handle %> is curating their first recommendations.</div><% end %>
  <% if @paid_media_posts.any? %><div class="collection-title">Exclusive media</div><%= render partial: "paid_media_posts/card", collection: @paid_media_posts %><% end %>
  <% if @meet_offers.any? %><div class="collection-title">Meet me</div><%= render partial: "meet_offers/card", collection: @meet_offers %><% end %>
  <% if @contact_reveals.any? %><div class="collection-title">Get in touch</div><%= render partial: "contact_reveals/card", collection: @contact_reveals %><% end %>
  <% @wishlists.each do |wishlist| %><% if wishlist.wishlist_items.any? %><div class="collection-title">Gift my wishlist · <%= wishlist.title %></div><%= render partial: "wishlists/item", collection: wishlist.wishlist_items %><% end %><% end %>
  <% if @creator_posts.any? %><div class="collection-title">Latest posts</div><%= render partial: "creator_posts/post", collection: @creator_posts %><% end %>
</section></main>
