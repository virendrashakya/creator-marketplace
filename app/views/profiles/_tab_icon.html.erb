<%#
  Tab bar icons. Inline SVG rather than an icon font or image sprite: five
  small glyphs are cheaper inline than any extra request, and stroke colour
  inherits from the active tab so no per-state variants are needed.
  All drawn on a 24x24 grid with a 1.75 stroke to sit evenly beside each other.
%>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
     stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
  <% case kind %>
  <% when "post", "posts" %>
    <%# Speech bubble: what the creator said lately. %>
    <path d="M21 11.5a8.4 8.4 0 0 1-8.5 8.4 9 9 0 0 1-3.9-.8L3 21l1.9-4.3A8.2 8.2 0 0 1 4 11.5 8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5Z"/>
  <% when "lock", "vault" %>
    <%# Padlock: Vault exclusive unlock. %>
    <rect x="4.5" y="10" width="15" height="11" rx="2.5"/>
    <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
    <circle cx="12" cy="15.5" r="1.5" fill="currentColor"/>
  <% when "collection", "collections" %>
    <%# Stacked layers: digital collection. %>
    <path d="m3 9 9-5 9 5-9 5-9-5Z"/>
    <path d="m3 14 9 5 9-5"/>
    <path d="m3 19 9 5 9-5"/>
  <% when "shop", "recommendation", "recommendations" %>
    <%# Tag: a recommendation points at something for sale elsewhere. %>
    <path d="M20.6 12.4 12.4 20.6a2 2 0 0 1-2.8 0l-6.2-6.2a2 2 0 0 1 0-2.8L11.6 3.4a2 2 0 0 1 1.5-.6l5.6.3a2 2 0 0 1 1.9 1.9l.3 5.6a2 2 0 0 1-.3 1.2Z"/>
    <circle cx="15.5" cy="8.5" r="1.4" fill="currentColor" stroke="none"/>
  <% when "clock", "time" %>
    <%# Clock: bookable time slots. %>
    <circle cx="12" cy="12" r="8.6"/>
    <path d="M12 7.6V12l3.1 1.9"/>
  <% when "gift", "wishlist", "wishlists" %>
    <%# Gift box: the wishlist, where money comes to the creator. %>
    <path d="M4.2 11.2h15.6v8.1a1.6 1.6 0 0 1-1.6 1.6H5.8a1.6 1.6 0 0 1-1.6-1.6Z"/>
    <path d="M3.2 7.7h17.6v3.5H3.2zM12 7.7V21"/>
    <path d="M12 7.7 9.6 5.3a1.9 1.9 0 1 1 2.4-2.4 1.9 1.9 0 1 1 2.4 2.4L12 7.7Z"/>
  <% when "about", "user" %>
    <%# User profile: bio, reach, about. %>
    <circle cx="12" cy="8" r="4"/>
    <path d="M5 20a7 7 0 0 1 14 0"/>
  <% end %>
</svg>
