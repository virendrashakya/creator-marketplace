<%= form_with model: [@wishlist, @wishlist_item] do |f| %><%= render "shared/errors", record: @wishlist_item %><div class="field"><%= f.label :title, "Gift item" %><%= f.text_field :title, placeholder: "Camera lens" %></div><div class="field"><%= f.label :product_url, "Store URL (optional)" %><%= f.url_field :product_url %></div><div class="field"><%= f.label :image_url, "Image URL (optional)" %><%= f.url_field :image_url %></div><div class="field"><%= f.label :target_cents, "Gift value (paise/cents)" %><%= f.number_field :target_cents, min: 1, placeholder: "500000" %></div><div class="field"><%= f.label :note %><%= f.text_area :note, placeholder: "Why this would mean so much" %></div><div class="form-actions"><%= f.submit class: "button pink" %><%= link_to "Cancel", dashboard_path, class: "button light" %></div><% end %>
