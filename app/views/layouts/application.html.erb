<!DOCTYPE html>
<html>
  <head>
    <title>Wishful — recommendations worth sharing</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <style>
      :root { --ink:#222025; --muted:#746f78; --paper:#fffdfa; --pink:#ff5a7b; --lav:#f3edff; --line:#e9e4e1; }
      * { box-sizing:border-box } body { margin:0; color:var(--ink); background:var(--paper); font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif; } a { color:inherit; text-decoration:none } .nav { max-width:1120px; margin:auto; padding:22px 30px; display:flex; align-items:center; justify-content:space-between; } .brand { font-weight:850; font-size:23px; letter-spacing:-1.2px } .brand i { color:var(--pink); font-style:normal } .nav-links { display:flex; gap:22px; align-items:center; font-size:14px; font-weight:650 } .button { display:inline-flex; justify-content:center; align-items:center; border:0; border-radius:12px; background:var(--ink); color:#fff; padding:12px 18px; font:inherit; font-weight:700; cursor:pointer } .button.pink { background:var(--pink) }.button.light { color:var(--ink); background:#fff; border:1px solid var(--line) }.flash { max-width:820px; margin:0 auto 12px; border-radius:10px; padding:12px 16px; font-size:14px; background:#e8faef; color:#155a34 }.flash.alert { background:#fff0f1; color:#a22b43 }.page { max-width:1120px; margin:auto; padding:28px 30px 64px }.auth { max-width:450px; margin:36px auto; padding:32px; border:1px solid var(--line); border-radius:20px; background:#fff }.auth h1 { margin-top:0; letter-spacing:-1.5px }.field { margin:16px 0 }.field label { display:block; font-size:13px; font-weight:750; margin-bottom:7px }.field input,.field textarea,.field select { width:100%; border:1px solid #d9d3d1; border-radius:10px; padding:11px 12px; font:inherit; background:#fff }.field textarea { min-height:90px; resize:vertical }.errors { color:#b02941; font-size:14px; margin:12px 0 }.muted { color:var(--muted) }.footer { border-top:1px solid var(--line); padding:30px; color:var(--muted); font-size:13px; text-align:center }.inline { display:inline }.danger { color:#bc2845; background:none; border:0; font:inherit; padding:0; cursor:pointer }.form-actions { display:flex; gap:10px; align-items:center; margin-top:22px } @media(max-width:620px) { .nav,.page { padding-left:18px; padding-right:18px }.nav-links { gap:12px }.nav-links .hide-mobile { display:none } }
    </style>
  </head>
  <body>
    <nav class="nav">
      <%= link_to root_path, class: "brand" do %>wish<i>ful</i><% end %>
      <div class="nav-links">
        <% if signed_in? %>
          <%= link_to "My page", profile_path(current_user.handle), class: "hide-mobile" %>
          <%= link_to "Dashboard", dashboard_path %>
          <%= button_to "Sign out", sign_out_path, method: :delete, class: "danger" %>
        <% else %>
          <%= link_to "Sign in", sign_in_path %>
          <%= link_to "Start for free", sign_up_path, class: "button pink" %>
        <% end %>
      </div>
    </nav>
    <% flash.each do |kind, message| %><div class="flash <%= 'alert' if kind == 'alert' %>"><%= message %></div><% end %>
    <%= yield %>
    <footer class="footer">Wishful helps creators share the things they genuinely love.</footer>
  </body>
</html>
