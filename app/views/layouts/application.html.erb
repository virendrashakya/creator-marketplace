<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title).presence || "Wishful: things worth vouching for" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="description" content="<%= content_for(:description).presence || "Wishful gives Indian creators one page for everything they recommend, and a direct UPI way to be paid for it." %>">
    <meta name="theme-color" content="#F4F5F7">
    <%= csrf_meta_tags %>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/favicon.svg">
    <meta property="og:site_name" content="Wishful">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= content_for(:title).presence || "Wishful: things worth vouching for" %>">
    <meta property="og:description" content="<%= content_for(:description).presence || "Wishful gives Indian creators one page for everything they recommend, and a direct UPI way to be paid for it." %>">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Public+Sans:wght@400..700&display=swap">
    <link rel="stylesheet" href="/assets/wishful.css">
    <%= yield :head %>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <nav class="nav" aria-label="Primary">
        <%= link_to root_path, class: "brand" do %>wish<em>ful</em><% end %>
        <div class="nav-links">
          <% if signed_in? %>
            <%= link_to "My page", profile_path(current_user.handle) %>
            <%= link_to "Dashboard", dashboard_path %>
            <%= button_to "Sign out", sign_out_path, method: :delete, class: "danger" %>
          <% else %>
            <%= link_to "Sign in", sign_in_path %>
            <%= link_to "Start for free", sign_up_path, class: "button accent" %>
          <% end %>
        </div>
      </nav>
    </header>
    <div aria-live="polite">
      <% flash.each do |kind, message| %>
        <div class="flash <%= "alert" if kind.to_s.in?(%w[alert error]) %>"><%= message %></div>
      <% end %>
    </div>
    <main id="main">
      <%= yield %>
    </main>
    <footer class="footer">
      Wishful helps creators share the things they genuinely use.
    </footer>
  </body>
</html>
