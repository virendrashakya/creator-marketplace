<header class="fixed top-0 left-[260px] right-0 h-16 bg-surface-container-lowest/90 backdrop-blur-2xl border-b border-white/[0.06] z-40 flex items-center justify-between px-6">
  <div class="flex items-center gap-3">
    <div class="flex items-center gap-2 text-on-surface-variant text-[13.5px]">
      <span class="text-outline hover:text-white transition-colors cursor-pointer">Studio</span>
      <span class="material-symbols-outlined text-[15px] text-outline/60">chevron_right</span>
      <span class="text-white font-semibold"><%= local_assigns[:current_page_name] || "Console" %></span>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <!-- Global Quick Search -->
    <div class="relative flex items-center">
      <span class="material-symbols-outlined absolute left-3 text-[17px] text-outline">search</span>
      <input class="w-64 pl-9 pr-11 py-1.5 bg-surface-container/70 border border-white/[0.06] rounded-full text-[13px] text-on-surface placeholder:text-outline/80 focus:outline-none focus:border-primary/40 focus:ring-1 focus:ring-primary/20 transition-all" placeholder="Search media, patrons, tags..." type="text"/>
      <kbd class="absolute right-2.5 px-1.5 py-0.5 rounded bg-surface-container-highest text-[10px] font-mono text-outline font-semibold">⌘K</kbd>
    </div>

    <!-- Notifications Bell -->
    <button class="relative w-8 h-8 flex items-center justify-center rounded-full bg-surface-container/70 border border-white/[0.05] text-outline hover:text-white hover:bg-surface-container transition-colors cursor-pointer" type="button" aria-label="Notifications">
      <span class="material-symbols-outlined text-[18px]">notifications</span>
      <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-primary ring-2 ring-surface-container-lowest"></span>
    </button>

    <!-- User Profile Badge -->
    <%= link_to (current_user ? profile_path(current_user.handle) : "#"), class: "w-8 h-8 rounded-full bg-gradient-to-br from-primary-container to-secondary-container flex items-center justify-center text-white ring-1 ring-primary/40 shadow-[0_0_12px_rgba(255,23,103,0.25)] transition-transform hover:scale-105 cursor-pointer shrink-0", title: "View Storefront" do %>
      <span class="material-symbols-outlined text-[17px]">person</span>
    <% end %>
  </div>
</header>
