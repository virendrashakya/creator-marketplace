<% content_for :title, "Your unlocks | Wishful" %>
<% content_for :chrome, "fan" %>

<div class="w-phone">
  <header class="w-topbar">
    <span class="w-row" style="gap:8px"><span class="w-brand-mark">W</span><span style="font-size:17px;font-weight:800">Wishful</span></span>
    <div class="w-topbar-actions">
      <%= render "shared/theme_switch", compact: true %>
      <%= link_to conversations_path, class: "w-icon-btn", aria: { label: "Messages" } do %><%= wf_icon(:chat) %><% end %>
      <%= button_to sign_out_path, method: :delete, class: "w-icon-btn", form: { class: "w-inline", data: { sign_out: true } }, aria: { label: "Sign out" } do %><%= wf_icon(:sign_out) %><% end %>
    </div>
  </header>

  <div class="w-row w-banner-warn" data-offline-banner hidden style="margin:6px 16px 0;padding:10px 14px;border-radius:12px;font-size:13px;gap:10px">
    <%= wf_icon(:wifi_off, size: 16) %>You're offline. Payments are paused.
  </div>

  <div style="padding:22px 16px 0">
    <h1 style="font-size:24px;font-weight:800;letter-spacing:-.03em;margin:0">Your unlocks</h1>
    <div class="w-sub" style="font-size:13.5px;margin-top:4px">Opened on this phone, still watermarked to you.</div>
  </div>

  <% if @pending.any? %>
    <div class="w-stack" style="padding:16px 16px 0;gap:8px">
      <% @pending.each do |claim| %>
        <%= link_to payment_claim_path(claim), class: "w-list-row", style: "border-color:var(--w-gold-line)" do %>
          <span class="w-thumb w-center" style="justify-content:center;width:48px;height:60px;border-radius:8px;color:var(--w-gold)"><%= wf_icon(:clock, size: 18) %></span>
          <div class="w-grow"><div style="font-size:14px;font-weight:800"><%= claim.item_title %></div><div class="w-sub" style="font-size:12px;margin-top:2px">Waiting for <%= claim.creator.first_name %> · sent <%= wf_ago(claim.created_at) %></div></div>
          <span class="w-status w-status--pending">Waiting</span>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <div class="w-stack" style="padding:16px;gap:8px">
    <% @collections.each do |c| %>
      <% cover = c.cover_post %>
      <%= link_to public_collection_path(c.user.handle, c), class: "w-list-row", data: { saved_check: (cover && media_paid_media_post_path(cover)) } do %>
        <% if (src = wf_collection_cover_src(c)) %><%= image_tag src, alt: "", style: "width:48px;height:60px;border-radius:8px;object-fit:cover;flex:none" %><% end %>
        <div class="w-grow"><div style="font-size:14px;font-weight:800"><%= c.title %></div><div class="w-sub" style="font-size:12px;margin-top:2px"><%= c.contents_label %> · <%= c.user.handle %></div></div>
        <span class="w-row w-green" data-saved-badge hidden style="gap:4px;font-size:11px;font-weight:800"><%= wf_icon(:check, size: 12) %>Saved</span>
      <% end %>
    <% end %>
    <% @drops.each do |d| %>
      <%= link_to public_drop_path(d.user.handle, d, view: 1), class: "w-list-row", data: { saved_check: media_paid_media_post_path(d) } do %>
        <%= image_tag wf_post_image_src(d, viewer_can_see: true), alt: "", style: "width:48px;height:60px;border-radius:8px;object-fit:cover;flex:none" %>
        <div class="w-grow"><div style="font-size:14px;font-weight:800"><%= d.title %></div><div class="w-sub" style="font-size:12px;margin-top:2px">1 <%= d.media_type == "video" ? "reel" : "photo" %> · <%= d.user.handle %></div></div>
        <span class="w-row w-green" data-saved-badge hidden style="gap:4px;font-size:11px;font-weight:800"><%= wf_icon(:check, size: 12) %>Saved</span>
      <% end %>
    <% end %>
    <% if @collections.empty? && @drops.empty? && @pending.empty? %>
      <div class="w-center" style="padding:40px 16px;gap:8px">
        <div class="w-big-icon w-big-icon--pink"><%= wf_icon(:lock) %></div>
        <div style="font-size:17px;font-weight:800">Nothing unlocked yet</div>
        <div class="w-sub" style="font-size:13.5px">When a creator approves your payment, it lands here.</div>
      </div>
    <% end %>
  </div>

  <% if @memberships.any? %>
    <div style="padding:0 16px">
      <div class="w-eyebrow" style="margin-bottom:10px">Close Friends</div>
      <div class="w-stack" style="gap:8px">
        <% @memberships.each do |m| %>
          <% creator = m.subscription_plan.user %>
          <%= link_to profile_path(creator.handle, tab: "collections"), class: "w-list-row" do %>
            <div class="w-ring w-ring--gold" style="width:44px;height:44px;padding:2px"><% if (src = wf_avatar_src(creator)) %><%= image_tag src, alt: "", style: "border-width:2px" %><% end %></div>
            <div class="w-grow"><div style="font-size:14px;font-weight:800"><%= creator.name %></div><div class="w-gold" style="font-size:12px;margin-top:2px">★ until <%= m.current_period_ends_at.strftime("%-d %b") %></div></div>
            <span class="w-round-btn"><%= wf_icon(:arrow, size: 14) %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
