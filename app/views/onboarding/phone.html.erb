<%# 6a. %>
<% content_for :title, "Start your page | Wishful" %>
<% content_for :chrome, "fan" %>

<div class="w-screen" style="padding:0">
  <div style="height:380px;position:relative;flex:none">
    <%= image_tag "/assets/img/creator-saree.jpg", alt: "", style: "width:100%;height:100%;object-fit:cover;object-position:center 22%" %>
    <div style="position:absolute;inset:0;background:linear-gradient(to bottom,rgba(14,14,16,.2),var(--w-bg))"></div>
    <%= link_to root_path, class: "w-row", style: "position:absolute;top:20px;left:20px;gap:8px" do %>
      <span class="w-brand-mark">W</span><span style="font-size:17px;font-weight:800">Wishful</span>
    <% end %>
  </div>
  <%= form_with url: otp_path, method: :post, local: true, html: { style: "padding:0 20px calc(22px + env(safe-area-inset-bottom));display:flex;flex-direction:column;flex:1;margin-top:-40px;position:relative" } do %>
    <%= hidden_field_tag :intent, "creator" %>
    <h1 style="font-size:30px;font-weight:800;letter-spacing:-.03em;line-height:1.1;margin:0">Get paid by your fans.<br><span class="w-pink">Keep 100%.</span></h1>
    <p class="w-sub" style="font-size:14px;margin:10px 0 0;line-height:1.5">Collections, Close Friends, calls and link lists. Fans pay straight to your UPI.</p>
    <label class="w-input-wrap" style="margin-top:22px">
      <span class="w-prefix">+91</span><span class="w-sep"></span>
      <input type="tel" name="phone" inputmode="tel" autocomplete="tel-national" placeholder="98201 44100" required autofocus aria-label="Mobile number">
    </label>
    <div style="margin-top:auto;padding-top:28px">
      <button type="submit" class="w-btn w-btn--pink w-btn--lg w-btn--block">Get OTP on WhatsApp</button>
      <div class="w-dim" style="font-size:12px;text-align:center;margin-top:12px">
        Already a creator? <%= link_to "Sign in", sign_in_path, style: "color:var(--w-text);font-weight:700" %>
      </div>
    </div>
  <% end %>
</div>
