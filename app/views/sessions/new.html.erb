<% content_for :title, "Sign in — Wishful" %>
<div class="page">
  <section class="auth">
    <h1>Welcome back</h1>
    <p class="muted">Sign in to manage your page and confirm payments.</p>
    <%= form_with url: sign_in_path do |f| %>
      <div class="field">
        <%= f.label :email, "Email" %>
        <%= f.email_field :email, autocomplete: "email", spellcheck: false, autocapitalize: "off", required: true %>
      </div>
      <div class="field">
        <%= f.label :password, "Password" %>
        <%= f.password_field :password, autocomplete: "current-password", required: true %>
      </div>
      <div class="form-actions">
        <%= f.submit "Sign in", class: "button accent", data: { disable_with: "Signing in…" } %>
      </div>
    <% end %>
    <p class="muted" style="margin-top: var(--gap-3)">New here? <%= link_to "Make your page", sign_up_path %></p>
  </section>
</div>
