<main class="page"><section class="auth"><h1>Welcome back</h1><p class="muted">Sign in to manage your recommendations.</p><%= form_with url: sign_in_path do |f| %><div class="field"><%= f.label :email %><%= f.email_field :email, autofocus: true %></div><div class="field"><%= f.label :password %><%= f.password_field :password %></div><%= f.submit "Sign in", class: "button pink" %><% end %><p class="muted">New here? <%= link_to "Create your page", sign_up_path %></p></section></main>
