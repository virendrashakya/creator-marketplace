<main class="page"><section class="auth"><h1>Make your page</h1><p class="muted">Start sharing your favorite finds in a few minutes.</p><%= form_with model: @user, url: sign_up_path do |f| %><%= render "shared/errors", record: @user %><div class="field"><%= f.label :name, "Your name" %><%= f.text_field :name, autofocus: true, placeholder: "Mira Patel" %></div><div class="field"><%= f.label :handle, "Your page handle" %><%= f.text_field :handle, placeholder: "miraedits", prefix: "@" %></div><div class="field"><%= f.label :email %><%= f.email_field :email, placeholder: "you@example.com" %></div><div class="field"><%= f.label :password %><%= f.password_field :password, placeholder: "At least 6 characters" %></div><div class="field"><%= f.label :password_confirmation, "Confirm password" %><%= f.password_field :password_confirmation %></div><%= f.submit "Create my page", class: "button pink" %><% end %><p class="muted">Already creating? <%= link_to "Sign in", sign_in_path %></p></section></main>
