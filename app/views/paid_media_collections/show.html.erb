<% content_for :title, "#{@collection.title} · #{@user.name} | Wishful" %>
<% content_for :description, "#{@collection.contents_label} by #{@user.name}. Unlock on Wishful, paid directly over UPI." %>
<% content_for :chrome, "fan" %>
<% cover = wf_collection_cover_src(@collection) %>
<% if cover %><% content_for :og_image, "#{request.base_url}#{cover}" %><% end %>
<% hidden = [ @items.size - 1, 0 ].max %>

<div class="w-phone" style="padding-bottom:<%= @unlocked ? "40px" : "150px" %>">
  <div class="w-hero">
    <% if cover %><%= image_tag cover, alt: "Cover of #{@collection.title}" %><% end %>
    <div class="w-hero-bar">
      <%= link_to profile_path(@user.handle, tab: "collections"), class: "w-icon-btn w-icon-btn--glass", aria: { label: "Back to #{@user.name}" } do %><%= wf_icon(:back) %><% end %>
      <button type="button" class="w-icon-btn w-icon-btn--glass" data-share-url="<%= public_collection_url(@user.handle, @collection) %>" data-share-title="<%= @collection.title %>" aria-label="Share">
        <%= wf_icon(:share) %>
      </button>
    </div>
    <div class="w-hero-text">
      <div class="w-eyebrow w-eyebrow--gold"><%= @unlocked && !@own ? "Collection · yours" : "Collection · cover" %></div>
      <h1 class="w-hero-title" style="margin:4px 0 0"><%= @collection.title %></h1>
    </div>
  </div>

  <div style="padding:6px 16px 0">
    <div class="w-sub" style="font-size:13px">
      <%= @collection.contents_label %> · added <%= (@collection.release_at || @collection.created_at).strftime("%-d %b") %>
      <% if @own %> · <span class="w-status w-status--<%= @collection.status_label.downcase %>"><%= @collection.status_label %></span><% end %>
    </div>
    <% if @collection.description.present? %>
      <p style="font-size:14px;line-height:1.5;margin:8px 0 0"><%= @collection.description %></p>
    <% end %>

    <% if @unlocked %>
      <div class="w-row w-row--between" style="align-items:baseline;margin-top:20px">
        <span style="font-size:15px;font-weight:800"><%= @own ? "Everything inside" : "All yours" %></span>
        <span class="w-sub" style="font-size:12.5px"><%= @items.size %> <%= "item".pluralize(@items.size) %></span>
      </div>
      <div class="w-unlocked-grid">
        <% @items.each_with_index do |item, i| %>
          <%= link_to collection_viewer_path(@user.handle, @collection, i: i) do %>
            <% if item.media_type == "video" %>
              <% if item.preview.attached? %><%= image_tag url_for(item.preview), alt: "" %><% end %>
              <span class="w-tile-mark"><%= wf_icon(:play) %></span>
            <% else %>
              <%= image_tag media_paid_media_post_path(item), alt: "", loading: "lazy", draggable: false %>
            <% end %>
          <% end %>
        <% end %>
      </div>
      <% unless @own %>
        <p class="w-note" style="padding:14px 0 0;font-size:12px"><%= wf_icon(:shield) %>Your copy is watermarked with your handle</p>
      <% end %>
      <% if @own %>
        <%= link_to "Edit collection", edit_paid_media_collection_path(@collection), class: "w-btn w-btn--block", style: "margin-top:16px" %>
      <% end %>
    <% else %>
      <div class="w-row w-row--between" style="align-items:baseline;margin-top:20px">
        <span style="font-size:15px;font-weight:800">Inside this collection</span>
        <span class="w-sub" style="font-size:12.5px"><%= hidden %> hidden</span>
      </div>
      <% if hidden.positive? %>
        <div class="w-locked-grid" aria-label="<%= hidden %> hidden items">
          <% shown = hidden > 6 ? 5 : hidden %>
          <% @items.drop(1).first(shown).each do |item| %>
            <div class="w-locked"><%= item.media_type == "video" ? wf_icon(:play, size: 16) : wf_icon(:lock) %></div>
          <% end %>
          <% if hidden > 6 %><div class="w-locked w-locked--more">+<%= hidden - 5 %></div><% end %>
        </div>
      <% end %>
      <p class="w-note" style="padding:14px 0 0;font-size:12px"><%= wf_icon(:shield) %>Your copy is watermarked with your handle</p>
    <% end %>
  </div>
</div>

<% unless @unlocked %>
  <div class="w-dock-bottom">
    <% if @pending_claim %>
      <%= link_to payment_claim_path(@pending_claim), class: "w-btn w-btn--lg w-btn--block w-btn-split", style: "background:var(--w-gold-bg);border:1px solid var(--w-gold-line)" do %>
        <span>Waiting for <%= @user.first_name %> to approve</span><span class="w-gold"><%= wf_icon(:clock) %></span>
      <% end %>
    <% elsif @collection.price_cents.present? %>
      <%= link_to new_payment_claim_path("PaidMediaCollection", @collection.id, list: @list_id), class: "w-btn w-btn--pink w-btn--lg w-btn--block w-btn--glow w-btn-split" do %>
        <span>Unlock collection</span><span style="font-size:17px"><%= @collection.price_label %></span>
      <% end %>
    <% end %>
    <% if @plan&.active? %>
      <% if @collection.price_cents.present? %>
        <div class="w-sub" style="text-align:center;font-size:12.5px">
          or get <%= @all_count > 1 ? "all #{@all_count}" : "it" %> with
          <%= link_to "Close Friends · #{@plan.price_label}/mo", close_friends_path(@user.handle, plan: @plan.id), class: "w-gold", style: "font-weight:700" %>
        </div>
      <% else %>
        <%= link_to close_friends_path(@user.handle, plan: @plan.id), class: "w-btn w-btn--gold w-btn--lg w-btn--block w-btn-split" do %>
          <span>★ Included with Close Friends</span><span><%= @plan.price_label %>/mo</span>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
