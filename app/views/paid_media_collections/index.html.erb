    <script>
      (function() {
        const openBtn = document.getElementById('openNewDropBtn');
        const closeBtn = document.getElementById('closeDropModal');
        const cancelBtn = document.getElementById('cancelDropModal');
        const modal = document.getElementById('createDropModal');

        if (openBtn && modal) {
          openBtn.addEventListener('click', () => {
            modal.classList.remove('hidden');
          });
        }

        const closeModal = () => {
          if (modal) modal.classList.add('hidden');
        };

        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

        // Close on outside overlay click
        if (modal) {
          modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
          });
        }

        // Live Category Filtering
        const filterPills = document.querySelectorAll('.vault-filter-pill');
        const cards = document.querySelectorAll('.vault-item-card');
        const searchInput = document.getElementById('vaultSearchInput');

        function applyVaultFilters() {
          const activePill = document.querySelector('.vault-filter-pill.bg-secondary-container');
          const filter = activePill ? activePill.getAttribute('data-filter') : 'all';
          const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

          cards.forEach(card => {
            const cardType = card.getAttribute('data-type');
            const cardTitle = card.getAttribute('data-title') || '';
            const matchesCategory = (filter === 'all') || (cardType === filter);
            const matchesSearch = !query || cardTitle.includes(query);

            if (matchesCategory && matchesSearch) {
              card.style.display = '';
            } else {
              card.style.display = 'none';
            }
          });
        }

        filterPills.forEach(pill => {
          pill.addEventListener('click', () => {
            filterPills.forEach(p => {
              p.classList.remove('bg-secondary-container', 'text-on-secondary-container', 'font-semibold', 'shadow-sm');
              p.classList.add('text-on-surface-variant');
            });
            pill.classList.add('bg-secondary-container', 'text-on-secondary-container', 'font-semibold', 'shadow-sm');
            pill.classList.remove('text-on-surface-variant');
            applyVaultFilters();
          });
        });

        if (searchInput) {
          searchInput.addEventListener('input', applyVaultFilters);
        }
      })();

      function handleModalDropFile(input) {
        if (!input.files || !input.files[0]) return;
        const file = input.files[0];
        const text = document.getElementById('modal-drop-text');
        if (text) {
          const sizeMb = (file.size / (1024 * 1024)).toFixed(1);
          text.innerHTML = `<span class="text-primary font-semibold">${file.name}</span> (${sizeMb} MB) ready`;
        }
      }
    </script>
