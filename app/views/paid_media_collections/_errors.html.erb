<% if record.errors.any? %>
  <div class="w-errors" role="alert">
    <strong><%= record.errors.count == 1 ? "One thing to fix" : "#{record.errors.count} things to fix" %></strong>
    <ul><% record.errors.full_messages.each do |m| %><li><%= m.sub("Price cents", "Price").sub("Subscription plan", "Close Friends") %></li><% end %></ul>
  </div>
<% end %>
