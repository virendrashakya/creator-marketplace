<%# 5f. %>
<% content_for :title, "Book | Wishful Studio" %>
<% hour_px = 65 %>
<% days = (0..6).map { |i| @week_start + i.days } %>
<% first_offer = @meet_offers.first %>

<div class="w-page-head">
  <div>
    <h1 class="w-page-title">Book</h1>
    <div class="w-page-lede">Calls, lives and open slots. Fans book and pay over UPI from your profile.</div>
  </div>
  <div class="w-page-actions">
    <%= link_to "+ Open slots", (first_offer ? edit_meet_offer_path(first_offer) : new_meet_offer_path), class: "w-btn w-btn--outline" %>
    <%= link_to "+ Schedule live", new_live_session_path, class: "w-btn w-btn--pink" %>
  </div>
</div>

<div style="display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:16px;align-items:start" class="w-two-col">
  <div class="w-stack" style="gap:10px;min-width:0">
    <div class="w-row w-row--between">
      <span style="font-size:14px;font-weight:800"><%= @week_start.strftime("%-d %b") %> – <%= (@week_start + 6.days).strftime("%-d %b") %></span>
      <div class="w-row" style="gap:6px">
        <%= link_to "←", schedule_path(week: (@week_start - 7.days).iso8601), class: "w-btn w-btn--sm", aria: { label: "Previous week" } %>
        <%= link_to "This week", schedule_path, class: "w-btn w-btn--sm" %>
        <%= link_to "→", schedule_path(week: (@week_start + 7.days).iso8601), class: "w-btn w-btn--sm", aria: { label: "Next week" } %>
      </div>
    </div>
    <div class="w-cal-scroll">
      <div class="w-cal">
        <div class="w-cal-head">
          <span></span>
          <% days.each do |d| %><div class="<%= "is-today" if d == Date.current %>"><%= d.strftime("%a %-d") %></div><% end %>
        </div>
        <div class="w-cal-body" style="height:<%= (@last_hour - @first_hour) * hour_px %>px">
          <div class="w-cal-hours">
            <% (@first_hour...@last_hour).each_with_index do |h, i| %>
              <span style="top:<%= i * hour_px + 2 %>px"><%= Time.current.change(hour: h).strftime("%-l %p") %></span>
            <% end %>
          </div>
          <% days.each do |d| %>
            <div class="w-cal-col">
              <% @entries.select { |e| e.at.to_date == d }.each do |e| %>
                <% top = ((e.at.hour - @first_hour) * 60 + e.at.min) * hour_px / 60.0 %>
                <% mins = e.ends_at ? ((e.ends_at - e.at) / 60).round : 60 %>
                <% height = [ mins * hour_px / 60.0, 40 ].max %>
                <%= link_to e.path, class: "w-cal-ev w-cal-ev--#{e.kind}", style: "top:#{top.round}px;height:#{height.round}px" do %>
                  <% if e.kind == :open %>
                    Open slot
                  <% else %>
                    <strong><%= e.title %></strong><small><%= e.detail %></small>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <% if @next_up.any? %>
      <div class="w-card">
        <div class="w-card-head" style="padding-bottom:10px"><span class="w-card-title">Coming up</span></div>
        <% @next_up.each do |e| %>
          <%= link_to e.path, class: "w-needs-row" do %>
            <span class="w-dot <%= { live: "", call: "w-dot--green", open: "w-dot--blue" }[e.kind] %>"></span>
            <div class="w-grow"><div style="font-size:14px;font-weight:700"><%= e.title %></div><div class="w-sub" style="font-size:12px"><%= e.at.strftime("%a %-d %b") %> · <%= e.detail %></div></div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="w-stack" style="gap:10px">
    <div class="w-eyebrow">What fans can book</div>
    <% @meet_offers.each do |offer| %>
      <div class="w-card" style="padding:12px 14px">
        <div class="w-row">
          <%= link_to edit_meet_offer_path(offer), class: "w-grow" do %>
            <div style="font-size:13.5px;font-weight:800"><%= offer.title %></div>
            <div class="w-sub" style="font-size:11.5px;margin-top:2px"><%= offer.duration_minutes %> min · <%= offer.price_label %></div>
          <% end %>
          <%= form_with model: offer, local: true, class: "w-inline" do |f| %>
            <span class="w-switch"><%= f.hidden_field :published, value: "0", id: nil %><%= f.check_box :published, { include_hidden: false, data: { autosubmit: true }, aria: { label: "Bookable: #{offer.title}" } } %><span></span></span>
          <% end %>
        </div>
      </div>
    <% end %>
    <% @contact_reveals.each do |reveal| %>
      <div class="w-card" style="padding:12px 14px">
        <div class="w-row">
          <%= link_to edit_contact_reveal_path(reveal), class: "w-grow" do %>
            <div style="font-size:13.5px;font-weight:800"><%= reveal.label %></div>
            <div class="w-sub" style="font-size:11.5px;margin-top:2px">shared after approval · <%= reveal.price_label %></div>
          <% end %>
          <%= form_with model: reveal, local: true, class: "w-inline" do |f| %>
            <span class="w-switch"><%= f.hidden_field :published, value: "0", id: nil %><%= f.check_box :published, { include_hidden: false, data: { autosubmit: true }, aria: { label: "Available: #{reveal.label}" } } %><span></span></span>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="w-row" style="gap:8px">
      <%= link_to "+ Video call", new_meet_offer_path, class: "w-btn w-btn--dashed w-grow" %>
      <%= link_to "+ Paid access", new_contact_reveal_path, class: "w-btn w-btn--dashed w-grow" %>
    </div>
  </div>
</div>
