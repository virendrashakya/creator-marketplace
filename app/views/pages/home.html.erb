<% content_for :title, "Wishful: get paid for what only you have" %>
<% content_for :description, "Indian creators put their recommendations and their paid photos, videos and time on one page. Fans pay over UPI, straight into your bank. You keep everything." %>
<%# Marketing chrome even for a signed-in creator: this page's job is to
    explain the product, and an app bar on it would be navigation for a
    different task. %>
<% content_for :chrome, "marketing" %>
<% content_for :head do %>
  <link rel="stylesheet" href="/assets/home.css" data-turbo-track="reload">
  <%# Deferred: nothing here blocks first paint, and the page is complete
      without it. %>
  <script src="/assets/js/home.js" data-turbo-track="reload" defer></script>
<% end %>

<%#
  The argument, in order:
    1. Links are how you start. Selling is how you get paid.
    2. Here is the product actually working (the phone cycles through it).
    3. Here is the money path, and you are the one who approves it.
    4. Here is why 100% differs from a commission.
  No logo wall, no follower counts, no testimonial carousel: we do not have
  those numbers, and inventing them on a payments product is how trust dies.
%>

<section class="hero">
  <div class="hero-copy">
    <p class="hero-kicker">For Indian creators</p>
    <h1>Your posts earn likes.<br><span class="hero-em">Your Vault earns money.</span></h1>
    <p class="hero-lede">
      Lock exclusive drops, private sets, Close Friends VIP passes, and direct channels behind manual UPI verification.
      Fans pay straight into your bank account. You keep 100% of every rupee.
    </p>
    <div class="hero-actions">
      <%= link_to "Claim your handle", sign_up_path, class: "btn btn--accent btn--big" %>
      <% sample = @creators.find { |c| c.handle == "ananyarao" } || @creators.find { |c| c.paid_media_posts.any? } || @creators.first %>
      <% if sample.present? %>
        <%= link_to "See demo page (@#{sample.handle})", profile_path(sample.handle), class: "btn btn--ghost btn--big" %>
      <% end %>
    </div>
    <div class="hero-upi">
      <span class="hero-upi-label">Settles over</span>
      <span class="upi-marks" role="list">
        <span class="upi-mark" role="listitem">GPay</span>
        <span class="upi-mark" role="listitem">PhonePe</span>
        <span class="upi-mark" role="listitem">Paytm</span>
      </span>
    </div>
    <p class="hero-fine">Free to start. No gateway, no monthly fee, no cut of your money.</p>
  </div>

  <%# The artefact: a page, and the receipt it produced. The phone cycles
      browse -> locked -> unlocked, driven by home.js. %>
  <div class="hero-art">
    <div class="phone" data-phone data-phone-state="browse">
      <div class="phone-chrome"><span class="phone-url" translate="no">wishful.app/@ananyarao</span></div>
      <div class="phone-screen">
        <div class="phone-banner">
          <%= marketing_image :creator_hero, eager: true, class_name: "phone-banner-img" %>
          <div class="phone-avatar"><%= marketing_image :creator_hero, eager: true %></div>
        </div>
        <div class="phone-body">
          <div class="phone-name">Ananya Rao</div>
          <div class="phone-handle" translate="no">@ananyarao &middot; Mumbai</div>

          <%# The paid item. Its three states are driven by the parent's
              data-phone-state, so one element tells the whole story. %>
          <div class="phone-sell">
            <div class="phone-sell-media">
              <%= marketing_image :creator_locked, class_name: "phone-sell-img" %>
              <span class="phone-sell-veil" aria-hidden="true"></span>
              <span class="phone-chip phone-chip--lock">Locked</span>
              <span class="phone-chip phone-chip--open">Unlocked</span>
            </div>
            <div class="min0">
              <div class="phone-sell-title">Golden Hour in Goa (Uncensored 4K Set)</div>
              <div class="phone-sell-price">
                <span class="phone-price-ask">&#8377;499 to unlock</span>
                <span class="phone-price-paid">Paid &middot; yours now</span>
              </div>
            </div>
          </div>

          <div class="phone-divider"><span>Exclusive drops &amp; VIP passes</span></div>

          <div class="phone-link">
            <span class="phone-thumb" style="display: flex; align-items: center; justify-content: center; font-size: 16px; background: rgba(233,30,99,0.12); border-radius: 8px;">⭐</span>
            <span class="min0">
              <span class="phone-link-title truncate">Close Friends VIP Pass</span>
              <span class="phone-link-meta" translate="no">&#8377;499/mo &middot; All drops</span>
            </span>
          </div>
          <div class="phone-link">
            <span class="phone-thumb" style="display: flex; align-items: center; justify-content: center; font-size: 16px; background: rgba(16,185,129,0.12); border-radius: 8px;">💬</span>
            <span class="min0">
              <span class="phone-link-title truncate">Private Close Friends WhatsApp</span>
              <span class="phone-link-meta" translate="no">&#8377;999 &middot; Direct DMs</span>
            </span>
          </div>
          <div class="phone-link">
            <span class="phone-thumb" style="display: flex; align-items: center; justify-content: center; font-size: 16px; background: rgba(255,180,0,0.12); border-radius: 8px;">✨</span>
            <span class="min0">
              <span class="phone-link-title truncate">Spoil Me: Agent Provocateur Silk Robe</span>
              <span class="phone-link-meta" translate="no">&#8377;18,500 &middot; Wishlist</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <%# The receipt. A real QR block and a torn edge, because this is the
        object that has to feel legitimate. %>
    <div class="slip" aria-hidden="true">
      <div class="slip-head">
        <span class="slip-label">Paid to you</span>
        <span class="badge badge--ok">Approved</span>
      </div>
      <div class="slip-amount">&#8377;499</div>
      <div class="slip-qr"><%= render "pages/upi_qr" %></div>
      <div class="slip-lines">
        <div class="slip-line"><span>UTR</span><span class="ref">402913887561</span></div>
        <div class="slip-line"><span>To</span><span translate="no">ananya@okaxis</span></div>
        <div class="slip-line"><span>When</span><span>4:12 pm IST</span></div>
      </div>
      <div class="slip-foot">
        <span class="slip-keep">You keep &#8377;499</span>
        <span class="slip-keep-sub">No commission deducted</span>
      </div>
      <span class="slip-tear" aria-hidden="true"></span>
    </div>
  </div>
</section>

<section class="paths" aria-labelledby="paths-heading">
  <div class="paths-inner">
    <h2 class="paths-title" id="paths-heading" data-reveal>Two ways to earn, and they work together</h2>
    <div class="paths-grid">
      <article class="path" data-reveal>
        <p class="path-step">Start here</p>
        <h3 class="path-name">Curate your shoot looks & styles</h3>
        <p class="path-body">
          Your favorite swimwear, lingerie, outfits, and glam routines. When fans ask
          "where did you get that?", send them to your page with verified store links.
        </p>
        <ul class="path-list">
          <li>Group looks into themed collections</li>
          <li>Click counts on every piece</li>
          <li>Your personal styling note, not generic product ads</li>
        </ul>
      </article>

      <article class="path path--lead" data-reveal data-reveal-delay="90">
        <p class="path-step">Then get paid</p>
        <h3 class="path-name">Sell what your audience actually wants</h3>
        <p class="path-body">
          The Vault drops, the full uncensored set, Close Friends passes, your
          private Telegram channel, and direct 1:1 calls. Put it behind a price.
          A fan pays you on UPI and you approve it yourself.
        </p>
        <ul class="path-list">
          <li>The Vault: Exclusive photo & 4K video sets</li>
          <li>Close Friends / VIP monthly subscription pass</li>
          <li>Private Telegram & WhatsApp VIP channel reveals</li>
          <li>Spoil Me wishlists & 1:1 video call slots</li>
          <li>PPV pay-to-unlock media inside 1:1 Direct Messages</li>
        </ul>
      </article>
    </div>
  </div>
</section>

<section class="security-features" style="padding: 70px 24px; background: rgba(255,92,138,0.03); border-top: 1px solid var(--p-line); border-bottom: 1px solid var(--p-line);">
  <div style="max-width: 1040px; margin: 0 auto;">
    <div style="text-align: center; margin-bottom: 44px;" data-reveal>
      <span class="badge" style="background: rgba(255,92,138,0.12); color: var(--p-accent); border: 1px solid rgba(255,92,138,0.3); padding: 4px 12px; font-weight: 700; text-transform: uppercase; font-size: 11px;">
        🛡️ Built-in Content Shield & Viral Sharing
      </span>
      <h2 style="font-family: var(--display); font-size: clamp(26px, 3.5vw, 36px); margin: 12px 0 8px; color: var(--p-ink); letter-spacing: -0.02em;">
        Turn group-chat sharing into viral sales, not leaks.
      </h2>
      <p style="color: var(--p-sub); max-width: 660px; margin: 0 auto; font-size: 15px; line-height: 1.5;">
        People love sharing spicy drops on WhatsApp, Telegram, and Instagram. Wishful gives your fans official tracked teaser cards that lead their friends straight back to your UPI checkout.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
      <article class="path" data-reveal style="background: var(--p-card); border: 1px solid var(--p-line); border-radius: var(--r-xl); padding: 24px; box-shadow: var(--p-raised);">
        <div style="font-size: 26px; margin-bottom: 12px;">💬</div>
        <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 6px; color: var(--p-ink);">Controlled Viral Sharing</h3>
        <p style="font-size: 13px; color: var(--p-sub); line-height: 1.5; margin-bottom: 14px;">
          One-click sharing to WhatsApp and Telegram with rich OpenGraph unfurling. Friends see your frosted teaser and a direct link to unlock.
        </p>
        <ul class="path-list" style="font-size: 12px;">
          <li>Automated WhatsApp & Telegram link previews</li>
          <li>Ref-tracked links to reward loyal fans</li>
          <li>Never leaks the raw unblurred file</li>
        </ul>
      </article>

      <article class="path" data-reveal data-reveal-delay="70" style="background: var(--p-card); border: 1px solid var(--p-line); border-radius: var(--r-xl); padding: 24px; box-shadow: var(--p-raised);">
        <div style="font-size: 26px; margin-bottom: 12px;">🔒</div>
        <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 6px; color: var(--p-ink);">Server-Side Frosted Previews</h3>
        <p style="font-size: 13px; color: var(--p-sub); line-height: 1.5; margin-bottom: 14px;">
          We never deliver raw unblurred images over the wire. The backend physically strips high-frequency facial details and blurs pixels before serving.
        </p>
        <ul class="path-list" style="font-size: 12px;">
          <li>Zero theft via browser DevTools or inspect element</li>
          <li>Transparent shield overlays block right-click saves</li>
          <li>Genuinely frosted, high-speed cached previews</li>
        </ul>
      </article>

      <article class="path" data-reveal data-reveal-delay="140" style="background: var(--p-card); border: 1px solid var(--p-line); border-radius: var(--r-xl); padding: 24px; box-shadow: var(--p-raised);">
        <div style="font-size: 26px; margin-bottom: 12px;">🎯</div>
        <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 6px; color: var(--p-ink);">Forensic Buyer Watermarking</h3>
        <p style="font-size: 13px; color: var(--p-sub); line-height: 1.5; margin-bottom: 14px;">
          When an approved fan unlocks your set, their unique @handle and ID are dynamically stamped into the image pixels and EXIF metadata.
        </p>
        <ul class="path-list" style="font-size: 12px;">
          <li>Dual-layer visible & forensic attribution</li>
          <li>Leakers lose all deniability on Reddit or Telegram</li>
          <li>Creators always retain pristine originals</li>
        </ul>
      </article>
    </div>
  </div>
</section>

<section class="money" aria-labelledby="money-heading">
  <div class="money-inner">
    <div class="money-head">
      <div class="money-head-copy">
        <h2 id="money-heading" data-reveal>How the money reaches you</h2>
        <p class="money-lede" data-reveal data-reveal-delay="70">
          There is no payment gateway in the middle. Your fan pays your UPI ID,
          and you are the one who says yes.
        </p>
      </div>
      <figure class="money-shot" data-reveal data-reveal-delay="140">
        <%= marketing_image :phone_in_hand, class_name: "money-shot-img" %>
      </figure>
    </div>

    <%# A genuine sequence, so it is numbered. Nothing else on the page is. %>
    <ol class="flow">
      <li class="flow-step" data-reveal>
        <p class="flow-title">They see your QR</p>
        <p class="flow-body">Your UPI ID, your QR, your name as the payee.</p>
      </li>
      <li class="flow-step" data-reveal data-reveal-delay="60">
        <p class="flow-title">They pay from their app</p>
        <p class="flow-body">GPay, PhonePe, Paytm. Straight into your bank.</p>
      </li>
      <li class="flow-step" data-reveal data-reveal-delay="120">
        <p class="flow-title">They send the UTR</p>
        <p class="flow-body">The reference their app shows, and a screenshot if they want.</p>
      </li>
      <li class="flow-step flow-step--you" data-reveal data-reveal-delay="180">
        <p class="flow-title">You approve it</p>
        <p class="flow-body">Check it against your statement. Their access opens the moment you tap yes.</p>
      </li>
    </ol>

    <p class="money-note" data-reveal>
      Because the money never passes through us, there is nothing for us to
      take a cut of, and nothing to wait for. It is in your account before you
      have approved it.
    </p>
  </div>
</section>

<section class="keep" aria-labelledby="keep-heading">
  <div class="keep-inner">
    <h2 class="keep-title" id="keep-heading" data-reveal>A commission is not the same as being paid</h2>
    <div class="keep-grid">
      <div class="keep-col" data-reveal>
        <p class="keep-col-label">Affiliate commission</p>
        <p class="keep-figure keep-figure--them">
          <span>&#8377;2,499</span>
          <span class="keep-arrow" aria-hidden="true">&rarr;</span>
          <span class="visually-hidden">earns you</span>
          <strong>&#8377;200</strong>
        </p>
        <p class="keep-col-note">
          A fan buys the jeans you recommended. The store keeps the sale, pays
          a percentage, and confirms it next month. You earned 8%.
        </p>
      </div>
      <div class="keep-col keep-col--ours" data-reveal data-reveal-delay="90">
        <p class="keep-col-label">Sold on Wishful</p>
        <p class="keep-figure">
          <span>&#8377;499</span>
          <span class="keep-arrow" aria-hidden="true">&rarr;</span>
          <span class="visually-hidden">earns you</span>
          <strong>&#8377;499</strong>
        </p>
        <p class="keep-col-note">
          A fan unlocks the set you shot. They pay you directly. It is in your
          account today, and all of it is yours.
        </p>
      </div>
    </div>
    <p class="keep-foot" data-reveal>
      Keep doing both. The links are how people find what you are worth. The
      things you sell are how you get paid for it.
    </p>
  </div>
</section>

<section class="close" aria-labelledby="close-heading">
  <div class="close-inner">
    <h2 class="close-title" id="close-heading" data-reveal>Your handle is probably still free</h2>
    <p class="close-url" aria-hidden="true" data-reveal data-reveal-delay="70">
      <span class="close-url-dim">wishful.app/@</span><span class="close-url-cursor">yourname</span>
    </p>
    <div data-reveal data-reveal-delay="120">
      <%= link_to "Claim it", sign_up_path, class: "btn btn--accent btn--big" %>
    </div>
    <p class="close-fine" data-reveal data-reveal-delay="170">
      Takes a minute. You need a UPI ID and something worth sharing.
    </p>
  </div>
</section>
