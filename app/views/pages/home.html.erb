<% content_for :title, "Wishful — things worth vouching for" %>
<% content_for :head do %>
  <link rel="stylesheet" href="/assets/home.css">
<% end %>

<div class="page home">
  <section class="hero">
    <div class="hero-text">
      <h1>The things you actually use, on one page people can pay you for.</h1>
      <p class="hero-lede">Wishful is where you put the shampoo you repurchased, the lens you saved for, the café you send everyone to. Followers tap through, or pay you straight to your UPI.</p>
      <div class="actions">
        <%= link_to "Make your page", sign_up_path, class: "button accent" %>
        <% if (sample = @creators.find { |creator| creator.product_links.any? } || @creators.first) %>
          <%= link_to "See a real page", profile_path(sample.handle), class: "button light" %>
        <% end %>
      </div>
      <p class="hero-fine muted">Free to start. No cut taken on gifts.</p>
    </div>

    <%# The hero is a real vouch row at full size — the thing the product makes,
        shown in its own vernacular, rather than a phone mockup. %>
    <figure class="hero-sample" aria-labelledby="sample-cap">
      <div class="sample-row">
        <div class="sample-thumb" aria-hidden="true">◍</div>
        <div class="min0">
          <p class="sample-reason">“Carried it every day for eight months and the strap still hasn’t gone soft.”</p>
          <div class="sample-title">The everyday tote</div>
          <div class="sample-merchant">Zouk</div>
        </div>
        <div class="sample-price num">₹2,499</div>
      </div>
      <div class="sample-row sample-row--gift">
        <div class="sample-thumb" aria-hidden="true">◍</div>
        <div class="min0">
          <p class="sample-reason">“Saving for this one. Gifts go straight to my UPI.”</p>
          <div class="sample-title">35mm lens</div>
          <div class="sample-meter" role="img" aria-label="62 percent funded">
            <span style="width:62%"></span>
          </div>
          <div class="sample-merchant num">₹31,000 of ₹50,000</div>
        </div>
        <div class="sample-price num">Gift</div>
      </div>
      <figcaption id="sample-cap" class="muted">A page in progress, by @miraedits.</figcaption>
    </figure>
  </section>

  <section class="facets">
    <h2 class="facets-head">Made for recommendations, not for ads.</h2>
    <div class="facet-grid">
      <div class="facet">
        <h3>Say why, not just what</h3>
        <p>A link on its own persuades nobody. Every recommendation leads with your reason for it, in your words.</p>
      </div>
      <div class="facet">
        <h3>Paid directly, by UPI</h3>
        <p>Followers pay to your own UPI ID and send the reference number. You confirm it against your statement before anything unlocks.</p>
      </div>
      <div class="facet">
        <h3>Gifts, meetups, and private posts</h3>
        <p>Run a wishlist your audience can fund, sell a coffee and a portfolio review, or put a set of photos behind a one-time unlock.</p>
      </div>
    </div>
  </section>
</div>
