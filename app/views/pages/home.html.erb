<% content_for :title, "Wishful: one link for everything you recommend" %>
<% content_for :head do %>
  <link rel="stylesheet" href="/assets/home.css">
<% end %>

<section class="hero">
  <div>
    <h1>One link for everything you actually recommend.</h1>
    <p class="hero-lede">Your thrift finds, your presets, your time, your wishlist. Fans pay you straight over UPI, into your own account. No gateway sitting in the middle, no cut of your money going anywhere else.</p>
    <div class="actions">
      <%= link_to "Claim your handle", sign_up_path, class: "btn btn--accent btn--big" %>
      <% if (sample = @creators.find { |c| c.product_links.any? } || @creators.first) %>
        <%= link_to "See a live page", profile_path(sample.handle), class: "btn btn--ghost btn--big" %>
      <% end %>
    </div>
    <div class="hero-facts">
      <span>GPay, PhonePe, Paytm</span>
      <span>settles to your UPI ID</span>
    </div>
  </div>

  <%# The artefact the product makes: a creator page, and the receipt it produces. %>
  <div class="hero-art" aria-hidden="true">
    <div class="phone">
      <div class="phone-banner">
        <div class="phone-avatar">A</div>
      </div>
      <div class="phone-body">
        <div class="phone-name">Ananya Rao</div>
        <div class="phone-handle">@ananyarao</div>
        <div class="phone-links">
          <div class="phone-link">
            <div class="phone-thumb"></div>
            <div class="min0">
              <div class="phone-link-title truncate">Levi's 501, 1990s</div>
              <div class="phone-link-price">₹2,499</div>
            </div>
          </div>
          <div class="phone-link">
            <div class="phone-thumb"></div>
            <div class="min0">
              <div class="phone-link-title truncate">Closet audit, 40 min</div>
              <div class="phone-link-price">₹1,200</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="slip">
      <div class="slip-label">Payment received</div>
      <div class="slip-amount">₹2,499</div>
      <div class="slip-lines">
        <div class="slip-line"><span>UTR</span><span>402913887561</span></div>
        <div class="slip-line"><span>IST</span><span>19 Sep, 4:12 pm</span></div>
      </div>
      <div class="badge badge--ok" style="margin-top: 12px">Approved by you</div>
    </div>
  </div>
</section>

<section class="steps-band">
  <div class="steps-inner">
    <h2>How the money reaches you</h2>
    <p class="steps-lede">Four steps, and you are the one who says yes at the end.</p>
    <ol class="steps">
      <li class="step">
        <div class="step-title">They tap and see your QR</div>
        <div class="step-body">Your UPI ID, your QR, your payee name. Nothing of ours in between.</div>
      </li>
      <li class="step">
        <div class="step-title">They pay from their app</div>
        <div class="step-body">GPay, PhonePe, Paytm, whatever they already use. Straight to your bank.</div>
      </li>
      <li class="step">
        <div class="step-title">They send you the UTR</div>
        <div class="step-body">The 12 digit reference their app shows, plus a screenshot if they want.</div>
      </li>
      <li class="step">
        <div class="step-title">You approve it</div>
        <div class="step-body">Check it against your statement, tap approve, and their access opens instantly.</div>
      </li>
    </ol>
  </div>
</section>
