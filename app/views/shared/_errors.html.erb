<% if record.errors.any? %>
  <div class="errors" role="alert" tabindex="-1" data-errors autofocus>
    <strong><%= record.errors.count == 1 ? "One thing needs fixing" : "#{record.errors.count} things need fixing" %></strong>
    <ul>
      <% record.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
