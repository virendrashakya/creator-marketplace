<%#
  One entry point for every paid action. Routes to the creator's UPI payment
  page when they accept manual payments, otherwise falls back to the existing
  test-mode stub.
%>
<% if !signed_in? %>
  <%= link_to signed_out_label, sign_in_path, class: "btn btn--accent btn--block" %>
<% elsif creator.accepts_upi_manual? %>
  <%= link_to label, new_payment_claim_path(purchasable_type: purchasable.class.name, purchasable_id: purchasable.id),
        class: "btn btn--accent btn--block" %>
<% elsif defined?(fallback_path) && fallback_path %>
  <%= button_to label, fallback_path, class: "btn btn--accent btn--block",
        form: { data: { turbo_submits_with: "Working…" } } %>
<% else %>
  <span class="muted" style="font-size: 13.5px"><%= creator.name %> has not set up payments yet.</span>
<% end %>
