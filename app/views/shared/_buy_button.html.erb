<%#
  One entry point for every paid action. Routes to the creator's UPI payment
  page when they accept manual payments, otherwise falls back to the existing
  test-mode stub. A real gateway becomes a third branch here.
%>
<% if !signed_in? %>
  <%= link_to sign_in_path, class: "button accent small" do %><%= signed_out_label %> · <span class="num"><%= price_label %></span><% end %>
<% elsif creator.accepts_upi_manual? %>
  <%= link_to new_payment_claim_path(purchasable_type: purchasable.class.name, purchasable_id: purchasable.id), class: "button accent small" do %><%= label %> · <span class="num"><%= price_label %></span><% end %>
<% elsif defined?(fallback_path) && fallback_path %>
  <%= button_to fallback_path, class: "button accent small", form: { data: { turbo_submits_with: "Working…" } } do %><%= label %> · <span class="num"><%= price_label %></span><% end %>
<% else %>
  <span class="muted" style="font-size: var(--t--1)"><%= creator.name %> hasn’t set up payments yet. Check back soon.</span>
<% end %>
