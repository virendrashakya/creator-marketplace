<%#
  Amounts are stored in minor units (paise/cents). A bare number field labelled
  "(paise)" invites someone to type 499 and charge ₹4.99, so the unit is shown
  on the input itself and restated as a worked example beneath it.
%>
<% currency = record.try(:currency).presence || "INR" %>
<% unit = minor_unit_hint(currency) %>
<% field_id = "#{f.object_name.to_s.gsub(/[\[\]]+/, "_").squeeze("_").chomp("_")}_#{field}" %>
<% hint_id = "#{field_id}_hint" %>
<div class="field">
  <%= f.label field, label, for: field_id %>
  <div class="money-input">
    <span class="money-unit" aria-hidden="true"><%= currency == "USD" ? "$" : "₹" %></span>
    <%= f.number_field field, id: field_id, min: 1, step: 1, inputmode: "numeric", class: "num",
          placeholder: placeholder, aria: { describedby: hint_id } %>
  </div>
  <small id="<%= hint_id %>">
    In <%= unit %>: enter <%= number_with_delimiter(100_000) %> for <%= money(100_000, currency) %>.
  </small>
</div>
