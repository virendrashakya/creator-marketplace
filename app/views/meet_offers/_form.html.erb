<%= form_with model: @meet_offer do |f| %>
  <%= render "shared/errors", record: @meet_offer %>
  <div class="field">
    <%= f.label :title, "What are you offering?" %>
    <%= f.text_field :title, placeholder: "Coffee and a portfolio review" %>
  </div>
  <div class="field">
    <%= f.label :description, "What to expect" %>
    <%= f.text_area :description, placeholder: "How the time is spent, and what to bring…" %>
  </div>
  <div class="field">
    <%= f.label :location, "Where" %>
    <%= f.text_field :location, placeholder: "Bandra, Mumbai, or Video call" %>
  </div>
  <div class="field-row">
    <%= render "shared/price_field", f: f, record: @meet_offer, field: :price_cents, label: "Price", placeholder: "150000" %>
    <div class="field">
      <%= f.label :currency, "Currency" %>
      <%= f.select :currency, [ [ "Rupees (₹)", "INR" ], [ "Dollars ($)", "USD" ] ] %>
    </div>
    <div class="field">
      <%= f.label :duration_minutes, "Length (minutes)" %>
      <%= f.number_field :duration_minutes, min: 1, step: 1, inputmode: "numeric", class: "num", placeholder: "30" %>
    </div>
  </div>
  <label class="toggle-wrap">
    <%= f.check_box :published %>
    Show this on my page
  </label>
  <div class="actions" style="margin-top: 18px">
    <%= f.submit(@meet_offer.persisted? ? "Save meetup" : "Create meetup", class: "button accent", data: { disable_with: "Saving…" }) %>
    <%= link_to "Cancel", dashboard_path, class: "button light" %>
  </div>
<% end %>
