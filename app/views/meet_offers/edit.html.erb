<% content_for :title, "Edit meet offer | Wishful" %>
<div class="page"><section class="auth"><h1>Edit meet offer</h1><%= render "form" %></section></div>
<div class="page">
  <section class="panel auth auth--wide">
    <h2>Times you are free</h2>
    <p class="muted">People book one of these slots and pay for it up front.</p>
    <% slots = @meet_offer.meet_slots.order(:starts_at) %>
    <% if slots.any? %>
      <% slots.each do |slot| %>
        <div class="row">
          <div class="min0">
            <div class="row-title num"><%= l slot.starts_at, format: :slot %></div>
            <div class="row-meta">
              Until <%= l slot.ends_at, format: :time_only %> · <%= slot_timezone_label %>
              <% if slot.booked? %><span class="state state--confirmed">Booked</span><% end %>
            </div>
          </div>
          <% unless slot.booked? %>
            <div class="actions actions--end">
              <%= button_to "Remove", meet_offer_meet_slot_path(@meet_offer, slot), method: :delete, class: "danger", form: { data: { turbo_confirm: "Remove the slot on #{l slot.starts_at, format: :slot}?" } } %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="empty"><strong>No times yet.</strong> Add your first slot below so people can book you.</div>
    <% end %>

    <% new_slot = @meet_slot || @meet_offer.meet_slots.new %>
    <%= form_with model: [ @meet_offer, new_slot ] do |f| %>
      <%= render "shared/errors", record: new_slot %>
      <div class="field-row">
        <div class="field"><%= f.label :starts_at, "Starts" %><%= f.datetime_field :starts_at %></div>
        <div class="field"><%= f.label :ends_at, "Ends" %><%= f.datetime_field :ends_at %></div>
      </div>
      <p class="muted" style="font-size: var(--t--1)">Times are in <%= slot_timezone_label %>.</p>
      <div class="form-actions"><%= f.submit "Add slot", class: "button accent", data: { disable_with: "Adding…" } %></div>
    <% end %>
  </section>
</div>
