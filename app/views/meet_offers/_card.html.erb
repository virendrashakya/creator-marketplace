<article class="offer">
  <span class="vouch-thumb" aria-hidden="true">◍</span>
  <div class="min0">
    <div class="offer-title break"><%= card.title %></div>
    <div class="offer-note">
      <%= [ card.location.presence, "#{card.duration_minutes} min", card.price_label ].compact.join(" · ") %>
    </div>
    <% if card.description.present? %>
      <div class="offer-note clamp-2"><%= card.description %></div>
    <% end %>
    <% slots = card.meet_slots.bookable.limit(5) %>
    <% if slots.any? %>
      <div class="slots">
        <% slots.each do |slot| %>
          <% slot_label = l(slot.starts_at, format: :slot_short) %>
          <% if !signed_in? %>
            <%= link_to sign_in_path, class: "button accent small num" do %><%= slot_label %><span class="visually-hidden">: sign in to book</span><% end %>
          <% elsif card.user.accepts_upi_manual? %>
            <%= link_to new_payment_claim_path(purchasable_type: "MeetSlot", purchasable_id: slot.id), class: "button accent small num" do %><%= slot_label %><span class="visually-hidden">: book this time</span><% end %>
          <% else %>
            <%= button_to book_meet_slot_path(slot), class: "button accent small num", form: { data: { turbo_submits_with: "Booking…" } } do %><%= slot_label %><span class="visually-hidden">: book this time</span><% end %>
          <% end %>
        <% end %>
      </div>
      <p class="offer-note">Times shown in <%= slot_timezone_label %>.</p>
    <% else %>
      <div class="offer-note">No open times right now. <%= card.user.name %> adds new ones as they free up.</div>
    <% end %>
  </div>
</article>
