<article class="meet" style="border: 1px solid var(--p-line); border-radius: var(--r-xl); padding: clamp(18px, 3vw, 24px); background: var(--p-card); box-shadow: var(--p-raised);">
  <div class="min0">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap;">
      <span class="badge badge--spicy" style="font-size: 11px;">📹 1:1 Video Session</span>
      <span class="badge badge--ok" style="font-size: 11px;">100% Confidential</span>
    </div>
    <div class="meet-title break" style="font-weight: 700; font-size: 20px; color: var(--p-ink); margin-bottom: 6px;"><%= card.title %></div>
    <% if card.description.present? %>
      <p class="meet-desc" style="font-size: 14px; color: var(--p-sub); line-height: 1.5; margin-bottom: 12px;"><%= card.description %></p>
    <% end %>
    <div class="meet-facts" style="display: flex; flex-direction: row; flex-wrap: wrap; gap: 12px; align-items: center;">
      <span style="font-size: 18px; font-weight: 700; color: var(--p-accent);"><%= card.price_label %></span>
      <span class="pf-badge" style="opacity: 0.9;">⏳ <%= card.duration_minutes %> mins</span>
      <% if card.location.present? %>
        <span class="pf-badge" style="opacity: 0.9;">📍 <%= card.location %></span>
      <% end %>
    </div>
  </div>
  <div class="min0" style="border-left: 1px solid var(--p-line); padding-left: clamp(16px, 2.5vw, 24px);">
    <% slots = card.meet_slots.bookable.limit(6) %>
    <div class="slots-label" style="font-weight: 700; font-size: 13px; margin-bottom: 6px; color: var(--p-ink);">
      Available Slots (<%= slot_timezone_label %>)
    </div>
    <div style="font-size: 11.5px; color: var(--p-sub); margin-bottom: 10px;">Tap a slot to lock your session via UPI</div>
    <% if slots.any? %>
      <div class="slots">
        <% slots.each do |slot| %>
          <% label = l(slot.starts_at, format: :slot_short) %>
          <% if !signed_in? %>
            <%= link_to sign_in_path, class: "slot", style: "border-radius: var(--r-md); font-weight: 600;" do %>
              <%= label %><span class="visually-hidden">: sign in to book</span>
            <% end %>
          <% elsif card.user.accepts_upi_manual? %>
            <%= link_to new_payment_claim_path(purchasable_type: "MeetSlot", purchasable_id: slot.id), class: "slot", style: "border-radius: var(--r-md); font-weight: 600;" do %>
              <%= label %><span class="visually-hidden">: book this time</span>
            <% end %>
          <% else %>
            <%= button_to book_meet_slot_path(slot), class: "slot", style: "border-radius: var(--r-md); font-weight: 600;", form: { data: { turbo_submits_with: "Booking…" } } do %>
              <%= label %><span class="visually-hidden">: book this time</span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty">
        <div class="empty-body" style="font-size: 13px; color: var(--p-sub);">All slots booked for now. New ones open as <%= card.user.name.split.first %> adds availability.</div>
      </div>
    <% end %>
  </div>
</article>
