<% content_for :title, "Profile and settings — Wishful" %>
<div class="page">
  <section class="auth auth--wide">
    <h1>Profile and settings</h1>
    <p class="muted">Your account, how your page looks, and how you get paid.</p>

    <%= form_with model: @user, url: creator_settings_path, method: :patch do |f| %>
      <%= render "shared/errors", record: @user %>

      <fieldset>
        <legend id="account">Account</legend>
        <div class="field-row">
          <div class="field">
            <%= f.label :name, "Display name" %>
            <%= f.text_field :name, autocomplete: "name" %>
          </div>
          <div class="field">
            <%= f.label :email, "Email" %>
            <%= f.email_field :email, autocomplete: "email", spellcheck: false, autocapitalize: "off", aria: { describedby: "email_hint" } %>
            <small id="email_hint">Private. Used to sign in.</small>
          </div>
          <div class="field">
            <%= f.label :account_type, "Account type" %>
            <%= f.select :account_type, [ [ "Creator", "creator" ], [ "Personal", "personal" ], [ "Business", "business" ] ] %>
          </div>
          <div class="field">
            <%= f.label :date_of_birth, "Date of birth" %>
            <%= f.date_field :date_of_birth, autocomplete: "bday" %>
            <small>Private.</small>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend id="public">Public profile</legend>
        <div class="field">
          <%= f.label :bio, "Bio" %>
          <%= f.text_area :bio, maxlength: 400, placeholder: "The things you are known for recommending…" %>
        </div>
        <div class="field-row">
          <div class="field">
            <%= f.label :profile_picture, "Profile picture" %>
            <%= f.file_field :profile_picture, accept: "image/*" %>
            <% if current_user.profile_picture.attached? %><small>One is already uploaded. Choosing a new file replaces it.</small><% end %>
          </div>
          <div class="field">
            <%= f.label :banner, "Banner" %>
            <%= f.file_field :banner, accept: "image/*" %>
            <% if current_user.banner.attached? %><small>One is already uploaded. Choosing a new file replaces it.</small><% end %>
          </div>
          <div class="field">
            <%= f.label :pronouns, "Pronouns" %>
            <%= f.text_field :pronouns, placeholder: "she/her", spellcheck: false %>
          </div>
          <div class="field">
            <%= f.label :location, "Location" %>
            <%= f.text_field :location, autocomplete: "address-level2", placeholder: "Mumbai" %>
          </div>
          <div class="field">
            <%= f.label :public_email, "Public contact email" %>
            <%= f.email_field :public_email, autocomplete: "off", spellcheck: false, autocapitalize: "off" %>
            <small>Shown on your page. Leave blank to hide it.</small>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend id="style">Category and style</legend>
        <div class="field-row">
          <div class="field">
            <%= f.label :creator_category, "Category" %>
            <%= f.select :creator_category, [ "Fashion", "Beauty", "Fitness", "Travel", "Food", "Gaming", "Lifestyle", "Art & design", "Music", "Adult creator" ], include_blank: "Choose a category" %>
          </div>
          <div class="field">
            <%= f.label :creator_subcategory, "Subcategory" %>
            <%= f.text_field :creator_subcategory, placeholder: "Solo travel" %>
          </div>
          <div class="field">
            <%= f.label :theme, "Theme" %>
            <%= f.select :theme, [ [ "Minimal", "minimal" ], [ "Luxury", "luxury" ], [ "Adventure", "adventure" ], [ "After dark", "after_dark" ] ] %>
          </div>
          <div class="field">
            <%= f.label :profile_layout, "Layout" %>
            <%= f.select :profile_layout, [ [ "List", "classic" ], [ "Editorial", "editorial" ], [ "Gallery", "gallery" ] ] %>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend id="payments">Payments</legend>
        <p class="muted" style="font-size: var(--t--1)">Followers pay your UPI ID directly and send you the reference number. You confirm each one before access opens.</p>
        <div class="field-row">
          <div class="field">
            <%= f.label :upi_id, "Your UPI ID" %>
            <%= f.text_field :upi_id, placeholder: "yourname@okhdfcbank", autocomplete: "off", spellcheck: false, autocapitalize: "off", class: "ref" %>
          </div>
          <div class="field">
            <%= f.label :upi_payee_name, "Payee name" %>
            <%= f.text_field :upi_payee_name, autocomplete: "off", aria: { describedby: "payee_hint" } %>
            <small id="payee_hint">Exactly as it appears in your UPI app, so payers know it is you.</small>
          </div>
          <div class="field">
            <%= f.label :upi_qr, "UPI QR code" %>
            <%= f.file_field :upi_qr, accept: "image/*" %>
            <% if current_user.upi_qr.attached? %><small>One is already uploaded. Choosing a new file replaces it.</small><% end %>
          </div>
        </div>
        <label class="check">
          <%= f.check_box :accepts_upi_manual %>
          Accept UPI payments
        </label>
      </fieldset>

      <fieldset>
        <legend id="social">Social links</legend>
        <div class="field-row">
          <div class="field"><%= f.label :instagram_handle, "Instagram" %><%= f.text_field :instagram_handle, placeholder: "@yourhandle", autocomplete: "off", spellcheck: false, autocapitalize: "off" %></div>
          <div class="field"><%= f.label :youtube_handle, "YouTube" %><%= f.text_field :youtube_handle, placeholder: "@yourchannel", autocomplete: "off", spellcheck: false, autocapitalize: "off" %></div>
          <div class="field"><%= f.label :x_handle, "X" %><%= f.text_field :x_handle, placeholder: "@yourhandle", autocomplete: "off", spellcheck: false, autocapitalize: "off" %></div>
          <div class="field"><%= f.label :reddit_handle, "Reddit" %><%= f.text_field :reddit_handle, placeholder: "u/yourhandle", autocomplete: "off", spellcheck: false, autocapitalize: "off" %></div>
          <div class="field"><%= f.label :tiktok_handle, "TikTok" %><%= f.text_field :tiktok_handle, placeholder: "@yourhandle", autocomplete: "off", spellcheck: false, autocapitalize: "off" %></div>
          <div class="field"><%= f.label :website_url, "Website" %><%= f.url_field :website_url, placeholder: "https://…", autocomplete: "url", spellcheck: false, autocapitalize: "off" %></div>
        </div>
      </fieldset>

      <div class="form-actions">
        <%= f.submit "Save settings", class: "button accent", data: { disable_with: "Saving…" } %>
        <%= link_to "Cancel", dashboard_path, class: "button light" %>
      </div>
    <% end %>
  </section>
</div>
