<main class="page"><section class="auth" style="max-width:680px"><h1>Creator profile & settings</h1><p class="muted">Manage your account, public identity, and page appearance.</p><%= form_with model: @user, url: creator_settings_path, method: :patch do |f| %><%= render "shared/errors", record: @user %><h3>Account</h3><div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><div class="field"><%= f.label :name, "Display name" %><%= f.text_field :name %></div><div class="field"><%= f.label :email, "Account email (private)" %><%= f.email_field :email %></div><div class="field"><%= f.label :account_type %><%= f.select :account_type, [["Creator", "creator"], ["Personal", "personal"], ["Business", "business"]] %></div><div class="field"><%= f.label :date_of_birth, "Date of birth (private)" %><%= f.date_field :date_of_birth %></div></div><h3>Public profile</h3><div class="field"><%= f.label :bio %><%= f.text_area :bio %></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><div class="field"><%= f.label :profile_picture, "Profile picture" %><%= f.file_field :profile_picture, accept: "image/*" %></div><div class="field"><%= f.label :banner, "Profile banner" %><%= f.file_field :banner, accept: "image/*" %></div><div class="field"><%= f.label :pronouns %><%= f.text_field :pronouns, placeholder: "she/her" %></div><div class="field"><%= f.label :location %><%= f.text_field :location, placeholder: "Mumbai, India" %></div><div class="field"><%= f.label :public_email, "Public contact email" %><%= f.email_field :public_email %></div></div><h3>Creator identity & style</h3><div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><div class="field"><%= f.label :creator_category, "Creator category" %><%= f.select :creator_category, ["Fashion", "Beauty", "Fitness", "Travel", "Food", "Gaming", "Lifestyle", "Art & design", "Music", "Adult creator"] , include_blank: "Choose a category" %></div><div class="field"><%= f.label :creator_subcategory, "Subcategory" %><%= f.text_field :creator_subcategory, placeholder: "e.g. Solo travel" %></div><div class="field"><%= f.label :theme, "Page theme" %><%= f.select :theme, [["Minimal", "minimal"], ["Luxury", "luxury"], ["Adventure", "adventure"], ["After dark", "after_dark"]] %></div><div class="field"><%= f.label :profile_layout, "Page layout" %><%= f.select :profile_layout, [["Classic list", "classic"], ["Editorial", "editorial"], ["Gallery", "gallery"]] %></div></div><h3>Payments (UPI)</h3><p class="muted" style="font-size:13px;margin:0 0 10px">Followers pay you directly by UPI, then submit the reference number. You confirm each payment yourself before access is granted.</p><div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><div class="field"><%= f.label :upi_id, "Your UPI ID" %><%= f.text_field :upi_id, placeholder: "yourname@okhdfcbank" %></div><div class="field"><%= f.label :upi_payee_name, "Payee name shown to followers" %><%= f.text_field :upi_payee_name, placeholder: "As it appears in your UPI app" %></div><div class="field"><%= f.label :upi_qr, "UPI QR code image" %><%= f.file_field :upi_qr, accept: "image/*" %><% if current_user.upi_qr.attached? %><small class="muted">A QR code is already uploaded.</small><% end %></div><div class="field" style="align-self:end"><label><%= f.check_box :accepts_upi_manual %> Accept UPI payments</label></div></div><h3>Social links</h3><div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><div class="field"><%= f.label :instagram_handle, "Instagram" %><%= f.text_field :instagram_handle, placeholder: "@yourhandle" %></div><div class="field"><%= f.label :youtube_handle, "YouTube" %><%= f.text_field :youtube_handle, placeholder: "@channel" %></div><div class="field"><%= f.label :x_handle, "X / Twitter" %><%= f.text_field :x_handle, placeholder: "@yourhandle" %></div><div class="field"><%= f.label :reddit_handle, "Reddit" %><%= f.text_field :reddit_handle, placeholder: "u/yourhandle" %></div><div class="field"><%= f.label :tiktok_handle, "TikTok" %><%= f.text_field :tiktok_handle, placeholder: "@yourhandle" %></div><div class="field"><%= f.label :website_url, "Website" %><%= f.url_field :website_url, placeholder: "https://..." %></div></div><div class="form-actions"><%= f.submit "Save settings", class: "button pink" %><%= link_to "Cancel", dashboard_path, class: "button light" %></div><% end %></section></main>
