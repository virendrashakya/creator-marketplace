<%# 5h. %>
<% content_for :title, "Settings | Wishful Studio" %>
<% field = ->(label, &blk) { content_tag(:label, content_tag(:span, label, class: "w-label") + capture(&blk), class: "w-field") } %>

<%= form_with model: @user, url: creator_settings_path, method: :patch, local: true, multipart: true, html: { class: "w-stack", style: "gap:20px" } do |f| %>
  <div class="w-page-head">
    <div>
      <h1 class="w-page-title">Settings</h1>
      <div class="w-page-lede">Your profile, your links and where the money goes.</div>
    </div>
    <div class="w-page-actions"><%= f.submit "Save changes", class: "w-btn w-btn--pink" %></div>
  </div>

  <%= render "paid_media_collections/errors", record: @user %>

  <div class="w-settings-grid">
    <div class="w-card" style="padding:18px">
      <div class="w-card-title">Profile</div>
      <div class="w-row" style="gap:12px;margin:14px 0">
        <%= wf_avatar(@user, size: 56) %>
        <label class="w-btn w-btn--sm" style="position:relative">
          Change photo
          <%= f.file_field :profile_picture, accept: "image/*", style: "position:absolute;inset:0;opacity:0;cursor:pointer" %>
        </label>
        <label class="w-btn w-btn--sm w-btn--ghost" style="position:relative">
          Cover
          <%= f.file_field :banner, accept: "image/*", style: "position:absolute;inset:0;opacity:0;cursor:pointer" %>
        </label>
      </div>
      <div class="w-stack">
        <%= field.call("Name") { f.text_field :name, class: "w-input", required: true } %>
        <label class="w-field"><span class="w-label">Handle</span>
          <span class="w-input w-row w-row--between" style="display:flex">
            <span>@<%= @user.handle %></span><span class="w-dim" style="font-size:11px;font-weight:600">your link · fixed</span>
          </span>
        </label>
        <%= field.call("Category") { f.text_field :creator_category, class: "w-input", placeholder: "Saree draper" } %>
        <%= field.call("Also") { f.text_field :creator_subcategory, class: "w-input", placeholder: "Editorial model" } %>
        <%= field.call("City") { f.text_field :location, class: "w-input", placeholder: "Mumbai" } %>
        <%= field.call("Bio") { f.text_area :bio, class: "w-textarea", rows: 3, maxlength: 250 } %>
      </div>
    </div>

    <div class="w-card" style="padding:18px">
      <div class="w-card-title">Socials, blog &amp; website</div>
      <div class="w-sub" style="font-size:12px;margin-top:3px">Link lists choose which of these to show.</div>
      <div class="w-stack" style="margin-top:14px">
        <%= field.call("Instagram") { f.text_field :instagram_handle, class: "w-input", placeholder: "@yourname", autocapitalize: "off" } %>
        <%= field.call("YouTube") { f.text_field :youtube_handle, class: "w-input", placeholder: "yourchannel", autocapitalize: "off" } %>
        <%= field.call("Website") { f.text_field :website_url, class: "w-input", placeholder: "yourname.in", autocapitalize: "off" } %>
        <%= field.call("Blog") { f.text_field :blog_url, class: "w-input", placeholder: "yourname.in/blog", autocapitalize: "off" } %>
        <%= field.call("X") { f.text_field :x_handle, class: "w-input", placeholder: "@yourname", autocapitalize: "off" } %>
        <details>
          <summary class="w-sub" style="font-size:12.5px;cursor:pointer">+ Add another link</summary>
          <div class="w-stack" style="margin-top:10px">
            <%= field.call("TikTok") { f.text_field :tiktok_handle, class: "w-input", autocapitalize: "off" } %>
            <%= field.call("Reddit") { f.text_field :reddit_handle, class: "w-input", autocapitalize: "off" } %>
            <%= field.call("Public email") { f.email_field :public_email, class: "w-input" } %>
          </div>
        </details>
      </div>
    </div>

    <div class="w-card" style="padding:18px">
      <div class="w-card-title">UPI payouts</div>
      <div class="w-sub" style="font-size:12px;margin-top:3px">Fans pay this ID directly. Wishful takes 0%.</div>
      <div class="w-stack" style="margin-top:14px">
        <label class="w-field"><span class="w-label">UPI ID</span>
          <span class="w-input w-row" style="display:flex;padding-right:10px">
            <%= f.text_field :upi_id, style: "flex:1;border:0;background:transparent;color:inherit;font:inherit;outline:none;min-width:0", placeholder: "yourname@okhdfc", autocapitalize: "off", translate: "no" %>
            <% if @user.upi_id.present? && @user.accepts_upi_manual? %><span class="w-green" style="font-size:11px;font-weight:800;white-space:nowrap">✓ Accepting</span><% end %>
          </span>
        </label>
        <%= field.call("Name on bank account") { f.text_field :upi_payee_name, class: "w-input", placeholder: "AS YOUR BANK SHOWS IT" } %>
        <%= field.call("Backup UPI ID") { f.text_field :backup_upi_id, class: "w-input", placeholder: "optional", autocapitalize: "off" } %>
        <label class="w-field"><span class="w-label">UPI QR code<%= " · uploaded" if @user.upi_qr.attached? %></span>
          <%= f.file_field :upi_qr, accept: "image/*", class: "w-input", style: "padding-top:9px;font-size:12px" %>
        </label>
        <div class="w-switch-row" style="padding-top:10px">
          <span>Auto-approve exact matches under ₹
            <input type="number" name="auto_approve_rupees" min="1" step="1" value="<%= (@user.auto_approve_under_cents || 20000) / 100 %>" class="w-input" style="width:72px;height:28px;display:inline-block;padding:0 6px;font-size:12.5px" aria-label="Auto-approve limit in rupees">
          </span>
          <span class="w-switch">
            <input type="hidden" name="auto_approve" value="0">
            <input type="checkbox" name="auto_approve" value="1" <%= "checked" if @user.auto_approve_under_cents %> aria-label="Auto-approve small exact payments"><span></span>
          </span>
        </div>
        <div class="w-dim" style="font-size:11.5px;margin-top:-4px">A UTR is never checked against your bank automatically. Only switch this on if you're comfortable approving small amounts unseen.</div>
        <div class="w-switch-row">
          <span>WhatsApp me for new claims<%= " (add a phone number first)" if @user.phone_number.blank? %></span>
          <span class="w-switch"><%= f.hidden_field :notify_whatsapp_claims, value: "0", id: nil %><%= f.check_box :notify_whatsapp_claims, { include_hidden: false, disabled: @user.phone_number.blank?, aria: { label: "WhatsApp me for new claims" } } %><span></span></span>
        </div>
      </div>
    </div>
  </div>
<% end %>

<div class="w-settings-grid">
  <div class="w-card" style="padding:18px">
    <div class="w-row w-row--between"><span class="w-card-title">Close Friends</span><%= link_to "+ Plan", new_subscription_plan_path, class: "w-btn w-btn--xs" %></div>
    <div class="w-stack" style="margin-top:12px;gap:8px">
      <% @plans.each do |plan| %>
        <%= link_to edit_subscription_plan_path(plan), class: "w-row w-row--between", style: "font-size:13px" do %>
          <span><%= plan.name %><%= " · off" unless plan.active? %></span><strong><%= plan.price_label %>/mo</strong>
        <% end %>
      <% end %>
      <% if @plans.empty? %><div class="w-sub" style="font-size:12.5px">No plan yet. Close Friends is a monthly pass that unlocks the collections you include in it.</div><% end %>
    </div>
  </div>
  <div class="w-card" style="padding:18px">
    <div class="w-row w-row--between"><span class="w-card-title">Spoil me</span><%= link_to "+ List", new_wishlist_path, class: "w-btn w-btn--xs" %></div>
    <div class="w-stack" style="margin-top:12px;gap:8px">
      <% @wishlists.each do |list| %>
        <div class="w-row w-row--between" style="font-size:13px">
          <%= link_to list.title, edit_wishlist_path(list), class: "w-ellipsis" %>
          <span class="w-row" style="gap:6px"><span class="w-sub"><%= pluralize(list.wishlist_items.size, "gift") %></span><%= link_to "+ Gift", new_wishlist_wishlist_item_path(list), class: "w-btn w-btn--xs" %></span>
        </div>
      <% end %>
      <% if @wishlists.empty? %><div class="w-sub" style="font-size:12.5px">Gifts fans can chip in for, with a progress bar.</div><% end %>
    </div>
  </div>
  <div class="w-card" style="padding:18px">
    <div class="w-card-title">Account</div>
    <div class="w-stack" style="margin-top:12px;gap:10px;font-size:13px">
      <div class="w-kv"><span>Phone</span><span translate="no"><%= @user.phone_number.presence || "Not added" %></span></div>
      <div class="w-kv"><span>Email</span><span><%= @user.email.presence || "Not added" %></span></div>
      <div class="w-row w-row--between"><span>Blocked accounts</span><%= link_to (@blocks_count.positive? ? "Manage (#{@blocks_count})" : "Manage"), creator_blocks_path, class: "w-btn w-btn--xs" %></div>
      <div class="w-row w-row--between"><span>Appearance</span><%= render "shared/theme_switch", labels: true %></div>
      <div class="w-row w-row--between"><span>Push notifications</span><button type="button" class="w-btn w-btn--xs" data-push-enable><%= current_user.push_subscriptions.any? ? "On · add this device" : "Turn on" %></button></div>
    </div>
  </div>
</div>
