<%# The reason is the product. Everything else is the credit line. %>
<%= link_to visit_product_link_path(card), class: "rec", target: "_blank", rel: "noopener noreferrer" do %>
  <span class="rec-media">
    <% if card.image_url.present? %>
      <%= image_tag card.image_url, alt: "", width: 232, height: 232, loading: "lazy" %>
    <% end %>
    <% if card.featured? %>
      <span class="rec-flag">Featured</span>
    <% end %>
  </span>
  <span class="rec-body">
    <span class="rec-top">
      <span class="rec-title"><%= card.title %></span>
      <% if card.price.present? %><span class="rec-price"><%= card.price %></span><% end %>
    </span>
    <% if card.merchant.present? %>
      <span class="rec-merchant badge badge--merchant" translate="no"><%= card.merchant %></span>
    <% end %>
    <% if card.description.present? %>
      <span class="rec-reason"><%= card.description %></span>
    <% end %>
    <span class="rec-cta">
      <%= card.merchant.present? ? "Buy on #{card.merchant}" : "Open the link" %>
    </span>
    <span class="visually-hidden">(opens in a new tab)</span>
  </span>
<% end %>
