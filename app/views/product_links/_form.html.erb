<%= form_with model: @product_link do |f| %><%= render "shared/errors", record: @product_link %><div class="field"><%= f.label :title, "What are you recommending?" %><%= f.text_field :title, placeholder: "The perfect everyday tote", autofocus: true %></div><div class="field"><%= f.label :url, "Destination URL" %><%= f.url_field :url, placeholder: "https://..." %></div><div class="field"><%= f.label :image_url, "Image URL (optional)" %><%= f.url_field :image_url, placeholder: "https://..." %></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><div class="field"><%= f.label :merchant %><%= f.text_field :merchant, placeholder: "Brand or store" %></div><div class="field"><%= f.label :price %><%= f.text_field :price, placeholder: "₹2,499" %></div></div><div class="field"><%= f.label :link_collection_id, "Collection" %><%= f.collection_select :link_collection_id, current_user.link_collections, :id, :name, { include_blank: "No collection" } %></div><div class="field"><%= f.label :description, "Why you love it (optional)" %><%= f.text_area :description, placeholder: "A short personal note..." %></div><div class="field"><label><%= f.check_box :featured %> Feature this recommendation</label></div><div class="form-actions"><%= f.submit class: "button pink" %><%= link_to "Cancel", dashboard_path, class: "button light" %></div><% end %>
