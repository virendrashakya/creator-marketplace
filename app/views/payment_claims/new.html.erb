<% content_for :title, "Pay #{@creator.name} | Wishful" %>
<% content_for :chrome, "fan" %>
<% summary = wf_purchase_summary(@purchasable) %>
<% currency = @purchasable.is_a?(MeetSlot) ? @purchasable.meet_offer.currency : (@purchasable.try(:currency) || "INR") %>
<% rupees = (@amount_cents.to_i / 100.0) %>
<% rupees_label = rupees == rupees.floor ? rupees.to_i : rupees.round(2) %>
<% upi = { pa: @creator.upi_id, pn: (@creator.upi_payee_name.presence || @creator.name), am: rupees_label, cu: currency, tn: summary[:title].to_s.truncate(28) }.compact_blank.to_query %>
<% gift = @purchasable.is_a?(WishlistItem) %>
<% utr_error = @payment_claim.errors[:utr].first %>

<div class="w-sheet-page">
  <% if summary[:image] %><%= image_tag summary[:image], alt: "", class: "w-sheet-bg" %><% end %>

  <div class="w-sheet">
    <%= link_to :back, class: "w-grabber", aria: { label: "Back" } do %><% end %>

    <div class="w-row" style="gap:12px;margin-top:16px">
      <% if summary[:image] %><%= image_tag summary[:image], alt: "", style: "width:48px;height:60px;border-radius:8px;object-fit:cover;flex:none" %><% end %>
      <div class="w-grow">
        <div style="font-size:15.5px;font-weight:800"><%= summary[:title] %></div>
        <div class="w-sub" style="font-size:12.5px;margin-top:2px"><%= summary[:meta] %></div>
      </div>
      <span style="font-size:22px;font-weight:800"><%= money(@amount_cents, currency) %></span>
    </div>

    <%= form_with model: @payment_claim,
          url: payment_claims_create_path(purchasable_type: params[:purchasable_type], purchasable_id: params[:purchasable_id]),
          method: :post, html: { style: "display:flex;flex-direction:column;flex:1", multipart: true } do |f| %>
      <%= hidden_field_tag :list, @list_id if @list_id %>
      <% if gift %><%= hidden_field_tag :amount, rupees_label %><% end %>

      <div class="w-step-label">Step 1 · Pay <%= @creator.first_name %></div>
      <% if @creator.upi_id.present? %>
        <div class="w-upi-apps">
          <a class="w-upi-app" href="tez://upi/pay?<%= upi %>">GPay</a>
          <a class="w-upi-app" href="phonepe://pay?<%= upi %>">PhonePe</a>
          <a class="w-upi-app" href="paytmmp://pay?<%= upi %>">Paytm</a>
          <a class="w-upi-app" href="upi://pay?<%= upi %>">BHIM</a>
        </div>
        <div class="w-upi-id">
          <div class="w-grow">
            <div class="w-sub" style="font-size:11.5px">Or pay to UPI ID</div>
            <div style="font-size:14px;font-weight:700;margin-top:2px;overflow-wrap:anywhere" translate="no"><%= @creator.upi_id %></div>
            <% if @creator.upi_payee_name.present? %><div class="w-dim" style="font-size:11.5px;margin-top:2px">Your app should show <strong style="color:var(--w-soft)"><%= @creator.upi_payee_name %></strong></div><% end %>
          </div>
          <div class="w-row" style="gap:8px">
            <button type="button" class="w-btn w-btn--sm" data-copy="<%= @creator.upi_id %>">Copy</button>
            <button type="button" class="w-btn w-btn--sm" data-toggle="#upi-qr" aria-expanded="false">QR</button>
          </div>
        </div>
        <div id="upi-qr" class="w-qr" hidden>
          <% if @creator.upi_qr.attached? %>
            <%= image_tag @creator.upi_qr, alt: "UPI QR code for #{@creator.name}" %>
          <% else %>
            <%= wf_qr_svg("upi://pay?#{upi}") %>
          <% end %>
        </div>
      <% elsif @creator.upi_qr.attached? %>
        <div class="w-qr"><%= image_tag @creator.upi_qr, alt: "UPI QR code for #{@creator.name}" %></div>
      <% end %>

      <% if gift %>
        <p class="w-sub" style="font-size:12px;margin:10px 0 0">You're gifting <strong style="color:var(--w-text)"><%= money(@amount_cents, currency) %></strong>. <%= link_to "Change amount", spoil_me_path(@creator.handle, item: @purchasable.id), class: "w-pink" %></p>
      <% end %>

      <div class="w-step-label">Step 2 · Paste your UTR</div>
      <%= f.text_field :utr, class: "w-input w-input--utr", style: "margin-top:10px", data: { utr: true },
            inputmode: "numeric", autocomplete: "off", spellcheck: false, autocapitalize: "characters", maxlength: 29,
            placeholder: "1234 5678 9012", translate: "no", value: @payment_claim.utr.to_s.scan(/.{1,4}/).join(" "),
            aria: { invalid: utr_error.present?, describedby: "utr-help" } %>
      <% if utr_error %>
        <div class="w-error" role="alert"><%= wf_icon(:alert, size: 16) %><span>This UTR <%= utr_error.delete_prefix("Utr ") %></span></div>
        <div class="w-card w-card--pad" style="margin-top:14px;font-size:13px;color:var(--w-soft);line-height:1.5">
          <strong style="color:var(--w-text)">Where to find it:</strong> GPay → payment → "UPI transaction ID". PhonePe → History → "UTR". Paytm → Passbook → "UPI Ref No."
        </div>
      <% else %>
        <div class="w-help" id="utr-help">12 digits. It's the "UPI Ref No." on your payment receipt.</div>
      <% end %>
      <% @payment_claim.errors.full_messages.reject { |m| m.start_with?("Utr") }.each do |m| %>
        <div class="w-error" role="alert"><%= wf_icon(:alert, size: 16) %><span><%= m %></span></div>
      <% end %>

      <label class="w-attach">
        <%= wf_icon(:image, size: 16) %>
        <span id="proof-label" data-empty="Add payment screenshot">Add payment screenshot</span>
        <span class="w-dim">· optional</span>
        <%= f.file_field :proof, accept: "image/*", data: { file_label: "#proof-label" } %>
      </label>

      <details style="margin-top:10px">
        <summary class="w-sub" style="font-size:12.5px;cursor:pointer">I paid a different amount<%= gift ? " / add a note" : "" %></summary>
        <div class="w-stack" style="margin-top:10px">
          <div class="w-input-wrap w-input-wrap--sm">
            <span class="w-prefix">₹</span>
            <input type="number" name="paid_rupees" min="1" step="1" inputmode="numeric" placeholder="<%= rupees_label %>" aria-label="Amount you actually paid, in rupees">
          </div>
          <%= f.text_area :note, class: "w-textarea", rows: 2, maxlength: 300, placeholder: "Add a note for #{@creator.first_name} (optional)" %>
        </div>
      </details>

      <div class="w-sheet-foot">
        <%= f.submit "Send for approval", class: "w-btn w-btn--pink w-btn--lg w-btn--block", data: { disable_with: "Sending…" } %>
        <div class="w-assure"><%= wf_icon(:shield, size: 14) %>Paid directly to <%= @creator.first_name %> · Wishful takes 0%</div>
      </div>
    <% end %>
  </div>
</div>
