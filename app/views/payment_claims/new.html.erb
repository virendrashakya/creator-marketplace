<% content_for :title, "Pay #{@creator.name} | Wishful" %>
<% content_for :head do %>
  <link rel="stylesheet" href="/assets/dashboard.css" data-turbo-track="reload">
<% end %>

<% currency = @payment_claim.currency.presence || "INR" %>
<% amount_in_rupees = (@amount_cents.to_i / 100.0).round %>
<% item_name = @purchasable.try(:title) || @purchasable.try(:label) || @purchasable.try(:name) || "Vault Unlock" %>
<% upi_params = {
     pa: @creator.upi_id,
     pn: @creator.upi_payee_name.presence || @creator.name,
     am: amount_in_rupees,
     cu: currency,
     tn: item_name.to_s.truncate(28)
   } %>
<% upi_deep_link = "upi://pay?#{upi_params.to_query}" %>

<div class="page" style="max-width: 560px; padding-top: 26px">
  <div class="receipt">
    <div class="receipt-head">
      <div class="receipt-eyebrow">You are paying</div>
      <div class="receipt-who"><%= @creator.name %></div>
      <div class="receipt-item"><%= item_name %></div>
      <div class="receipt-amount-row">
        <div>
          <div class="receipt-eyebrow">Amount due</div>
          <div class="receipt-amount" style="color: var(--p-accent); font-weight: 700;"><%= money(@amount_cents, currency) %></div>
        </div>
        <span class="badge badge--pending">Reviewed by <%= @creator.name.split.first %></span>
      </div>
    </div>

    <div class="receipt-pay">
      <% if @creator.upi_id.present? %>
        <div style="margin-bottom: 18px; width: 100%;">
          <a href="<%= upi_deep_link %>" class="btn btn--accent btn--block" style="display: flex; align-items: center; justify-content: center; gap: 8px; font-weight: 700; padding: 12px; font-size: 15px; border-radius: var(--r-md); box-shadow: 0 4px 14px rgba(233,30,99,0.3);">
            <span>⚡ Pay <%= money(@amount_cents, currency) %> in UPI App</span>
          </a>
          <div style="font-size: 11.5px; color: var(--p-sub); text-align: center; margin-top: 5px;">
            Tap to open Google Pay, PhonePe, Paytm, or CRED directly on your phone
          </div>
        </div>
      <% end %>

      <% if @creator.upi_qr.attached? %>
        <div>
          <div class="qr"><%= image_tag @creator.upi_qr, alt: "UPI QR code for #{@creator.name}", width: 380, height: 380 %></div>
          <div class="qr-hint">Scan in any UPI app</div>
        </div>
      <% end %>
      <div class="stack" style="flex: 1;">
        <% if @creator.upi_id.present? %>
          <div>
            <div class="pay-detail-label">UPI ID</div>
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 3px;">
              <div class="pay-detail" translate="no" style="font-size: 15px; font-weight: 600;"><%= @creator.upi_id %></div>
              <button type="button" class="btn btn--small btn--ghost" onclick="navigator.clipboard.writeText('<%= @creator.upi_id %>'); this.innerText = 'Copied! ✓'; setTimeout(() => this.innerText = 'Copy', 2000);" style="font-size: 12px; padding: 4px 10px;">
                Copy
              </button>
            </div>
          </div>
        <% end %>
        <% if @creator.upi_payee_name.present? %>
          <div>
            <div class="pay-detail-label">Payee name</div>
            <div style="font-size: 15px; font-weight: 500;"><%= @creator.upi_payee_name %></div>
            <small style="font-size: 11.5px; color: var(--p-sub);">This is the recipient name your UPI app will verify before you confirm.</small>
          </div>
        <% end %>
      </div>
    </div>

    <div style="padding: 0 24px; margin-bottom: 16px;">
      <div style="display: grid; gap: 8px;">
        <div style="padding: 10px 14px; background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.25); border-radius: var(--r-md); font-size: 12px; color: var(--p-ink); line-height: 1.45;">
          <strong style="color: #10b981;">🔒 100% Discreet &amp; Direct:</strong> Settles directly into <%= @creator.name.split.first %>'s account over UPI. No platform fees or brand statements on bank records.
        </div>
        <div style="padding: 10px 14px; background: rgba(255,92,138,0.08); border: 1px solid rgba(255,92,138,0.25); border-radius: var(--r-md); font-size: 12px; color: var(--p-ink); line-height: 1.45;">
          <strong style="color: var(--p-accent);">🛡️ Digital Watermark Security:</strong> Unlocked 4K media is dynamically watermarked with your fan ID (<%= current_user&.handle ? "@#{current_user.handle}" : "your account" %>). Redistribution or leaks are strictly tracked.
        </div>
      </div>
    </div>

    <div class="receipt-explain" style="border-top: 1px solid var(--p-line); padding-top: 16px;">
      Step 2: After completing payment in your UPI app, enter the 12-digit UTR from your receipt below.
      <%= @creator.name.split.first %> verifies it against their statement and unlocks your purchase.
    </div>

    <div class="receipt-foot">
      <%= form_with model: @payment_claim,
            url: payment_claims_create_path(purchasable_type: params[:purchasable_type], purchasable_id: params[:purchasable_id]),
            method: :post do |f| %>
        <%= render "shared/errors", record: @payment_claim %>

        <% if @purchasable.is_a?(WishlistItem) %>
          <div class="field">
            <%= f.label :claimed_amount_cents, "Amount sent (₹)" %>
            <div class="input-group input-group--money">
              <span class="addon addon--left" aria-hidden="true">₹</span>
              <input type="number" id="rupee_amount_input" min="1" step="1"
                     value="<%= amount_in_rupees %>" class="form-input"
                     oninput="document.getElementById('hidden_claimed_amount_cents').value = Math.round(parseFloat(this.value || 0) * 100);">
            </div>
            <%= f.hidden_field :claimed_amount_cents, id: "hidden_claimed_amount_cents", value: @amount_cents %>
            <small>You can spoil with any amount towards this item.</small>
          </div>
        <% else %>
          <div class="field" style="margin-bottom: 16px;">
            <label style="font-size: 13.5px; font-weight: 600; color: var(--p-ink); margin-bottom: 4px; display: block;">Payment Amount</label>
            <div style="font-size: 15px; font-weight: 700; color: var(--p-accent); padding: 10px 14px; background: var(--bg); border: 1px solid var(--p-line); border-radius: var(--r-md); display: flex; align-items: center; justify-content: space-between;">
              <span><%= money(@amount_cents, currency) %></span>
              <span class="badge badge--ok" style="font-size: 11px;">Fixed Price</span>
            </div>
            <%= f.hidden_field :claimed_amount_cents, value: @amount_cents %>
          </div>
        <% end %>

        <div class="field">
          <%= f.label :utr, "12-digit UPI Reference (UTR)" %>
          <%= f.text_field :utr, class: "utr-input", translate: "no",
                inputmode: "numeric", maxlength: 12, placeholder: "e.g. 402913887561",
                autocomplete: "off", spellcheck: false, autocapitalize: "off",
                aria: { describedby: "utr_hint" } %>
          <div class="utr-hint" id="utr_hint">Look for "UPI Ref No.", "UTR", or "Transaction ID" (12 digits) in Google Pay, PhonePe, or Paytm.</div>
        </div>

        <div class="field">
          <%= f.label :proof, "Screenshot, optional" %>
          <%= f.file_field :proof, accept: "image/*" %>
          <small>A payment screenshot speeds up verification. PNG or JPG.</small>
        </div>

        <div class="field">
          <%= f.label :note, "Private note for #{@creator.name.split.first}, optional" %>
          <%= f.text_area :note, rows: 2, maxlength: 300, placeholder: "Add a message or your preferred handle" %>
        </div>

        <div class="actions">
          <%= f.submit "Submit UTR for Instant Unlock", class: "btn btn--accent btn--big btn--block",
                data: { disable_with: "Sending your reference…" } %>
        </div>
      <% end %>
      <p class="muted" style="font-size: 12.5px; text-align: center; margin-top: 14px">
        ⚡ 100% Direct UPI &middot; Verified by <%= @creator.name.split.first %> &middot; Wishful never touches your money
      </p>
    </div>
  </div>
</div>
