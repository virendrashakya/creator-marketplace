<% content_for :title, "Pay #{@creator.name} | Wishful" %>
<% content_for :head do %>
  <link rel="stylesheet" href="/assets/dashboard.css">
<% end %>

<% currency = @payment_claim.currency.presence || "INR" %>
<div class="page" style="max-width: 560px; padding-top: 26px">
  <div class="receipt">
    <div class="receipt-head">
      <div class="receipt-eyebrow">You are paying</div>
      <div class="receipt-who"><%= @creator.name %></div>
      <div class="receipt-item"><%= @purchasable.try(:title) || @purchasable.try(:label) || @purchasable.try(:name) %></div>
      <div class="receipt-amount-row">
        <div>
          <div class="receipt-eyebrow">Amount due</div>
          <div class="receipt-amount"><%= money(@amount_cents, currency) %></div>
        </div>
        <span class="badge badge--pending">Reviewed by <%= @creator.name.split.first %></span>
      </div>
    </div>

    <div class="receipt-pay">
      <% if @creator.upi_qr.attached? %>
        <div>
          <div class="qr"><%= image_tag @creator.upi_qr, alt: "UPI QR code for #{@creator.name}", width: 380, height: 380 %></div>
          <div class="qr-hint">Scan in any UPI app</div>
        </div>
      <% end %>
      <div class="stack">
        <% if @creator.upi_id.present? %>
          <div>
            <div class="pay-detail-label">UPI ID</div>
            <div class="pay-detail" translate="no"><%= @creator.upi_id %></div>
          </div>
        <% end %>
        <% if @creator.upi_payee_name.present? %>
          <div>
            <div class="pay-detail-label">Payee name</div>
            <div style="font-size: 15px"><%= @creator.upi_payee_name %></div>
            <small>This is the name your UPI app will show. If it does not match, stop and tell us.</small>
          </div>
        <% end %>
      </div>
    </div>

    <div class="receipt-explain">
      Pay from your own UPI app, then enter the 12 digit UTR from your receipt below.
      <%= @creator.name.split.first %> checks it against their bank statement and unlocks your purchase, usually within a few hours.
    </div>

    <div class="receipt-foot">
      <%= form_with model: @payment_claim,
            url: payment_claims_create_path(purchasable_type: params[:purchasable_type], purchasable_id: params[:purchasable_id]),
            method: :post do |f| %>
        <%= render "shared/errors", record: @payment_claim %>

        <div class="field">
          <%= f.label :utr, "UTR number" %>
          <%= f.text_field :utr, class: "utr-input", translate: "no",
                inputmode: "numeric", maxlength: 12, placeholder: "402913887561",
                autocomplete: "off", spellcheck: false, autocapitalize: "off",
                aria: { describedby: "utr_hint" } %>
          <div class="utr-hint" id="utr_hint">Exactly 12 digits, from your UPI app receipt.</div>
        </div>

        <div class="field">
          <%= f.label :proof, "Screenshot, optional" %>
          <%= f.file_field :proof, accept: "image/*" %>
          <small>A screenshot usually gets you confirmed faster. PNG or JPG.</small>
        </div>

        <div class="field">
          <%= f.label :claimed_amount_cents, "Amount you actually sent" %>
          <div class="input-group input-group--money">
            <span class="addon addon--left" aria-hidden="true"><%= currency == "USD" ? "$" : "₹" %></span>
            <%= f.number_field :claimed_amount_cents, min: 1, step: 1, inputmode: "numeric",
                  aria: { describedby: "amount_hint" } %>
            <span class="addon addon--right"><%= minor_unit_hint(currency) %></span>
          </div>
          <small id="amount_hint">
            Pre-filled with the expected <%= money(@amount_cents, currency) %>, which is
            <%= number_with_delimiter(@amount_cents) %> <%= minor_unit_hint(currency) %>.
            Change it only if you sent a different amount.
          </small>
        </div>

        <div class="field">
          <%= f.label :note, "Note for #{@creator.name.split.first}, optional" %>
          <%= f.text_area :note, rows: 3, maxlength: 300, placeholder: "Anything they should know" %>
        </div>

        <div class="actions">
          <%= f.submit "Submit for review", class: "btn btn--accent btn--big btn--block",
                data: { disable_with: "Sending your reference…" } %>
        </div>
      <% end %>
      <p class="muted" style="font-size: 13px; text-align: center; margin-top: 12px">Nothing is charged here. Wishful never touches your money.</p>
    </div>
  </div>
</div>
