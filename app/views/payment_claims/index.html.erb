<% content_for :title, "Payments to confirm — Wishful" %>
<% content_for :head do %>
  <link rel="stylesheet" href="/assets/dashboard.css">
<% end %>

<div class="page">
  <div class="section-head">
    <h1>Payments to confirm</h1>
    <%= link_to "Back to dashboard", dashboard_path, class: "muted" %>
  </div>
  <p class="muted">Match each reference number against your bank statement before you approve. Approving opens access straight away.</p>

  <section class="panel">
    <% if @pending_claims.any? %>
      <% @pending_claims.each do |claim| %>
        <article class="claim">
          <div class="min0">
            <div class="claim-head">
              <span class="claim-who" translate="no">@<%= claim.claimant.handle %></span>
              <span class="claim-amount"><%= money(claim.amount_cents, claim.currency) %></span>
              <span class="state state--pending">Pending</span>
            </div>
            <div class="claim-what break">
              <%= claim.purchasable_type.underscore.humanize %>:
              <%= claim.purchasable.try(:title) || claim.purchasable.try(:label) || claim.purchasable.try(:name) || "item ##{claim.purchasable_id}" %>
              ·
              <time datetime="<%= claim.created_at.iso8601 %>" title="<%= l claim.created_at, format: :slot %>"><%= time_ago_in_words(claim.created_at) %> ago</time>
            </div>

            <div class="claim-ref">
              <span class="claim-ref-label">UTR</span>
              <span class="ref"><%= claim.utr.presence || "not provided" %></span>
            </div>

            <% if claim.amount_mismatch? %>
              <p class="claim-mismatch">
                They say they sent <%= money(claim.claimed_amount_cents, claim.currency) %>, but <%= money(claim.amount_cents, claim.currency) %> was due. Check your statement before approving.
              </p>
            <% end %>

            <% if claim.note.present? %>
              <p class="claim-note break">“<%= claim.note %>”</p>
            <% end %>

            <% if claim.proof.attached? %>
              <%= image_tag claim.proof, alt: "Payment screenshot from @#{claim.claimant.handle}", width: 400, height: 400, loading: "lazy", class: "claim-proof" %>
            <% end %>
          </div>

          <div class="claim-decide">
            <%= button_to "Approve", approve_payment_claim_path(claim), class: "button accent small",
                  form: { data: { turbo_confirm: "Confirm you received #{money(claim.amount_cents, claim.currency)} from @#{claim.claimant.handle}? This opens their access immediately." } } %>
            <%= button_to "Reject", reject_payment_claim_path(claim), class: "button light small",
                  form: { data: { turbo_confirm: "Reject this payment from @#{claim.claimant.handle}?" } } %>
          </div>
        </article>
      <% end %>
    <% else %>
      <div class="empty"><strong>Nothing waiting.</strong> New payments appear here as soon as someone submits one.</div>
    <% end %>
  </section>

  <% if @reviewed_claims.any? %>
    <section class="panel">
      <h2>Recently reviewed</h2>
      <% @reviewed_claims.each do |claim| %>
        <div class="row">
          <div class="min0">
            <div class="row-title" translate="no">@<%= claim.claimant.handle %></div>
            <div class="row-meta break">
              <%= money(claim.amount_cents, claim.currency) %> · <span class="ref"><%= claim.utr.presence || "no UTR" %></span>
            </div>
          </div>
          <span class="state <%= claim.approved? ? "state--confirmed" : "state--rejected" %>"><%= claim.status.capitalize %></span>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
