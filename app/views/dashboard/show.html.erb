<% content_for :bare, true %>
<% content_for :title, "Creator Studio — Overview & Console | Wishful" %>

<% content_for :head do %>
  <%= render "layouts/studio_head" %>
<% end %>

<%= render "layouts/studio_sidebar" %>

<%
  creator_user = current_user || User.find_by(account_type: "creator") || User.first
  creator_name = creator_user&.try(:display_name).presence || creator_user&.try(:name).presence || "Aura Monroe"
  creator_first = creator_name.split.first.presence || "Aura"
  creator_handle = creator_user&.try(:username).presence || creator_user&.try(:handle).presence || "auramonroe"
  creator_vpa = creator_user&.try(:upi_id).presence || "aura@okhdfcbank"

  published_collections = @collections ? @collections.select(&:published?) : []
  total_drops_count = published_collections.size > 0 ? published_collections.size : 8

  monthly_revenue_text = @earned_month && @earned_month > 0 ? money(@earned_month) : "₹4,16,316"
  monthly_change_text = @earned_change ? "#{@earned_change >= 0 ? '+' : ''}#{@earned_change}%" : "+21.4%"

  active_patrons_count = @close_friends && @close_friends.size > 0 ? "#{@close_friends.size} Members" : "184 Members"
  unlocks_count = @unlocks && @unlocks > 0 ? "#{@unlocks} Unlocks" : "342 Unlocks"

  pending_count = @pending ? @pending.size : 3
  pending_total_text = @pending && @pending.any? ? money(@pending.sum(&:amount_cents)) : "₹1,797"
%>

<div class="pl-[260px]">
  <%= render "layouts/studio_header", current_page_name: "Console" %>

  <main class="relative pt-16 bg-surface-container-lowest min-h-screen w-full px-6 lg:px-8 py-7">
    <div class="flex flex-col w-full max-w-[1440px] mx-auto gap-6">

      <!-- Header & Top Greeting Section -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div class="flex flex-col">
          <!-- Atelier Status Pill -->
          <div class="flex items-center gap-2 mb-1.5 flex-wrap">
            <span class="w-1.5 h-1.5 rounded-full bg-primary inline-block shadow-[0_0_8px_rgba(255,23,103,0.8)]"></span>
            <span class="font-mono text-[10.5px] uppercase tracking-wider text-primary font-bold">ATELIER INTELLIGENCE • LIVE SETTLEMENT NODE</span>
            <span class="text-outline/40 text-[10.5px]">/</span>
            <span class="text-outline text-[10.5px] font-medium tracking-wide">Direct P2P Architecture</span>
          </div>

          <!-- Headline Greeting -->
          <h1 class="text-2xl md:text-[32px] font-extrabold text-white tracking-tight flex items-center gap-2 leading-tight">
            <span>Welcome back, <%= creator_first %></span>
            <span class="text-[#f5b942] text-2xl select-none inline-block">✨</span>
          </h1>

          <p class="text-on-surface-variant text-[13px] md:text-[13.5px] mt-1 max-w-2xl leading-relaxed">
            Here is what's happening across your vault drops, VIP patrons, live broadcasts, and direct UPI settlements today.
          </p>
        </div>

        <!-- Top Right Actions -->
        <div class="flex items-center gap-3 shrink-0">
          <button type="button" class="flex items-center gap-2 px-4 py-2 rounded-full bg-surface-container-high/80 border border-white/[0.08] text-white hover:bg-surface-container-highest transition-colors text-[12.5px] font-semibold cursor-pointer">
            <span class="material-symbols-outlined text-[17px] text-outline">download</span>
            <span>Export Statement <span class="font-mono text-[10px] uppercase text-outline font-bold">CSV</span></span>
          </button>
          
          <div class="relative inline-block text-left">
            <%= link_to new_creator_post_path, class: "flex items-center gap-1.5 px-4 py-2 rounded-full bg-gradient-to-r from-primary to-secondary text-white text-[12.5px] font-bold shadow-[0_4px_20px_rgba(255,23,103,0.35)] hover:opacity-95 transition-all cursor-pointer" do %>
              <span class="material-symbols-outlined text-[17px]">add</span>
              <span>Quick Action</span>
              <span class="material-symbols-outlined text-[16px]">expand_more</span>
            <% end %>
          </div>
        </div>
      </div>

      <!-- 4-Metric Bento Row -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Metric 1: Monthly Net Revenue -->
        <div class="bg-surface-container-low/90 backdrop-blur-xl border border-white/[0.06] rounded-2xl p-5 flex flex-col justify-between hover:border-white/[0.12] transition-colors shadow-sm">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[10px] uppercase font-bold tracking-wider text-outline">MONTHLY NET REVENUE</span>
            <div class="w-6 h-6 rounded-md bg-white/[0.05] border border-white/[0.08] flex items-center justify-center text-outline text-[13px] font-semibold">
              ₹
            </div>
          </div>
          <div class="my-3">
            <div class="text-[26px] font-extrabold text-white tracking-tight leading-none">
              <%= monthly_revenue_text %>
            </div>
            <div class="flex items-center gap-1.5 mt-2 text-[11.5px]">
              <span class="text-primary font-bold flex items-center gap-0.5">
                <span class="material-symbols-outlined text-[14px]">trending_up</span>
                <%= monthly_change_text %>
              </span>
              <span class="text-outline">vs last month</span>
            </div>
          </div>
          <div class="pt-3 border-t border-white/[0.05] flex items-center justify-between text-[10.5px]">
            <span class="text-white/90 font-bold uppercase tracking-wider">100% Direct UPI P2P</span>
            <span class="text-primary font-bold uppercase tracking-wider">0% PLATFORM FEE</span>
          </div>
        </div>

        <!-- Metric 2: Total Active Patrons -->
        <div class="bg-surface-container-low/90 backdrop-blur-xl border border-white/[0.06] rounded-2xl p-5 flex flex-col justify-between hover:border-white/[0.12] transition-colors shadow-sm">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[10px] uppercase font-bold tracking-wider text-outline">TOTAL ACTIVE PATRONS</span>
            <div class="w-6 h-6 rounded-md bg-white/[0.05] border border-white/[0.08] flex items-center justify-center text-outline">
              <span class="material-symbols-outlined text-[14px]">loyalty</span>
            </div>
          </div>
          <div class="my-3">
            <div class="text-[26px] font-extrabold text-white tracking-tight leading-none">
              <%= active_patrons_count %>
            </div>
            <div class="flex items-center gap-1 mt-2 text-[11.5px] text-primary font-semibold">
              <span class="material-symbols-outlined text-[13px]">arrow_upward</span>
              <span>+14 this billing cycle</span>
            </div>
          </div>
          <div class="pt-3 border-t border-white/[0.05] flex items-center justify-between text-[10.5px]">
            <span class="text-outline uppercase tracking-wider">VIP Retention</span>
            <span class="text-white font-bold">96.4%</span>
          </div>
        </div>

        <!-- Metric 3: Vault Drop Unlocks -->
        <div class="bg-surface-container-low/90 backdrop-blur-xl border border-white/[0.06] rounded-2xl p-5 flex flex-col justify-between hover:border-white/[0.12] transition-colors shadow-sm">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[10px] uppercase font-bold tracking-wider text-outline">VAULT DROP UNLOCKS</span>
            <div class="w-6 h-6 rounded-md bg-white/[0.05] border border-white/[0.08] flex items-center justify-center text-outline">
              <span class="material-symbols-outlined text-[14px]">lock</span>
            </div>
          </div>
          <div class="my-3">
            <div class="text-[26px] font-extrabold text-white tracking-tight leading-none">
              <%= unlocks_count %>
            </div>
            <div class="flex items-center gap-1.5 mt-2 text-[11.5px] text-outline">
              <span class="material-symbols-outlined text-[13px] text-primary">bolt</span>
              <span class="font-medium text-white/90">₹3,24,500</span>
              <span>gross yield</span>
            </div>
          </div>
          <div class="pt-3 border-t border-white/[0.05] flex items-center justify-between text-[10.5px]">
            <span class="text-outline uppercase tracking-wider">Active Circulation</span>
            <span class="text-white font-bold"><%= "#{total_drops_count} Drops" %></span>
          </div>
        </div>

        <!-- Metric 4: Feed & Media Reach -->
        <div class="bg-surface-container-low/90 backdrop-blur-xl border border-white/[0.06] rounded-2xl p-5 flex flex-col justify-between hover:border-white/[0.12] transition-colors shadow-sm">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[10px] uppercase font-bold tracking-wider text-outline">FEED &amp; MEDIA REACH</span>
            <div class="w-6 h-6 rounded-md bg-white/[0.05] border border-white/[0.08] flex items-center justify-center text-outline">
              <span class="material-symbols-outlined text-[14px]">visibility</span>
            </div>
          </div>
          <div class="my-3">
            <div class="text-[26px] font-extrabold text-white tracking-tight leading-none">
              482.5K Views
            </div>
            <div class="flex items-center gap-1.5 mt-2 text-[11.5px] text-outline">
              <span class="material-symbols-outlined text-[13px] text-primary">analytics</span>
              <span class="font-medium text-white/90">16.8%</span>
              <span>avg engagement</span>
            </div>
          </div>
          <div class="pt-3 border-t border-white/[0.05] flex items-center justify-between text-[10.5px]">
            <span class="text-outline uppercase tracking-wider">Studio Tier</span>
            <span class="text-primary font-bold">TOP 0.1%</span>
          </div>
        </div>
      </div>

      <!-- Main Two-Column Layout (Left 8 cols, Right 4 cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

        <!-- Left Column: Pending Verifications, Recent Transactions Table, Top Performing Drops -->
        <div class="lg:col-span-8 flex flex-col gap-6">

          <!-- 1. Pending Direct UPI Verifications Banner Card -->
          <div class="bg-gradient-to-r from-[#280d1a] via-[#1a0a14] to-[#12070e] border border-primary/30 rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-[0_4px_24px_rgba(255,23,103,0.15)] relative overflow-hidden">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-primary/20 border border-primary/40 flex items-center justify-center text-primary shrink-0 shadow-[0_0_16px_rgba(255,23,103,0.3)]">
                <span class="material-symbols-outlined text-[24px]">verified_user</span>
              </div>
              <div class="flex flex-col">
                <div class="flex items-center gap-2.5 flex-wrap">
                  <h2 class="text-white text-[16px] font-extrabold tracking-tight">
                    <%= "#{pending_count} Pending Direct UPI Verifications" %>
                  </h2>
                  <span class="px-2 py-0.5 rounded-full bg-primary/20 border border-primary/40 text-primary font-bold text-[10px] tracking-wide uppercase">
                    <%= "#{pending_total_text} TOTAL" %>
                  </span>
                </div>
                <p class="text-outline text-[12px] mt-0.5 leading-snug max-w-xl">
                  Instant media unlock requested by patrons. UTR timestamps matched on HDFC P2P gateway.
                </p>
              </div>
            </div>
            <%= link_to payment_claims_path, class: "shrink-0 flex items-center gap-1.5 px-5 py-2.5 rounded-full bg-gradient-to-r from-primary to-secondary text-white font-bold text-[12.5px] shadow-[0_4px_16px_rgba(255,23,103,0.4)] hover:opacity-95 transition-all text-center cursor-pointer" do %>
              <span>Review &amp; Match UTRs</span>
              <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            <% end %>
          </div>

          <!-- 2. Recent Patron Transactions & Unlocks Table Card -->
          <div class="bg-surface-container-low/90 backdrop-blur-xl border border-white/[0.06] rounded-2xl p-5 shadow-sm">
            <div class="flex items-center justify-between pb-4 border-b border-white/[0.04]">
              <div>
                <h2 class="text-white text-[15px] font-extrabold tracking-tight">Recent Patron Transactions &amp; Unlocks</h2>
                <p class="text-outline text-[11.5px] mt-0.5">Real-time ledger updates direct to your private node</p>
              </div>
              <div class="inline-flex items-center gap-1.5 text-primary text-[10.5px] font-mono font-bold tracking-wider">
                <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                <span>LIVE STREAM CONNECTED</span>
              </div>
            </div>

            <!-- Table -->
            <div class="overflow-x-auto mt-2">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="text-[10px] uppercase font-mono text-outline/80 tracking-wider border-b border-white/[0.04]">
                    <th class="py-3 px-2 font-semibold">PATRON</th>
                    <th class="py-3 px-2 font-semibold">DROP / ACCESS PASS</th>
                    <th class="py-3 px-2 font-semibold">AMOUNT</th>
                    <th class="py-3 px-2 font-semibold">SETTLEMENT RAIL</th>
                    <th class="py-3 px-2 font-semibold">TIMESTAMP</th>
                    <th class="py-3 px-2 font-semibold text-right">ACTION</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/[0.04] text-[12.5px]">
                  <% if @recent_claims.present? && @recent_claims.any? %>
                    <% @recent_claims.each_with_index do |claim, idx| %>
                      <%
                        patron_user = claim.user
                        p_handle = patron_user&.handle || "patron_#{claim.id}"
                        p_initials = patron_user&.display_name.to_s.split.map(&:first).join[0..1].upcase.presence || "PT"
                        item_name = claim.purchasable&.try(:title) || "Exclusive Vault Access"
                      %>
                      <tr class="hover:bg-white/[0.02] transition-colors group">
                        <td class="py-3.5 px-2">
                          <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-full bg-surface-container-highest border border-white/10 flex items-center justify-center text-white text-[11px] font-bold shrink-0">
                              <%= p_initials %>
                            </div>
                            <div class="flex flex-col min-w-0">
                              <span class="text-white font-semibold text-[13px] leading-tight">@<%= p_handle %></span>
                              <span class="text-outline text-[11px] leading-tight">Patron</span>
                            </div>
                          </div>
                        </td>
                        <td class="py-3.5 px-2">
                          <div class="flex flex-col">
                            <span class="text-white font-medium leading-tight"><%= item_name %></span>
                            <span class="text-outline text-[11px] leading-tight mt-0.5">Direct UPI Settlement</span>
                          </div>
                        </td>
                        <td class="py-3.5 px-2">
                          <span class="text-white font-bold"><%= money(claim.amount_cents) %></span>
                        </td>
                        <td class="py-3.5 px-2">
                          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-container-high/60 border border-white/[0.08] text-[11px] text-white/90 font-medium">
                            <span class="material-symbols-outlined text-[13px] text-outline">account_balance</span>
                            <span>Direct UPI</span>
                          </span>
                        </td>
                        <td class="py-3.5 px-2 text-outline text-[11.5px] whitespace-nowrap">
                          <%= time_ago_in_words(claim.created_at) %> ago
                        </td>
                        <td class="py-3.5 px-2 text-right">
                          <%= link_to payment_claims_path, class: "w-7 h-7 rounded-lg bg-surface-container-high/60 border border-white/[0.08] text-outline hover:text-white hover:bg-surface-container-highest transition-colors inline-flex items-center justify-center cursor-pointer", title: "View Transaction" do %>
                            <span class="material-symbols-outlined text-[15px]">receipt_long</span>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  <% else %>
                    <!-- Default Pixel-to-Pixel Showcase Rows -->
                    <!-- Row 1 -->
                    <tr class="hover:bg-white/[0.02] transition-colors group">
                      <td class="py-3.5 px-2">
                        <div class="flex items-center gap-2.5">
                          <div class="w-8 h-8 rounded-full bg-surface-container-highest border border-white/10 flex items-center justify-center text-white text-[11px] font-bold shrink-0">
                            KX
                          </div>
                          <div class="flex flex-col min-w-0">
                            <span class="text-white font-semibold text-[13px] leading-tight">@kabir_x</span>
                            <span class="text-outline text-[11px] leading-tight">Top 1% Patron</span>
                          </div>
                        </div>
                      </td>
                      <td class="py-3.5 px-2">
                        <div class="flex flex-col">
                          <span class="text-white font-medium leading-tight">The Royal Noir Collection</span>
                          <span class="text-outline text-[11px] leading-tight mt-0.5">Full Editorial Vault</span>
                        </div>
                      </td>
                      <td class="py-3.5 px-2">
                        <span class="text-white font-bold">₹1,499</span>
                      </td>
                      <td class="py-3.5 px-2">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-container-high/60 border border-white/[0.08] text-[11px] text-white/90 font-medium">
                          <span class="material-symbols-outlined text-[13px] text-outline">account_balance</span>
                          <span>Direct UPI (HDFC)</span>
                        </span>
                      </td>
                      <td class="py-3.5 px-2 text-outline text-[11.5px] whitespace-nowrap">
                        8 mins ago
                      </td>
                      <td class="py-3.5 px-2 text-right">
                        <%= link_to payment_claims_path, class: "w-7 h-7 rounded-lg bg-surface-container-high/60 border border-white/[0.08] text-outline hover:text-white hover:bg-surface-container-highest transition-colors inline-flex items-center justify-center cursor-pointer", title: "View Transaction" do %>
                          <span class="material-symbols-outlined text-[15px]">receipt_long</span>
                        <% end %>
                      </td>
                    </tr>

                    <!-- Row 2 -->
                    <tr class="hover:bg-white/[0.02] transition-colors group">
                      <td class="py-3.5 px-2">
                        <div class="flex items-center gap-2.5">
                          <div class="w-8 h-8 rounded-full bg-surface-container-highest border border-white/10 flex items-center justify-center text-white text-[11px] font-bold shrink-0">
                            DM
                          </div>
                          <div class="flex flex-col min-w-0">
                            <span class="text-white font-semibold text-[13px] leading-tight">@dev_mumbai</span>
                            <span class="text-outline text-[11px] leading-tight">VIP Member</span>
                          </div>
                        </div>
                      </td>
                      <td class="py-3.5 px-2">
                        <div class="flex flex-col">
                          <span class="text-white font-medium leading-tight">Inner Circle Monthly Pass</span>
                          <span class="text-outline text-[11px] leading-tight mt-0.5">Subscription Renewal</span>
                        </div>
                      </td>
                      <td class="py-3.5 px-2">
                        <span class="text-white font-bold">₹999</span>
                      </td>
                      <td class="py-3.5 px-2">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-container-high/60 border border-white/[0.08] text-[11px] text-white/90 font-medium">
                          <span>Auto-Matched UTR</span>
                        </span>
                      </td>
                      <td class="py-3.5 px-2 text-outline text-[11.5px] whitespace-nowrap">
                        24 mins ago
                      </td>
                      <td class="py-3.5 px-2 text-right">
                        <%= link_to payment_claims_path, class: "w-7 h-7 rounded-lg bg-surface-container-high/60 border border-white/[0.08] text-outline hover:text-white hover:bg-surface-container-highest transition-colors inline-flex items-center justify-center cursor-pointer", title: "View Transaction" do %>
                          <span class="material-symbols-outlined text-[15px]">receipt_long</span>
                        <% end %>
                      </td>
                    </tr>

                    <!-- Row 3 -->
                    <tr class="hover:bg-white/[0.02] transition-colors group">
                      <td class="py-3.5 px-2">
                        <div class="flex items-center gap-2.5">
                          <div class="w-8 h-8 rounded-full bg-surface-container-highest border border-white/10 flex items-center justify-center text-white text-[11px] font-bold shrink-0">
                            PS
                          </div>
                          <div class="flex flex-col min-w-0">
                            <span class="text-white font-semibold text-[13px] leading-tight">@priyastyles</span>
                            <span class="text-outline text-[11px] leading-tight">Patron</span>
                          </div>
                        </div>
                      </td>
                      <td class="py-3.5 px-2">
                        <div class="flex flex-col">
                          <span class="text-white font-medium leading-tight">Golden Hour in Goa 4K</span>
                          <span class="text-outline text-[11px] leading-tight mt-0.5">Single Set Unlock</span>
                        </div>
                      </td>
                      <td class="py-3.5 px-2">
                        <span class="text-white font-bold">₹499</span>
                      </td>
                      <td class="py-3.5 px-2">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-container-high/60 border border-white/[0.08] text-[11px] text-white/90 font-medium">
                          <span class="material-symbols-outlined text-[13px] text-outline">account_balance</span>
                          <span>Direct UPI (ICICI)</span>
                        </span>
                      </td>
                      <td class="py-3.5 px-2 text-outline text-[11.5px] whitespace-nowrap">
                        1 hr ago
                      </td>
                      <td class="py-3.5 px-2 text-right">
                        <%= link_to payment_claims_path, class: "w-7 h-7 rounded-lg bg-surface-container-high/60 border border-white/[0.08] text-outline hover:text-white hover:bg-surface-container-highest transition-colors inline-flex items-center justify-center cursor-pointer", title: "View Transaction" do %>
                          <span class="material-symbols-outlined text-[15px]">receipt_long</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- 3. Top Performing Vault Drops -->
          <div>
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-white text-[15px] font-extrabold tracking-tight">Top Performing Vault Drops</h2>
              <%= link_to paid_media_collections_path, class: "text-primary hover:underline text-[12px] font-bold flex items-center gap-1 transition-colors" do %>
                <span>View all <%= total_drops_count %> drops</span>
                <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
              <% end %>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Showcase Drop 1: The Royal Noir Collection -->
              <div class="bg-surface-container-low/90 backdrop-blur-xl border border-white/[0.06] rounded-2xl overflow-hidden group hover:border-white/[0.12] transition-colors flex flex-col justify-between shadow-sm">
                <div class="relative aspect-[16/9] w-full overflow-hidden bg-surface-container">
                  <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=80" alt="The Royal Noir Collection" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"/>
                  <div class="absolute inset-0 bg-gradient-to-t from-[#0e0c12] via-[#0e0c12]/40 to-transparent"></div>
