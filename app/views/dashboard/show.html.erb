<% content_for :title, "Dashboard | Wishful" %>
<% content_for :head do %>
  <link rel="stylesheet" href="/assets/dashboard.css">
<% end %>

<div class="page dash">
  <div class="dash-head">
    <div class="min0">
      <h1>Hello, <%= current_user.name.to_s.split.first.presence || current_user.handle %></h1>
      <%= link_to "wishful.app/@#{current_user.handle}", profile_path(current_user.handle), class: "dash-link" %>
    </div>
    <%= link_to "View my page", profile_path(current_user.handle), class: "btn btn--light" %>
  </div>

  <% if @pending_claim_count.to_i.positive? %>
    <%= link_to payment_claims_path, class: "pending-alert" do %>
      <span class="actions" style="gap: 12px; flex-wrap: nowrap">
        <span class="pending-dot" aria-hidden="true"></span>
        <span class="min0">
          <span class="pending-title"><%= pluralize(@pending_claim_count, "payment") %> waiting for you</span>
          <span class="pending-sub">Check each reference against your bank statement before approving.</span>
        </span>
      </span>
      <span class="pending-cta">Review now</span>
    <% end %>
  <% end %>

  <section class="stats wf-stagger">
    <div class="stat">
      <div class="stat-label">Recommendations</div>
      <strong class="stat-value"><%= number_with_delimiter(@links.count) %></strong>
      <div class="stat-sub">across <%= pluralize(@collections.size, "collection") %></div>
    </div>
    <div class="stat">
      <div class="stat-label">Referral clicks</div>
      <strong class="stat-value"><%= number_with_delimiter(@total_clicks) %></strong>
      <div class="stat-sub">all time</div>
    </div>
    <div class="stat">
      <div class="stat-label">Approved on UPI</div>
      <strong class="stat-value"><%= money(@paid_media_revenue) %></strong>
      <div class="stat-sub">test mode</div>
    </div>
  </section>

  <%# Grouped by what the creator is adding, not by which form it opens. %>
  <section class="card">
    <div class="section-head">
      <h2>Add to your page</h2>
      <span class="muted" style="font-size: 13.5px">Pick what you are adding, not which form to open</span>
    </div>
    <div class="create-groups wf-stagger">
      <%#
        Grouped by where the money goes, because that is the only distinction
        that matters and the one creators were getting wrong. A recommendation
        sends a fan to a shop and you may earn a commission later; a wishlist
        item asks the fan to pay you. Same-shaped form, opposite direction of
        money, so the group heading says so out loud.
      %>
      <% [
        [ "Send people to a shop", "They pay the store. You may earn a commission.",
          [ [ "Recommendation", new_product_link_path ], [ "Collection", new_collection_path ] ] ],
        [ "Sell something of yours", "They pay you. Unlocked after you approve.",
          [ [ "Paid photo or video", new_paid_media_post_path ], [ "Media collection", new_paid_media_collection_path ], [ "Subscription plan", new_subscription_plan_path ] ] ],
        [ "Sell your time and reach", "They pay you for a slot or your contact.",
          [ [ "Meetup with slots", new_meet_offer_path ], [ "Contact reveal", new_contact_reveal_path ] ] ],
        [ "Ask to be gifted", "They pay you, and get nothing back but your thanks.",
          [ [ "Gift wishlist", new_wishlist_path ] ] ]
      ].each do |name, desc, actions| %>
        <div class="create-group">
          <div>
            <div class="create-group-name"><%= name %></div>
            <div class="create-group-desc"><%= desc %></div>
          </div>
          <div class="stack" style="gap: 6px">
            <% actions.each do |label, path| %>
              <%= link_to path, class: "create-action" do %>
                <span class="min0 break"><%= label %></span>
                <span class="plus" aria-hidden="true">+</span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Posting is the one create action with no money attached. Keeping it in
        the money grid implied it was a fifth way to earn. %>
    <div class="create-aside">
      <div class="min0">
        <div class="create-aside-name">Just posting something?</div>
        <div class="create-aside-desc">An update for your page. Nothing to pay, nothing to approve.</div>
      </div>
      <%= link_to new_creator_post_path, class: "create-action create-action--wide" do %>
        <span class="min0 break">Write a post</span>
        <span class="plus" aria-hidden="true">+</span>
      <% end %>
    </div>
  </section>

  <div class="section-head" style="margin-bottom: 0">
    <h2>What is on your page</h2>
  </div>

  <section class="managed wf-stagger">
    <%= render "dashboard/managed", name: "Recommendations", count: pluralize(@links.size, "live"),
          empty_title: "Nothing recommended yet",
          empty_body: "The thing you keep getting asked about. Start there.",
          empty_cta: "Add a recommendation", empty_path: new_product_link_path,
          rows: @links.map { |l| { title: l.title, badge: l.merchant.presence, badge_kind: "merchant",
                                   meta: pluralize(l.clicks_count, "click"), image: l.image_url,
                                   edit: edit_product_link_path(l), delete: product_link_path(l),
                                   confirm: "Delete “#{l.title}” from your page?" } } %>

    <%= render "dashboard/managed", name: "Collections", count: @collections.size.to_s,
          empty_title: "No collections yet",
          empty_body: "Group your links by theme so the page is easier to scan.",
          empty_cta: "Create a collection", empty_path: new_collection_path,
          rows: @collections.map { |c| { title: c.name, badge: "Live", badge_kind: "plain",
                                         meta: pluralize(c.product_links.size, "item"),
                                         edit: edit_collection_path(c), delete: collection_path(c),
                                         confirm: "Delete the collection “#{c.name}”? The links inside it stay." } } %>

    <%= render "dashboard/managed", name: "Paid media", count: @paid_posts.size.to_s,
          empty_title: "No paid media yet",
          empty_body: "Put a photo or video behind a one time unlock.",
          empty_cta: "Add paid media", empty_path: new_paid_media_post_path,
          rows: @paid_posts.map { |p| { title: p.title, badge: p.published? ? "Live" : "Hidden",
                                        badge_kind: p.published? ? "plain" : "hidden",
                                        meta: p.price_label,
                                        edit: edit_paid_media_post_path(p), delete: paid_media_post_path(p),
                                        confirm: "Delete “#{p.title}”?" } } %>

    <%= render "dashboard/managed", name: "Meetups and reveals",
          count: (@meet_offers.size + @contact_reveals.size).to_s,
          empty_title: "Nothing offered yet",
          empty_body: "Sell a meetup, or let people pay to reach you directly.",
          empty_cta: "Offer a meetup", empty_path: new_meet_offer_path,
          rows: @meet_offers.map { |o| { title: o.title, badge: o.published? ? "Live" : "Hidden",
                                         badge_kind: o.published? ? "plain" : "hidden",
                                         meta: pluralize(o.meet_slots.count { |s| !s.booked? && s.starts_at > Time.current }, "slot open"),
                                         edit: edit_meet_offer_path(o), delete: meet_offer_path(o),
                                         confirm: "Delete the meetup “#{o.title}”?" } } +
                @contact_reveals.map { |rv| { title: rv.label, badge: rv.published? ? "Live" : "Hidden",
                                         badge_kind: rv.published? ? "plain" : "hidden",
                                         meta: rv.price_label,
                                         edit: edit_contact_reveal_path(rv), delete: contact_reveal_path(rv),
                                         confirm: "Delete the contact reveal “#{rv.label}”?" } } %>

    <%= render "dashboard/managed", name: "Gift wishlists", count: current_user.wishlists.size.to_s,
          empty_title: "No wishlists yet",
          empty_body: "Let your audience fund something you are saving for.",
          empty_cta: "Start a wishlist", empty_path: new_wishlist_path,
          rows: current_user.wishlists.map { |w| { title: w.title, badge: w.published? ? "Live" : "Hidden",
                                         badge_kind: w.published? ? "plain" : "hidden",
                                         meta: pluralize(w.wishlist_items.size, "item"),
                                         edit: edit_wishlist_path(w), delete: nil,
                                         extra_label: "Add item", extra_path: new_wishlist_wishlist_item_path(w) } } %>

    <%= render "dashboard/managed", name: "Subscription plans", count: current_user.subscription_plans.size.to_s,
          empty_title: "No monthly plan yet",
          empty_body: "The people who buy every drop would rather pay you once a month. Start with one tier.",
          empty_cta: "Create a plan", empty_path: new_subscription_plan_path,
          rows: current_user.subscription_plans.map { |p| { title: p.name, badge: p.active? ? "Open" : "Paused",
                                         badge_kind: p.active? ? "plain" : "hidden",
                                         meta: "#{money(p.price_cents, p.currency)} a month",
                                         edit: edit_subscription_plan_path(p), delete: subscription_plan_path(p),
                                         confirm: "Delete the plan “#{p.name}”?" } } %>
  </section>

  <div class="actions">
    <%= link_to "Settings", creator_settings_path, class: "btn btn--light" %>
    <%= link_to "Blocked accounts", creator_blocks_path, class: "btn btn--light" %>
  </div>
</div>
