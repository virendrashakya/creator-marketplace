<% content_for :title, "Overview | Wishful Studio" %>
<% line, area = wf_chart_paths(@series) %>
<% mismatches = @pending.count(&:amount_mismatch?) %>

<div class="w-page-head">
  <div>
    <h1 class="w-page-title">Namaste, <%= current_user.first_name %></h1>
    <div class="w-page-lede"><%= Date.current.strftime("%A %-d %B") %> · here is what needs you today</div>
  </div>
  <div class="w-page-actions">
    <%= link_to "View my profile ↗", profile_path(current_user.handle), class: "w-btn w-btn--outline" %>
    <%= link_to "+ New post", creator_posts_path, class: "w-btn w-btn--pink" %>
  </div>
</div>

<% unless current_user.accepts_upi_manual? %>
  <%= link_to creator_settings_path, class: "w-card w-row", style: "padding:14px 16px;border-color:rgba(245,185,66,.45);background:var(--w-gold-bg)" do %>
    <%= wf_icon(:alert, size: 18, color: "#F5B942") %>
    <span class="w-grow" style="font-size:13.5px"><strong>Add your UPI ID</strong> so fans can pay you. Until then, unlock buttons are hidden.</span>
    <span class="w-btn w-btn--sm w-btn--gold">Add UPI</span>
  <% end %>
<% end %>

<div class="w-stats">
  <div class="w-stat">
    <div class="w-stat-label">Earned in <%= Date.current.strftime("%B") %></div>
    <div class="w-stat-value w-green"><%= money(@earned_month) %></div>
    <div class="w-stat-note"><%= @earned_change ? "#{@earned_change >= 0 ? "+" : ""}#{@earned_change}% vs #{1.month.ago.strftime("%B")}" : "Approved UPI payments" %></div>
  </div>
  <div class="w-stat">
    <div class="w-stat-label">Collection unlocks</div>
    <div class="w-stat-value"><%= @unlocks %></div>
    <div class="w-stat-note"><%= pluralize(@collections.count(&:published?), "collection") %></div>
  </div>
  <div class="w-stat">
    <div class="w-stat-label">Close Friends</div>
    <div class="w-stat-value"><%= @close_friends.size %></div>
    <div class="w-stat-note"><%= money(@close_friends_monthly) %> / month</div>
  </div>
  <div class="w-stat">
    <div class="w-stat-label">Link list opens</div>
    <div class="w-stat-value"><%= number_with_delimiter(@list_opens) %></div>
    <div class="w-stat-note"><%= number_with_delimiter(@list_taps) %> taps</div>
  </div>
</div>

<div style="display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:16px" class="w-two-col">
  <div class="w-card" style="overflow:hidden">
    <div class="w-card-head">
      <span class="w-card-title">Earnings</span>
      <nav class="w-seg" aria-label="Range">
        <% DashboardController::RANGES.each_key do |key| %>
          <%= link_to key.upcase, dashboard_path(range: key), aria: { current: (@range == key ? "page" : nil) } %>
        <% end %>
      </nav>
    </div>
    <div class="w-row" style="padding:0 18px 10px;gap:18px;font-size:12px;color:var(--w-sub);flex-wrap:wrap">
      <% { "Collections" => "#E0306A", "Close Friends" => "#F5B942", "Tips & gifts" => "#4ADE80", "Calls & access" => "#60A5FA" }.each do |label, color| %>
        <% next if label == "Calls & access" && @breakdown[label].zero? %>
        <span><span style="color:<%= color %>">●</span> <%= label %> <%= money(@breakdown[label]) %></span>
      <% end %>
    </div>
    <svg viewBox="0 0 600 120" preserveAspectRatio="none" style="width:100%;height:120px;display:block" role="img"
         aria-label="Approved earnings per day over the last <%= @series.size %> days, <%= money(@series.sum) %> in total">
      <path d="<%= area %>" fill="rgba(224,48,106,.12)"></path>
      <path d="<%= line %>" fill="none" stroke="#E0306A" stroke-width="2.5" vector-effect="non-scaling-stroke"></path>
    </svg>
  </div>

  <div class="w-card">
    <div class="w-card-head" style="padding-bottom:10px">
      <span class="w-card-title">Needs you</span>
      <% needs = [ @pending.any?, @next_live, @unread.positive?, @next_call ].count(&:itself) %>
      <span class="w-sub" style="font-size:12px"><%= needs %></span>
    </div>
    <% if @pending.any? %>
      <div class="w-needs-row">
        <span class="w-dot"></span>
        <div class="w-grow"><div style="font-size:14px;font-weight:700"><%= pluralize(@pending.size, "payment") %> to confirm</div>
          <div class="w-sub" style="font-size:12px;margin-top:2px"><%= money(@pending.sum(&:amount_cents)) %><%= " · #{pluralize(mismatches, "amount mismatch", plural: "amount mismatches")}" if mismatches.positive? %></div></div>
        <%= link_to "Review", payment_claims_path, class: "w-btn w-btn--sm w-btn--pink" %>
      </div>
    <% end %>
    <% if @next_live %>
      <div class="w-needs-row">
        <span class="w-dot w-dot--gold"></span>
        <div class="w-grow"><div style="font-size:14px;font-weight:700"><%= @next_live.live? ? "You're live now" : "Live #{@next_live.scheduled_for.to_date == Date.current ? "tonight" : @next_live.scheduled_for.strftime("%a")} #{wf_time(@next_live.scheduled_for)}" %></div>
          <div class="w-sub w-ellipsis" style="font-size:12px;margin-top:2px"><%= @next_live.title %><%= " · Close Friends" if @next_live.members_only? %></div></div>
        <%= link_to "Studio", studio_live_session_path(@next_live), class: "w-btn w-btn--sm" %>
      </div>
    <% end %>
    <% if @unread.positive? %>
      <div class="w-needs-row">
        <span class="w-dot w-dot--blue"></span>
        <div class="w-grow"><div style="font-size:14px;font-weight:700"><%= pluralize(@unread, "unread message") %></div>
          <div class="w-sub" style="font-size:12px;margin-top:2px"><%= @unread_cf.positive? ? "#{@unread_cf} from Close Friends" : "From fans" %></div></div>
        <%= link_to "Open", conversations_path, class: "w-btn w-btn--sm" %>
      </div>
    <% end %>
    <% if @next_call %>
      <div class="w-needs-row">
        <span class="w-dot w-dot--green"></span>
        <div class="w-grow"><div style="font-size:14px;font-weight:700">Video call · <%= @next_call.meet_slot.starts_at.to_date == Date.current ? wf_time(@next_call.meet_slot.starts_at) : @next_call.meet_slot.starts_at.strftime("%a %-l:%M %p") %></div>
          <div class="w-sub" style="font-size:12px;margin-top:2px">@<%= @next_call.attendee.handle %> · <%= money(@next_call.amount_cents, @next_call.currency) %> confirmed</div></div>
        <%= link_to "Details", schedule_path, class: "w-btn w-btn--sm" %>
      </div>
    <% end %>
    <% if needs.zero? %>
      <div class="w-needs-row w-sub" style="font-size:13px">You're all caught up.</div>
    <% end %>
  </div>
</div>

<% if @top_collections.any? %>
  <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px" class="w-two-col">
    <% @top_collections.each do |c| %>
      <%= link_to edit_paid_media_collection_path(c), class: "w-list-row", style: "border-radius:12px" do %>
        <% if (src = wf_collection_cover_src(c)) %><%= image_tag src, alt: "", class: "w-thumb", style: "width:40px;height:50px;border-radius:8px" %><% end %>
        <div style="min-width:0">
          <div class="w-ellipsis" style="font-size:13px;font-weight:800"><%= c.title %></div>
          <div class="w-sub" style="font-size:11.5px"><%= c.unlocks_count %> unlocks · <%= money(c.revenue_cents, c.currency) %></div>
        </div>
      <% end %>
    <% end %>
  </div>
<% elsif @collections.empty? %>
  <%= link_to new_paid_media_collection_path, class: "w-card w-row", style: "padding:18px" do %>
    <span class="w-big-icon w-big-icon--pink" style="width:44px;height:44px;font-size:20px"><%= wf_icon(:stack) %></span>
    <div class="w-grow"><div style="font-size:15px;font-weight:800">Create your first collection</div><div class="w-sub" style="font-size:13px">Pick a cover everyone can see, add the photos fans unlock, set a price.</div></div>
    <span class="w-btn w-btn--pink">+ New collection</span>
  <% end %>
<% end %>
