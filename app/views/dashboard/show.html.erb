<% content_for :title, "Dashboard | Wishful" %>
<% content_for :head do %>
  <link rel="stylesheet" href="/assets/dashboard.css" data-turbo-track="reload">
<% end %>

<div class="page dash">
  <div class="dash-head">
    <div class="min0">
      <h1>Hello, <%= current_user.name.to_s.split.first.presence || current_user.handle %></h1>
      <%= link_to "wishful.app/@#{current_user.handle}", profile_path(current_user.handle), class: "dash-link" %>
    </div>
    <%# The three things a creator reaches for from here. Go live and Inbox
        carry state, because "you are already live" and "someone is waiting"
        are both things you should see before you click. %>
    <div class="dash-head-actions">
      <% if @airing_live %>
        <%= link_to live_session_path(@airing_live), class: "btn btn--accent dash-live-on" do %>
          <span class="dash-live-dot" aria-hidden="true"></span>You are live
        <% end %>
      <% else %>
        <%= link_to "Go live", new_live_session_path, class: "btn btn--accent" %>
      <% end %>

      <%# Calendar: where the creator has to be, meets and lives together.
          Icon-only with a label for screen readers, because three worded
          buttons plus this one would wrap the header on a laptop. %>
      <%= link_to schedule_path, class: "btn btn--light dash-icon-btn",
            title: "Schedule", aria: { label: "Schedule" } do %>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="dash-icon">
          <rect x="3.5" y="5" width="17" height="15.5" rx="2.5"
                stroke="currentColor" stroke-width="1.6"/>
          <path d="M3.5 9.5h17" stroke="currentColor" stroke-width="1.6"/>
          <path d="M8 3.5v3M16 3.5v3" stroke="currentColor" stroke-width="1.6"
                stroke-linecap="round"/>
        </svg>
      <% end %>

      <%= link_to conversations_path, class: "btn btn--light dash-inbox" do %>
        Inbox<% if @unread_messages.to_i.positive? %><span class="dash-inbox-badge"><%= @unread_messages %></span><% end %>
      <% end %>

      <%= link_to "View my page", profile_path(current_user.handle), class: "btn btn--light" %>
    </div>
  </div>

  <% if @pending_claim_count.to_i.positive? %>
    <%= link_to payment_claims_path, class: "pending-alert" do %>
      <span class="actions" style="gap: 12px; flex-wrap: nowrap">
        <span class="pending-dot" aria-hidden="true"></span>
        <span class="min0">
          <span class="pending-title"><%= pluralize(@pending_claim_count, "payment") %> waiting for you</span>
          <span class="pending-sub">Check each reference against your bank statement before approving.</span>
        </span>
      </span>
      <span class="pending-cta">Review now</span>
    <% end %>
  <% end %>

  <section class="stats wf-stagger">
    <div class="stat">
      <div class="stat-label">Approved on UPI</div>
      <strong class="stat-value" style="color: var(--p-accent);"><%= money(@paid_media_revenue) %></strong>
      <div class="stat-sub">100% direct settlement</div>
    </div>
    <div class="stat">
      <div class="stat-label">The Vault &amp; VIP Drops</div>
      <strong class="stat-value"><%= pluralize(@paid_posts.size, "drop") %></strong>
      <div class="stat-sub"><%= pluralize(current_user.subscription_plans.size, "VIP tier") %> live</div>
    </div>
    <div class="stat">
      <div class="stat-label">Curated Outfits &amp; Fits</div>
      <strong class="stat-value"><%= number_with_delimiter(@links.count) %></strong>
      <div class="stat-sub"><%= number_with_delimiter(@total_clicks) %> referral taps</div>
    </div>
  </section>

  <%# Grouped by what the creator is adding, not by which form it opens. %>
  <section class="card">
    <div class="section-head">
      <h2>Add to your page</h2>
      <span class="muted" style="font-size: 13.5px">Pick what you are adding, not which form to open</span>
    </div>
    <div class="create-groups wf-stagger">
      <% [
        [ "The Vault & VIP Drops", "They pay you over UPI. Unlocked after you approve.",
          [ [ "Locked photo or video", new_paid_media_post_path ], [ "Exclusive bundle / set", new_paid_media_collection_path ], [ "Close Friends / VIP Pass", new_subscription_plan_path ] ] ],
        [ "VIP Channels & 1:1 Access", "They pay for private Telegram / WhatsApp access or your time.",
          [ [ "Private channel reveal", new_contact_reveal_path ], [ "1:1 Call or meetup", new_meet_offer_path ] ] ],
        [ "Spoil Me Wishlists", "Fans chip in for shoot outfits, travel, or gear over UPI.",
          [ [ "Gift wishlist", new_wishlist_path ] ] ],
        [ "Recommendations & Outfits", "Your favorite looks, beauty, or gear with referral links.",
          [ [ "Product link", new_product_link_path ], [ "Curated collection", new_collection_path ] ] ]
      ].each do |name, desc, actions| %>
        <div class="create-group">
          <div>
            <div class="create-group-name"><%= name %></div>
            <div class="create-group-desc"><%= desc %></div>
          </div>
          <div class="stack" style="gap: 6px">
            <% actions.each do |label, path| %>
              <%= link_to path, class: "create-action" do %>
                <span class="min0 break"><%= label %></span>
                <span class="plus" aria-hidden="true">+</span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Posting is the one create action with no money attached. %>
    <div class="create-aside">
      <div class="min0">
        <div class="create-aside-name">Just posting an update?</div>
        <div class="create-aside-desc">A free update for your community feed. Nothing to pay, nothing to approve.</div>
      </div>
      <%= link_to new_creator_post_path, class: "create-action create-action--wide" do %>
        <span class="min0 break">Write a post</span>
        <span class="plus" aria-hidden="true">+</span>
      <% end %>
    </div>
  </section>

  <div class="section-head" style="margin-bottom: 0">
    <h2>What is on your page</h2>
  </div>

  <section class="managed wf-stagger">
    <%= render "dashboard/managed", name: "The Vault & Drops", count: @paid_posts.size.to_s,
          empty_title: "The Vault is empty",
          empty_body: "Put an exclusive 4K photo set or video behind a one-time UPI unlock.",
          empty_cta: "Add Vault drop", empty_path: new_paid_media_post_path,
          rows: @paid_posts.map { |p| { title: p.title, badge: p.published? ? "Live" : "Hidden",
                                        badge_kind: p.published? ? "plain" : "hidden",
                                        meta: p.price_label,
                                        edit: edit_paid_media_post_path(p), delete: paid_media_post_path(p),
                                        confirm: "Delete “#{p.title}”?" } } %>

    <%= render "dashboard/managed", name: "Close Friends & VIP Passes", count: current_user.subscription_plans.size.to_s,
          empty_title: "No VIP tiers yet",
          empty_body: "Fans who unlock every drop want an all-access monthly pass. Start with one tier.",
          empty_cta: "Create VIP plan", empty_path: new_subscription_plan_path,
          rows: current_user.subscription_plans.map { |p| { title: p.name, badge: p.active? ? "Open" : "Paused",
                                         badge_kind: p.active? ? "plain" : "hidden",
                                         meta: "#{money(p.price_cents, p.currency)} a month",
                                         edit: edit_subscription_plan_path(p), delete: subscription_plan_path(p),
                                         confirm: "Delete the plan “#{p.name}”?" } } %>

    <%= render "dashboard/managed", name: "Spoil Me Wishlists", count: current_user.wishlists.size.to_s,
          empty_title: "No wishlists active",
          empty_body: "Let fans spoil you with shoot looks, gifts, or luxury treats over UPI.",
          empty_cta: "Start a wishlist", empty_path: new_wishlist_path,
          rows: current_user.wishlists.map { |w| { title: w.title, badge: w.published? ? "Live" : "Hidden",
                                         badge_kind: w.published? ? "plain" : "hidden",
                                         meta: pluralize(w.wishlist_items.size, "gift"),
                                         edit: edit_wishlist_path(w), delete: nil,
                                         extra_label: "Add item", extra_path: new_wishlist_wishlist_item_path(w) } } %>

    <%= render "dashboard/managed", name: "VIP Channels & 1:1 Calls",
          count: (@meet_offers.size + @contact_reveals.size).to_s,
          empty_title: "No direct access offered",
          empty_body: "Offer 1:1 video calls or let fans pay to unlock your private VIP Telegram/WhatsApp.",
          empty_cta: "Offer a video call", empty_path: new_meet_offer_path,
          rows: @meet_offers.map { |o| { title: o.title, badge: o.published? ? "Live" : "Hidden",
                                         badge_kind: o.published? ? "plain" : "hidden",
                                         meta: pluralize(o.meet_slots.count { |s| !s.booked? && s.starts_at > Time.current }, "slot open"),
                                         edit: edit_meet_offer_path(o), delete: meet_offer_path(o),
                                         confirm: "Delete the meetup “#{o.title}”?" } } +
                @contact_reveals.map { |rv| { title: rv.label, badge: rv.published? ? "Live" : "Hidden",
                                         badge_kind: rv.published? ? "plain" : "hidden",
                                         meta: rv.price_label,
                                         edit: edit_contact_reveal_path(rv), delete: contact_reveal_path(rv),
                                         confirm: "Delete the contact reveal “#{rv.label}”?" } } %>

    <%= render "dashboard/managed", name: "Curated Fits & Recommendations", count: pluralize(@links.size, "live"),
          empty_title: "No fits curated yet",
          empty_body: "Add your favorite outfits, lingerie, or beauty essentials with affiliate links.",
          empty_cta: "Add a recommendation", empty_path: new_product_link_path,
          rows: @links.map { |l| { title: l.title, badge: l.merchant.presence, badge_kind: "merchant",
                                   meta: pluralize(l.clicks_count, "click"), image: l.image_url,
                                   edit: edit_product_link_path(l), delete: product_link_path(l),
                                   confirm: "Delete “#{l.title}” from your page?" } } %>

    <%= render "dashboard/managed", name: "Look Collections", count: @collections.size.to_s,
          empty_title: "No collections yet",
          empty_body: "Group your looks by shoot or vibe so the page is easy to browse.",
          empty_cta: "Create a collection", empty_path: new_collection_path,
          rows: @collections.map { |c| { title: c.name, badge: "Live", badge_kind: "plain",
                                         meta: pluralize(c.product_links.size, "look"),
                                         edit: edit_collection_path(c), delete: collection_path(c),
                                         confirm: "Delete the collection “#{c.name}”? The links inside it stay." } } %>
  </section>

  <div class="actions">
    <%= link_to "Settings", creator_settings_path, class: "btn btn--light" %>
    <%= link_to "Blocked accounts", creator_blocks_path, class: "btn btn--light" %>
  </div>
</div>
