<% content_for :title, "Dashboard | Wishful" %>
<% content_for :head do %>
  <link rel="stylesheet" href="/assets/dashboard.css">
<% end %>

<div class="page">
  <div class="dash-head">
    <div class="min0">
      <h1>Your page</h1>
      <p class="muted">Live at <%= link_to "@#{current_user.handle}", profile_path(current_user.handle) %></p>
    </div>
    <div class="actions actions--end">
      <% if @pending_claim_count.to_i.positive? %>
        <%= link_to payment_claims_path, class: "button accent" do %>
          Confirm <%= pluralize(@pending_claim_count, "payment") %>
        <% end %>
      <% end %>
      <%= link_to "Add recommendation", new_product_link_path, class: @pending_claim_count.to_i.positive? ? "button light" : "button accent" %>
      <details class="dash-menu">
        <summary>Add something else</summary>
        <div class="dash-menu-panel">
          <%= link_to "Write a post", new_creator_post_path %>
          <%= link_to "Sell a photo or video", new_paid_media_post_path %>
          <%= link_to "Make a media collection", new_paid_media_collection_path %>
          <%= link_to "Offer a meetup", new_meet_offer_path %>
          <%= link_to "Sell your contact details", new_contact_reveal_path %>
          <%= link_to "Start a gifting wishlist", new_wishlist_path %>
          <%= link_to "Create a subscription plan", new_subscription_plan_path %>
          <%= link_to "Group links into a collection", new_collection_path %>
          <%= link_to "Edit profile and payments", creator_settings_path %>
          <%= link_to "Blocked accounts", creator_blocks_path %>
          <% unless @pending_claim_count.to_i.positive? %>
            <%= link_to "Payments to confirm", payment_claims_path %>
          <% end %>
        </div>
      </details>
    </div>
  </div>

  <section class="stats">
    <div>
      <strong class="stat-value"><%= number_with_delimiter(@links.count) %></strong>
      <span class="stat-label">recommendations</span>
    </div>
    <div>
      <strong class="stat-value"><%= number_with_delimiter(@total_clicks) %></strong>
      <span class="stat-label">link clicks</span>
    </div>
    <div>
      <strong class="stat-value"><%= money(@paid_media_revenue) %></strong>
      <span class="stat-label">paid media, test mode</span>
    </div>
  </section>

  <div class="dash-grid">
    <div class="panel">
      <div class="section-head">
        <h2>Collections</h2>
        <%= link_to "New", new_collection_path, class: "muted" %>
      </div>
      <% if @collections.any? %>
        <% @collections.each do |collection| %>
          <div class="row">
            <div class="min0">
              <div class="row-title break"><%= collection.name %></div>
              <div class="row-meta"><%= pluralize(collection.product_links.size, "link") %></div>
            </div>
            <div class="actions actions--end">
              <%= link_to "Edit", edit_collection_path(collection) %>
              <%= button_to "Delete", collection_path(collection), method: :delete, class: "danger", form: { data: { turbo_confirm: "Delete the collection “#{collection.name}”? The links inside it stay on your page." } } %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="empty"><strong>No collections yet.</strong> Group your links by theme so your page is easier to scan.</div>
      <% end %>
    </div>

    <div class="panel">
      <div class="section-head">
        <h2>Recommendations</h2>
        <%= link_to "Add", new_product_link_path, class: "muted" %>
      </div>
      <% if @links.any? %>
        <% @links.each do |link| %>
          <div class="row row--media">
            <% if link.image_url.present? %>
              <%= image_tag link.image_url, class: "row-thumb", alt: "", width: 104, height: 104, loading: "lazy" %>
            <% else %>
              <span class="row-thumb" aria-hidden="true"></span>
            <% end %>
            <div class="min0">
              <div class="row-title break">
                <% if link.featured? %><span class="vouch-flag" aria-hidden="true"></span><span class="visually-hidden">Featured. </span><% end %>
                <%= link.title %>
              </div>
              <div class="row-meta break">
                <%= [ link.merchant.presence, link.price.presence, link.link_collection&.name, pluralize(link.clicks_count, "click") ].compact.join(" · ") %>
              </div>
            </div>
            <div class="actions actions--end">
              <%= link_to "Edit", edit_product_link_path(link) %>
              <%= button_to "Delete", product_link_path(link), method: :delete, class: "danger", form: { data: { turbo_confirm: "Delete “#{link.title}” from your page?" } } %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="empty"><strong>Nothing here yet.</strong> <%= link_to "Add the first thing you recommend", new_product_link_path %>.</div>
      <% end %>
    </div>
  </div>

  <section class="panel">
    <div class="section-head">
      <h2>Subscription plans</h2>
      <%= link_to "New plan", new_subscription_plan_path, class: "muted" %>
    </div>
    <% if current_user.subscription_plans.any? %>
      <% current_user.subscription_plans.each do |plan| %>
        <div class="row">
          <div class="min0">
            <div class="row-title break"><%= plan.name %></div>
            <div class="row-meta"><%= money(plan.price_cents, plan.currency) %> a month<%= plan.active? ? "" : " · paused" %></div>
          </div>
          <div class="actions actions--end">
            <%= link_to "Edit", edit_subscription_plan_path(plan) %>
            <%= button_to "Delete", subscription_plan_path(plan), method: :delete, class: "danger", form: { data: { turbo_confirm: "Delete the plan “#{plan.name}”?" } } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="empty"><strong>No plans yet.</strong> Charge monthly, then attach media or collections to the plan.</div>
    <% end %>
  </section>

  <section class="panel">
    <div class="section-head">
      <h2>Gifting wishlists</h2>
      <%= link_to "New wishlist", new_wishlist_path, class: "muted" %>
    </div>
    <% if current_user.wishlists.any? %>
      <% current_user.wishlists.each do |wishlist| %>
        <div class="row">
          <div class="min0">
            <div class="row-title break"><%= wishlist.title %></div>
            <div class="row-meta"><%= pluralize(wishlist.wishlist_items.size, "gift") %></div>
          </div>
          <div class="actions actions--end">
            <%= link_to "Add item", new_wishlist_wishlist_item_path(wishlist) %>
            <%= link_to "Edit", edit_wishlist_path(wishlist) %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="empty"><strong>No wishlists yet.</strong> Let your audience fund something you are saving for.</div>
    <% end %>
  </section>

  <section class="panel">
    <div class="section-head">
      <h2>Meetups and contact</h2>
      <span class="actions">
        <%= link_to "New meetup", new_meet_offer_path, class: "muted" %>
        <%= link_to "New contact reveal", new_contact_reveal_path, class: "muted" %>
      </span>
    </div>
    <% if @meet_offers.any? || @contact_reveals.any? %>
      <% @meet_offers.each do |offer| %>
        <div class="row">
          <div class="min0">
            <div class="row-title break"><%= offer.title %></div>
            <div class="row-meta">
              <%= offer.price_label %> · <%= pluralize(offer.meet_slots.count { |slot| !slot.booked? && slot.starts_at > Time.current }, "open slot") %>
              <% unless offer.published? %><span class="state state--hidden">Hidden</span><% end %>
            </div>
          </div>
          <div class="actions actions--end">
            <%= link_to "Edit", edit_meet_offer_path(offer) %>
            <%= button_to "Delete", meet_offer_path(offer), method: :delete, class: "danger", form: { data: { turbo_confirm: "Delete the meetup “#{offer.title}”?" } } %>
          </div>
        </div>
      <% end %>
      <% @contact_reveals.each do |reveal| %>
        <div class="row">
          <div class="min0">
            <div class="row-title break"><%= reveal.label %></div>
            <div class="row-meta">
              <%= reveal.price_label %> · <%= pluralize(reveal.access_purchases.count { |p| p.status == "paid" }, "reveal") %>
              <% unless reveal.published? %><span class="state state--hidden">Hidden</span><% end %>
            </div>
          </div>
          <div class="actions actions--end">
            <%= link_to "Edit", edit_contact_reveal_path(reveal) %>
            <%= button_to "Delete", contact_reveal_path(reveal), method: :delete, class: "danger", form: { data: { turbo_confirm: "Delete the contact reveal “#{reveal.label}”?" } } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="empty"><strong>Nothing offered yet.</strong> Sell a meetup, or let people pay to reach you directly.</div>
    <% end %>
  </section>

  <section class="panel">
    <div class="section-head">
      <h2>Paid media</h2>
      <%= link_to "New paid post", new_paid_media_post_path, class: "muted" %>
    </div>
    <% if @paid_posts.any? %>
      <% @paid_posts.each do |post| %>
        <div class="row row--media">
          <span class="row-thumb" aria-hidden="true"></span>
          <div class="min0">
            <div class="row-title break"><%= post.title %></div>
            <div class="row-meta">
              <%= post.price_label %> · <%= pluralize(post.media_purchases.count { |p| p.status == "paid" }, "unlock") %>
              <% unless post.published? %><span class="state state--hidden">Hidden</span><% end %>
            </div>
          </div>
          <div class="actions actions--end">
            <%= link_to "Edit", edit_paid_media_post_path(post) %>
            <%= button_to "Delete", paid_media_post_path(post), method: :delete, class: "danger", form: { data: { turbo_confirm: "Delete “#{post.title}”?" } } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="empty"><strong>No paid media yet.</strong> Put a photo or video behind a one-time unlock.</div>
    <% end %>
  </section>
</div>
