<style>
  .dash-head { display:flex; justify-content:space-between; align-items:start; gap:20px; margin:15px 0 30px }.dash-head h1 { margin:0; letter-spacing:-2px }.stats { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:34px }.stat { padding:18px; border:1px solid var(--line); border-radius:14px; background:#fff }.stat strong { display:block; font-size:27px; letter-spacing:-1px }.stat span { color:var(--muted); font-size:13px }.dash-grid { display:grid; grid-template-columns:1fr 1.8fr; gap:34px }.panel h2 { font-size:19px; margin:0 0 14px }.collection-row,.link-row { border:1px solid var(--line); border-radius:12px; margin-bottom:9px; padding:13px; background:#fff }.collection-row { display:flex; align-items:center; justify-content:space-between }.link-row { display:grid; grid-template-columns:52px 1fr auto; align-items:center; gap:12px }.link-thumb { width:52px; height:52px; border-radius:9px; object-fit:cover; background:#f2eef0 }.link-title { font-weight:750; font-size:14px }.link-meta { color:var(--muted); font-size:12px; margin-top:3px }.link-actions { display:flex; gap:10px; font-size:13px } .empty { padding:19px; color:var(--muted); background:#faf8f6; border-radius:12px; font-size:14px } @media(max-width:720px){.dash-grid{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.link-row{grid-template-columns:45px 1fr}.link-actions{grid-column:2}}
</style>
<main class="page">
  <div class="dash-head"><div><h1>Good to see you, <%= current_user.name.split.first %>.</h1><p class="muted">Your public page: <%= link_to "@#{current_user.handle}", profile_path(current_user.handle) %></p></div><span><%= link_to "New post", new_creator_post_path, class: "button light" %> <%= link_to "Edit creator profile", creator_settings_path, class: "button light" %> <%= link_to "Create gifting wishlist", new_wishlist_path, class: "button light" %> <%= link_to "Subscription plans", new_subscription_plan_path, class: "button light" %> <%= link_to "+ Paid media", new_paid_media_post_path, class: "button light" %> <%= link_to "+ Add recommendation", new_product_link_path, class: "button pink" %></span></div>
  <section class="stats"><div class="stat"><strong><%= @links.count %></strong><span>recommendations</span></div><div class="stat"><strong><%= @total_clicks %></strong><span>link clicks</span></div><div class="stat"><strong>₹<%= format("%.2f", @paid_media_revenue / 100.0).sub(/\.00\z/, "") %></strong><span>test-mode paid media</span></div></section>
  <section class="dash-grid"><div class="panel"><div style="display:flex;justify-content:space-between;align-items:center"><h2>Collections</h2><%= link_to "+ New", new_collection_path, class: "muted" %></div><% if @collections.any? %><% @collections.each do |collection| %><div class="collection-row"><div><strong><%= collection.name %></strong><span class="muted"> · <%= collection.product_links.size %></span></div><span class="link-actions"><%= link_to "Edit", edit_collection_path(collection) %> <%= button_to "Delete", collection_path(collection), method: :delete, class: "danger", data: { turbo_confirm: "Remove this collection? Links will remain." } %></span></div><% end %><% else %><div class="empty">Group your recommendations by a theme or category.</div><% end %></div>
  <div class="panel"><h2>Your recommendations</h2><% if @links.any? %><% @links.each do |link| %><div class="link-row"><% if link.image_url.present? %><%= image_tag link.image_url, class: "link-thumb", alt: "" %><% else %><div class="link-thumb"></div><% end %><div><div class="link-title"><%= "★ " if link.featured? %><%= link.title %></div><div class="link-meta"><%= [link.merchant, link.price, link.link_collection&.name, pluralize(link.clicks_count, "click")].compact.join(" · ") %></div></div><div class="link-actions"><%= link_to "Edit", edit_product_link_path(link) %><%= button_to "Delete", product_link_path(link), method: :delete, class: "danger", data: { turbo_confirm: "Delete this recommendation?" } %></div></div><% end %><% else %><div class="empty">Your page is waiting for its first find. <%= link_to "Add one now", new_product_link_path %>.</div><% end %></div></section>
</main>
<main class="page" style="padding-top:0"><section class="panel"><div style="display:flex;justify-content:space-between;align-items:center"><h2>Subscription plans</h2><%= link_to "+ New plan", new_subscription_plan_path, class: "muted" %></div><% if current_user.subscription_plans.any? %><% current_user.subscription_plans.each do |plan| %><div class="collection-row"><div><strong><%= plan.name %></strong><span class="muted"> · ₹<%= plan.price_cents / 100.0 %> / month</span></div><span class="link-actions"><%= link_to "Edit", edit_subscription_plan_path(plan) %><%= button_to "Delete", subscription_plan_path(plan), method: :delete, class: "danger", data: { turbo_confirm: "Delete this plan?" } %></span></div><% end %><% else %><div class="empty">Create a monthly plan, then attach it to exclusive media or collections.</div><% end %></section></main>
<main class="page" style="padding-top:0"><section class="panel"><div style="display:flex;justify-content:space-between;align-items:center"><h2>Gifting wishlists</h2><%= link_to "+ New wishlist", new_wishlist_path, class: "muted" %></div><% if current_user.wishlists.any? %><% current_user.wishlists.each do |wishlist| %><div class="collection-row"><div><strong><%= wishlist.title %></strong><span class="muted"> · <%= wishlist.wishlist_items.count %> gift items</span></div><span class="link-actions"><%= link_to "Add item", new_wishlist_wishlist_item_path(wishlist) %><%= link_to "Edit", edit_wishlist_path(wishlist) %></span></div><% end %><% else %><div class="empty">Add products your followers can fund or gift.</div><% end %></section></main>
<main class="page" style="padding-top:0"><section class="panel"><div style="display:flex;justify-content:space-between;align-items:center"><h2>Paid media</h2><%= link_to "+ New paid post", new_paid_media_post_path, class: "muted" %></div><% if @paid_posts.any? %><% @paid_posts.each do |post| %><div class="link-row"><div class="link-thumb"></div><div><div class="link-title"><%= post.title %></div><div class="link-meta"><%= post.price_label %> · <%= pluralize(post.media_purchases.paid.count, "unlock") %> · <%= post.published? ? "Published" : "Hidden" %></div></div><div class="link-actions"><%= link_to "Edit", edit_paid_media_post_path(post) %><%= button_to "Delete", paid_media_post_path(post), method: :delete, class: "danger", data: { turbo_confirm: "Delete this paid post?" } %></div></div><% end %><% else %><div class="empty">Sell private photos or videos directly from your page.</div><% end %></section></main>
