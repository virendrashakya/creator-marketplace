<%# 3l. The live room, full-screen. The page is public so a link from a
    story opens; the stream and chat render only past watchable_by?. %>
<% content_for :title, "#{@live.title} | #{@creator.name} | Wishful" %>
<% content_for :description, @live.members_only? ? "A Close Friends live from #{@creator.name}." : @live.description.to_s.truncate(150) %>
<% content_for :chrome, "fan" %>
<% if @watchable %>
  <% content_for :head do %>
    <script src="/assets/js/actioncable.js" data-turbo-track="reload" defer></script>
    <script src="/assets/js/chat.js" data-turbo-track="reload" defer></script>
  <% end %>
<% end %>
<% backdrop = wf_banner_src(@creator) %>
<% streaming = @watchable && @live.live? && @live.playback_url.present? %>

<div class="w-live">
  <% if streaming %>
    <iframe src="<%= @live.playback_url %>" title="<%= @live.title %>" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen referrerpolicy="no-referrer"></iframe>
  <% elsif backdrop %>
    <%= image_tag backdrop, alt: "", style: (@watchable ? nil : "filter:blur(18px) brightness(.5);transform:scale(1.1)") %>
  <% end %>

  <div class="w-live-top">
    <%= link_to profile_path(@creator.handle), class: "w-row", style: "gap:8px;min-width:0;flex:1" do %>
      <% if (src = wf_avatar_src(@creator)) %><%= image_tag src, alt: "", style: "width:34px;height:34px;border-radius:999px;object-fit:cover;border:2px solid var(--w-pink)" %><% end %>
      <div style="min-width:0">
        <div class="w-ellipsis" style="font-size:13.5px;font-weight:800"><%= @creator.handle %></div>
        <div style="font-size:11px;font-weight:700" class="<%= @live.members_only? ? "w-gold" : "w-sub" %>"><%= @live.members_only? ? "★ Close Friends" : "Open to everyone" %></div>
      </div>
    <% end %>
    <% if @live.live? %><span class="w-pill w-pill--live">LIVE</span><% end %>
    <span class="w-glass-tag"><%= pluralize(@live.live_messages_count, "message") %></span>
    <%= link_to profile_path(@creator.handle), class: "w-icon-btn", aria: { label: "Leave" } do %><%= wf_icon(:close) %><% end %>
  </div>

  <% gate = nil %>
  <% if !@watchable %>
    <% gate = :members %>
  <% elsif @live.scheduled? %>
    <% gate = :soon %>
  <% elsif @live.ended? %>
    <% gate = :ended %>
  <% elsif @live.live? && @live.playback_url.blank? %>
    <% gate = :setup %>
  <% end %>

  <% if gate %>
    <div style="position:absolute;left:16px;right:16px;top:34%;z-index:3;max-width:420px;margin:0 auto" class="w-card w-card--r16 w-center">
      <div style="padding:20px;gap:8px" class="w-center">
        <% case gate when :members %>
          <div class="w-big-icon w-big-icon--pink" style="background:var(--w-gold-bg);color:var(--w-gold)"><%= wf_icon(:lock) %></div>
          <div style="font-size:18px;font-weight:800;margin-top:6px"><%= @live.title %></div>
          <div class="w-sub" style="font-size:13.5px;line-height:1.5">This live is for <%= @creator.first_name %>'s Close Friends.</div>
          <% if @block_reason == :sign_in %>
            <%= link_to "Sign in", sign_in_path(return_to: request.fullpath), class: "w-btn w-btn--pink w-btn--block", style: "margin-top:10px" %>
          <% end %>
          <% plan = @plans.first %>
          <% if plan %>
            <%= link_to "Join Close Friends · #{plan.price_label}/mo", close_friends_path(@creator.handle, plan: plan.id), class: "w-btn w-btn--gold w-btn--block", style: "margin-top:6px" %>
          <% end %>
        <% when :soon %>
          <div class="w-big-icon w-big-icon--pink"><%= wf_icon(:clock) %></div>
          <div style="font-size:18px;font-weight:800;margin-top:6px"><%= @live.title %></div>
          <div class="w-sub" style="font-size:13.5px">Starts <%= @live.scheduled_for.strftime("%a %-d %b") %>, <%= wf_time(@live.scheduled_for) %></div>
          <% if current_user == @creator %>
            <%= link_to "Open your studio", studio_live_session_path(@live), class: "w-btn w-btn--pink w-btn--block", style: "margin-top:10px" %>
          <% else %>
            <button type="button" class="w-btn w-btn--light w-btn--block" style="margin-top:10px" data-push-enable>Remind me</button>
          <% end %>
        <% when :ended %>
          <div style="font-size:18px;font-weight:800">This live has ended</div>
          <div class="w-sub" style="font-size:13.5px"><%= @messages.any? ? "The chat from it is below." : "See what else #{@creator.first_name} has on." %></div>
          <%= link_to "Back to @#{@creator.handle}", profile_path(@creator.handle), class: "w-btn w-btn--block", style: "margin-top:10px" %>
        <% when :setup %>
          <div style="font-size:18px;font-weight:800"><%= @creator.first_name %> is setting up</div>
          <div class="w-sub" style="font-size:13.5px">The chat is open.</div>
          <% if current_user == @creator %><%= link_to "Add your stream link", edit_live_session_path(@live), class: "w-btn w-btn--pink w-btn--block", style: "margin-top:10px" %><% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @watchable %>
    <section class="w-live-bottom" style="left:14px;right:14px;margin:0 auto" data-chat="live" data-live-id="<%= @live.id %>" data-me="<%= current_user&.id %>" data-creator-id="<%= @creator.id %>">
      <div style="align-self:flex-start;background:rgba(14,14,16,.55);backdrop-filter:blur(10px);padding:6px 10px;border-radius:8px;font-size:12px;font-weight:700"><%= @live.title %></div>
      <ol class="w-live-log" data-chat-log>
        <% @messages.each do |m| %>
          <li class="chat-line<%= " is-creator" if m.user_id == @creator.id %>" data-id="<%= m.id %>"><span class="chat-who" translate="no"><%= m.user.handle %></span><span class="chat-body"><%= m.body %></span></li>
        <% end %>
      </ol>
      <% if @can_chat %>
        <%= form_with url: live_session_live_messages_path(@live), method: :post, local: true, class: "w-row", style: "gap:8px;margin-top:6px", data: { chat_form: true } do %>
          <label class="w-sr" for="chat_body">Say something</label>
          <input type="text" name="body" id="chat_body" maxlength="300" placeholder="Say something…" autocomplete="off" class="chat-input w-live-input">
          <% if @creator.wishlists.any? && current_user != @creator %>
            <%= link_to "₹ Gift", spoil_me_path(@creator.handle), class: "w-btn w-btn--gold", style: "height:44px;border-radius:999px" %>
          <% else %>
            <button type="submit" class="w-chat-send" aria-label="Send"><%= wf_icon(:send) %></button>
          <% end %>
        <% end %>
      <% elsif @live.live? && current_user.nil? %>
        <%= link_to "Sign in to chat", sign_in_path(return_to: request.fullpath), class: "w-btn w-btn--block" %>
      <% end %>
    </section>
  <% end %>
</div>
