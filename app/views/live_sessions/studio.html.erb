<%# 9a. The creator's live studio, phone-first. Wishful plays the stream
    from a broadcast link (Instagram, YouTube, OBS...), so the camera itself
    lives in that app; this screen is the room: going live, the chat, and
    who may speak. %>
<% content_for :title, "Studio: #{@live.title} | Wishful" %>
<% content_for :chrome, "fan" %>
<% content_for :head do %>
  <script src="/assets/js/actioncable.js" data-turbo-track="reload" defer></script>
  <script src="/assets/js/chat.js" data-turbo-track="reload" defer></script>
<% end %>
<% backdrop = wf_banner_src(current_user) %>
<% elapsed = @live.started_at && ((Time.current - @live.started_at) / 60).floor %>

<div class="w-live">
  <% if @live.playback_url.present? %>
    <iframe src="<%= @live.playback_url %>" title="Your stream" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen referrerpolicy="no-referrer"></iframe>
  <% elsif backdrop %>
    <%= image_tag backdrop, alt: "" %>
  <% end %>

  <div class="w-live-top" style="flex-wrap:wrap">
    <%= link_to schedule_path, class: "w-icon-btn", aria: { label: "Back to Book" } do %><%= wf_icon(:back) %><% end %>
    <% if @live.live? %>
      <span class="w-pill w-pill--live">LIVE<%= " · #{elapsed / 60}:#{(elapsed % 60).to_s.rjust(2, "0")}" if elapsed %></span>
    <% elsif @live.scheduled? %>
      <span class="w-glass-tag"><%= @live.scheduled_for.strftime("%a %-d %b, %-l:%M %p") %></span>
    <% else %>
      <span class="w-glass-tag">Ended</span>
    <% end %>
    <span class="w-glass-tag"><%= pluralize(@live.live_messages_count, "message") %></span>
    <span style="margin-left:auto">
      <% if @live.scheduled? %>
        <%= button_to "Go live", start_live_session_path(@live), class: "w-btn w-btn--pink w-btn--sm", form: { class: "w-inline" } %>
      <% elsif @live.live? %>
        <%= button_to "End", finish_live_session_path(@live), class: "w-btn w-btn--sm", style: "background:rgba(14,14,16,.55)",
              form: { class: "w-inline", data: { turbo_confirm: "End the live for everyone watching?" } } %>
      <% end %>
    </span>
    <div class="w-row" style="width:100%;gap:8px;margin-top:4px">
      <% if @live.members_only? %><span class="w-pill w-pill--gold-outline" style="height:30px;padding:0 10px">★ Close Friends only</span><% else %><span class="w-glass-tag">Open to everyone</span><% end %>
    </div>
  </div>

  <section class="w-live-bottom" style="left:14px;right:14px;margin:0 auto;bottom:calc(30px + env(safe-area-inset-bottom))" data-chat="live" data-live-id="<%= @live.id %>" data-me="<%= current_user.id %>" data-creator-id="<%= @live.user_id %>">
    <% if @live.playback_url.blank? %>
      <div class="w-glass-note"><%= wf_icon(:video) %><span>No stream link yet. <%= link_to "Add the player link", edit_live_session_path(@live), class: "w-pink" %> from the app you broadcast with.</span></div>
    <% end %>
    <ol class="w-live-log" data-chat-log>
      <% @messages.each do |m| %>
        <li class="chat-line<%= " is-creator" if m.user_id == @live.user_id %>" data-id="<%= m.id %>"><span class="chat-who" translate="no"><%= m.user.handle %></span><span class="chat-body"><%= m.body %></span></li>
      <% end %>
    </ol>
    <% if @live.chattable_by?(current_user) %>
      <%= form_with url: live_session_live_messages_path(@live), method: :post, local: true, class: "w-row", style: "gap:8px", data: { chat_form: true } do %>
        <label class="w-sr" for="chat_body">Reply</label>
        <input type="text" name="body" id="chat_body" maxlength="300" placeholder="Answer someone…" autocomplete="off" class="chat-input w-live-input">
        <button type="submit" class="w-chat-send" aria-label="Send"><%= wf_icon(:send) %></button>
      <% end %>
    <% end %>
    <div class="w-row" style="gap:8px;margin-top:6px">
      <button type="button" class="w-glass-btn" data-toggle="#live-controls" aria-expanded="false">Controls</button>
      <button type="button" class="w-glass-btn" data-copy="<%= @viewer_url %>" data-copied="Link copied">Share link</button>
      <%= link_to "Viewer page", live_session_path(@live), class: "w-glass-btn" %>
    </div>
  </section>

  <div id="live-controls" hidden style="position:absolute;left:0;right:0;bottom:0;z-index:5;max-width:480px;margin:0 auto">
    <%= form_with model: @live, url: live_session_path(@live), method: :patch, local: true,
          html: { class: "w-stack", style: "background:#141417;border-radius:24px 24px 0 0;padding:10px 18px calc(22px + env(safe-area-inset-bottom));gap:14px" } do |f| %>
      <button type="button" class="w-grabber" data-toggle="#live-controls" aria-label="Close controls" style="border:0;cursor:pointer"></button>
      <%= hidden_field_tag :from, "studio" %>
      <div style="font-size:16px;font-weight:800">Room controls</div>
      <% [ [ :chat_enabled, "Chat is on", "Off makes the room listen-only." ],
           [ :chat_members_only, "Only Close Friends may write", (@live.members_only? ? "Everyone here is already in Close Friends." : "Anyone can watch; only members speak.") ],
           [ :unlisted, "Unlisted", "Off your profile. The link still works." ],
           [ :keep_chat_after, "Keep the chat afterwards", "Off and the transcript disappears when you end." ] ].each do |attr, title, hint| %>
        <div class="w-switch-row">
          <span><span style="display:block;font-weight:700"><%= title %></span><span class="w-sub" style="font-size:12px"><%= hint %></span></span>
          <span class="w-switch"><%= f.hidden_field attr, value: "0", id: nil %><%= f.check_box attr, { include_hidden: false, aria: { label: title } } %><span></span></span>
        </div>
      <% end %>
      <label class="w-field"><span class="w-label">Who can watch</span>
        <%= f.select :access, [ [ "Close Friends (active members)", "members" ], [ "Anyone (a free live)", "public" ] ], {}, class: "w-select" %>
      </label>
      <div class="w-row" style="gap:8px">
        <%= f.submit "Save controls", class: "w-btn w-btn--pink w-grow" %>
        <%= link_to "All settings", edit_live_session_path(@live), class: "w-btn" %>
      </div>
    <% end %>
  </div>
</div>
