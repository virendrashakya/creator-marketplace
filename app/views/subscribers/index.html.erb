    <script>
      (function() {
        const tabBtns = document.querySelectorAll('.patron-tab-btn');
        const rows = document.querySelectorAll('.patron-row');
        const searchInput = document.getElementById('patronSearchInput');
        const countDisplay = document.getElementById('patronResultsCount');

        function applyPatronFilters() {
          const activeBtn = document.querySelector('.patron-tab-btn.bg-surface-container-high');
          const filter = activeBtn ? activeBtn.getAttribute('data-filter') : 'all';
          const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

          let visibleCount = 0;
          rows.forEach(row => {
            const status = row.getAttribute('data-status');
            const searchData = row.getAttribute('data-search') || '';

            const matchesTab = (filter === 'all') || (status === filter);
            const matchesQuery = !query || searchData.includes(query);

            if (matchesTab && matchesQuery) {
              row.style.display = '';
              visibleCount++;
            } else {
              row.style.display = 'none';
            }
          });

          if (countDisplay) {
            countDisplay.innerHTML = `Showing <span class="text-on-surface font-medium">${visibleCount}</span> of ${rows.length} patrons`;
          }
        }

        tabBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            tabBtns.forEach(b => {
              b.classList.remove('bg-surface-container-high', 'text-on-surface', 'shadow-sm');
              b.classList.add('text-on-surface-variant');
            });
            btn.classList.add('bg-surface-container-high', 'text-on-surface', 'shadow-sm');
            btn.classList.remove('text-on-surface-variant');
            applyPatronFilters();
          });
        });

        if (searchInput) {
          searchInput.addEventListener('input', applyPatronFilters);
        }
      })();
    </script>
