<%= form_with model: @subscription_plan do |f| %>
  <%= render "shared/errors", record: @subscription_plan %>
  <div class="field"><%= f.label :name, "Plan name" %><%= f.text_field :name, placeholder: "Inner circle" %></div>
  <div class="field"><%= f.label :description %><%= f.text_area :description, placeholder: "What members get every month" %></div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><div class="field"><%= f.label :price_cents, "Monthly price (paise/cents)" %><%= f.number_field :price_cents, min: 1, placeholder: "49900" %></div><div class="field"><%= f.label :currency %><%= f.select :currency, [["INR", "INR"], ["USD", "USD"]] %></div></div>
  <div class="field"><label><%= f.check_box :active %> Available for new subscribers</label></div>
  <div class="form-actions"><%= f.submit class: "button pink" %><%= link_to "Cancel", dashboard_path, class: "button light" %></div>
<% end %>
