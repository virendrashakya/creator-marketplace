<% content_for :title, "Your Feed | Wishful" %>
<% content_for :chrome, "fan" %>

<div class="w-phone">
  <%# Top Bar %>
  <header class="w-topbar">
    <div class="w-row" style="gap:10px">
      <span class="w-brand-mark">W</span>
      <span style="font-size:18px;font-weight:800;letter-spacing:-.02em">Wishful</span>
    </div>
    <div class="w-topbar-actions">
      <%= render "shared/theme_switch", compact: true %>
      <%= link_to conversations_path, class: "w-icon-btn", aria: { label: "Messages" } do %>
        <%= wf_icon(:chat) %>
      <% end %>
      <%= link_to unlocks_path, class: "w-icon-btn", aria: { label: "Your Unlocks" } do %>
        <%= wf_icon(:lock) %>
      <% end %>
    </div>
  </header>

  <%# Tab Strip: Feed vs Discover %>
  <div class="w-row" style="padding:10px 16px;gap:12px;border-bottom:1px solid var(--w-lines)">
    <%= link_to feed_path, class: "w-pill", style: "background:var(--w-pink);color:#fff;font-weight:700;padding:6px 14px;border-radius:20px;font-size:13px;text-decoration:none" do %>
      Following
    <% end %>
    <%= link_to discover_path, class: "w-pill", style: "background:var(--w-raised);color:var(--w-text-muted);font-weight:600;padding:6px 14px;border-radius:20px;font-size:13px;text-decoration:none" do %>
      Explore & Drops
    <% end %>
  </div>

  <% if @feed_items.any? %>
    <%# Following Stories / Creators row %>
    <% followed_creators = @feed_items.map(&:creator).compact.uniq { |c| c.id } %>
    <% if followed_creators.any? %>
      <div style="padding:14px 16px 6px;overflow-x:auto;display:flex;gap:14px;scrollbar-width:none">
        <% followed_creators.each do |creator| %>
          <%= link_to profile_path(creator.handle), class: "w-center", style: "flex-direction:column;gap:5px;flex:none;text-decoration:none;color:var(--w-text)" do %>
            <div style="position:relative;padding:2px;border-radius:50%;background:linear-gradient(135deg, #E0306A, #F5B942)">
              <%= wf_avatar(creator, size: 52, css: "w-border") %>
            </div>
            <span style="font-size:11px;font-weight:600;max-width:56px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
              <%= creator.handle %>
            </span>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# Timeline Feed Stream %>
    <div class="w-stack" style="padding:12px 16px 80px;gap:20px">
      <% @feed_items.each do |item| %>
        <% creator = item.creator %>
        <% target = item.target %>
        <% next unless creator && target %>

        <article class="w-card" style="background:var(--w-cards);border:1px solid var(--w-lines);border-radius:16px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.25)" data-feed-item-id="<%= item.id %>">
          <%# Creator Header %>
          <div class="w-row" style="padding:12px 14px;gap:10px;justify-content:space-between">
            <div class="w-row" style="gap:10px">
              <%= link_to profile_path(creator.handle), style: "text-decoration:none" do %>
                <%= wf_avatar(creator, size: 40) %>
              <% end %>
              <div>
                <div class="w-row" style="gap:4px">
                  <%= link_to profile_path(creator.handle), style: "font-size:14px;font-weight:800;color:var(--w-text);text-decoration:none" do %>
                    <%= creator.name %>
                  <% end %>
                  <%= wf_verified(size: 14) %>
                </div>
                <div class="w-sub" style="font-size:12px">@<%= creator.handle %> · <%= wf_ago(item.published_at) %></div>
              </div>
            </div>

            <% if item.item_type.in?(%w[collection collection_drop]) %>
              <span style="font-size:11px;font-weight:800;background:rgba(224,48,106,0.15);color:var(--w-pink);padding:3px 8px;border-radius:12px">
                NEW DROP
              </span>
            <% elsif item.item_type == "live_now" %>
              <span class="w-row" style="font-size:11px;font-weight:800;background:#E0306A;color:#fff;padding:3px 8px;border-radius:12px;gap:4px">
                <span style="width:6px;height:6px;background:#fff;border-radius:50%;animation:pulse 1.5s infinite"></span>
                LIVE
              </span>
            <% end %>
          </div>

          <%# Content Body based on type %>
          <% case item.item_type %>
          <% when "collection", "collection_drop" %>
            <% collection = target %>
            <% cover = collection.cover_post %>

            <%= link_to public_collection_path(creator.handle, collection), style: "display:block;position:relative;background:#000;overflow:hidden;text-decoration:none" do %>
              <% if (src = wf_collection_cover_src(collection)) %>
                <img src="<%= src %>" alt="<%= collection.title %>" style="width:100%;height:380px;object-fit:cover;display:block">
              <% else %>
                <div class="w-center" style="height:260px;background:var(--w-raised);color:var(--w-text-muted)">
                  <%= wf_icon(:image, size: 36) %>
                </div>
              <% end %>

              <%# Overlay Badge: Unlocks & Count %>
              <div style="position:absolute;top:12px;right:12px;display:flex;gap:6px">
                <span style="background:rgba(0,0,0,0.65);backdrop-filter:blur(10px);color:#fff;font-size:11.5px;font-weight:700;padding:4px 9px;border-radius:20px;display:flex;align-items:center;gap:4px">
                  <%= wf_icon(:image, size: 13) %>
                  <%= collection.paid_media_posts.count %> items
                </span>
                <span style="background:rgba(0,0,0,0.65);backdrop-filter:blur(10px);color:var(--w-gold);font-size:11.5px;font-weight:700;padding:4px 9px;border-radius:20px;display:flex;align-items:center;gap:4px">
                  <%= wf_icon(:lock, size: 12) %>
                  Exclusive
                </span>
              </div>
            <% end %>

            <div style="padding:14px;background:var(--w-cards)">
              <h2 style="font-size:16px;font-weight:800;margin:0 0 4px;color:var(--w-text)">
                <%= collection.title %>
              </h2>
              <% if collection.description.present? %>
                <p style="font-size:13px;color:var(--w-text-secondary);margin:0 0 12px;line-height:1.4">
                  <%= truncate(collection.description, length: 120) %>
                </p>
              <% end %>

              <div class="w-row" style="justify-content:space-between;align-items:center;padding-top:6px;border-top:1px solid var(--w-lines)">
                <div style="font-size:13px;color:var(--w-text-secondary)">
                  <% if collection.unlocks_count > 0 %>
                    <span style="color:var(--w-gold);font-weight:700"><%= collection.unlocks_count %> fans unlocked</span>
                  <% else %>
                    <span>Freshly released</span>
                  <% end %>
                </div>

                <%= link_to public_collection_path(creator.handle, collection), class: "w-btn", style: "background:var(--w-pink);color:#fff;font-weight:800;font-size:13px;padding:8px 16px;border-radius:20px;text-decoration:none;display:flex;align-items:center;gap:6px" do %>
                  <%= wf_icon(:lock, size: 14) %>
                  Unlock <%= wf_price(collection.price_cents, collection.currency) %>
                <% end %>
              </div>
            </div>

          <% when "post" %>
            <% post = target %>
            <div style="padding:0 14px 12px">
              <p style="font-size:14.5px;line-height:1.45;color:var(--w-text);margin:0;white-space:pre-wrap"><%= post.body %></p>
            </div>

            <% if post.media.attached? %>
              <div style="position:relative;background:#000">
                <% if post.video? %>
                  <video src="<%= url_for(post.media) %>" controls playsinline style="width:100%;max-height:480px;display:block"></video>
                <% else %>
                  <img src="<%= url_for(post.media) %>" alt="" style="width:100%;max-height:480px;object-fit:cover;display:block">
                <% end %>
              </div>
            <% end %>

            <%# Teased collection CTA if present %>
            <% if post.paid_media_collection.present? %>
              <% col = post.paid_media_collection %>
              <div style="margin:10px 14px 4px;padding:10px 12px;background:var(--w-raised);border-radius:12px;border:1px solid var(--w-lines)" class="w-row">
                <div class="w-grow">
                  <div style="font-size:11px;font-weight:800;color:var(--w-pink)">TEASED VAULT ALBUM</div>
                  <div style="font-size:13px;font-weight:700;color:var(--w-text)"><%= col.title %></div>
                </div>
                <%= link_to public_collection_path(creator.handle, col), class: "w-btn", style: "background:var(--w-pink);color:#fff;font-size:12px;font-weight:700;padding:6px 12px;border-radius:16px;text-decoration:none" do %>
                  Unlock <%= wf_price(col.price_cents, col.currency) %>
                <% end %>
              </div>
            <% end %>

            <div class="w-row" style="padding:10px 14px;gap:16px;color:var(--w-text-muted);font-size:13px;border-top:1px solid var(--w-lines);margin-top:6px">
              <span class="w-row" style="gap:5px;align-items:center">
                <%= wf_icon(:heart, size: 15) rescue wf_icon(:eye, size: 15) %>
                <%= post.likes_count %> likes
              </span>
              <span class="w-row" style="gap:5px;align-items:center">
                <%= wf_icon(:chat, size: 15) %>
                <%= post.comments_count %> comments
              </span>
            </div>

          <% when "live", "live_now" %>
            <% live = target %>
            <div style="padding:16px 14px;background:linear-gradient(180deg, rgba(224,48,106,0.1), var(--w-cards))">
              <div class="w-row" style="gap:8px;margin-bottom:8px">
                <span style="font-size:11px;font-weight:800;background:var(--w-pink);color:#fff;padding:2px 8px;border-radius:10px">
                  <%= live.live? ? "BROADCASTING NOW" : "SCHEDULED LIVE" %>
                </span>
                <span class="w-sub" style="font-size:12px">
                  <%= live.live? ? "Live stream in progress" : wf_ago(live.scheduled_for) %>
                </span>
              </div>
              <h3 style="font-size:16px;font-weight:800;color:var(--w-text);margin:0 0 6px"><%= live.title %></h3>
              <% if live.description.present? %>
                <p style="font-size:13px;color:var(--w-text-secondary);margin:0 0 12px"><%= live.description %></p>
              <% end %>
              <%= link_to live_session_path(live), class: "w-btn", style: "background:var(--w-pink);color:#fff;font-weight:800;font-size:13px;padding:9px 18px;border-radius:20px;text-decoration:none;display:inline-flex;align-items:center;gap:6px" do %>
                <%= wf_icon(:play, size: 14) %>
                <%= live.live? ? "Join Live Stream" : "View Live Info" %>
              <% end %>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>

  <% else %>
    <%# Empty Feed State / Suggested Creators %>
    <div style="padding:32px 16px;text-align:center">
      <div class="w-center" style="width:64px;height:64px;border-radius:50%;background:rgba(224,48,106,0.12);color:var(--w-pink);margin:0 auto 16px">
        <%= wf_icon(:users, size: 28) %>
      </div>
      <h2 style="font-size:20px;font-weight:800;margin:0 0 6px">Your feed is waiting</h2>
      <p class="w-sub" style="font-size:13.5px;margin:0 0 24px;line-height:1.4">
        Follow your favorite creators to see their exclusive collection drops, stories, and live broadcasts here.
      </p>

      <% if @suggested_creators.present? && @suggested_creators.any? %>
        <h3 style="font-size:15px;font-weight:800;text-align:left;margin:0 0 12px;color:var(--w-text)">Suggested Creators</h3>
        <div class="w-stack" style="gap:10px;text-align:left;margin-bottom:24px">
          <% @suggested_creators.each do |c| %>
            <div class="w-row w-card" style="padding:12px;background:var(--w-cards);border:1px solid var(--w-lines);border-radius:14px;justify-content:space-between">
              <div class="w-row" style="gap:10px">
                <%= wf_avatar(c, size: 44) %>
                <div>
                  <div class="w-row" style="gap:4px">
                    <span style="font-size:14px;font-weight:800;color:var(--w-text)"><%= c.name %></span>
                    <%= wf_verified(size: 13) %>
                  </div>
                  <div class="w-sub" style="font-size:12px">@<%= c.handle %> · <%= c.followers_count %> fans</div>
                </div>
              </div>
              <%= link_to profile_path(c.handle), class: "w-btn", style: "background:var(--w-raised);border:1px solid var(--w-lines);color:var(--w-text);font-size:12.5px;font-weight:700;padding:6px 14px;border-radius:16px;text-decoration:none" do %>
                View
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @trending_collections.present? && @trending_collections.any? %>
        <h3 style="font-size:15px;font-weight:800;text-align:left;margin:0 0 12px;color:var(--w-text)">Trending Drops</h3>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;text-align:left">
          <% @trending_collections.each do |tc| %>
            <%= link_to public_collection_path(tc.user.handle, tc), class: "w-card", style: "border:1px solid var(--w-lines);border-radius:12px;overflow:hidden;background:var(--w-cards);text-decoration:none;color:var(--w-text)" do %>
              <% if (src = wf_collection_cover_src(tc)) %>
                <img src="<%= src %>" alt="" style="width:100%;height:140px;object-fit:cover;display:block">
              <% end %>
              <div style="padding:8px 10px">
                <div style="font-size:12px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= tc.title %></div>
                <div class="w-sub" style="font-size:11px">@<%= tc.user.handle %></div>
                <div style="font-size:12px;font-weight:800;color:var(--w-pink);margin-top:4px"><%= wf_price(tc.price_cents, tc.currency) %></div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Bottom Mobile Navigation Bar for Fan PWA %>
  <nav style="position:fixed;bottom:0;left:0;right:0;max-width:480px;margin:0 auto;height:60px;background:rgba(22,22,26,0.92);backdrop-filter:blur(20px);border-top:1px solid var(--w-lines);display:flex;align-items:center;justify-content:space-around;z-index:90">
    <%= link_to feed_path, class: "w-center", style: "flex-direction:column;gap:3px;text-decoration:none;color:var(--w-pink);font-size:11px;font-weight:700" do %>
      <%= wf_icon(:grid, size: 20) %>
      <span>Feed</span>
    <% end %>

    <%= link_to discover_path, class: "w-center", style: "flex-direction:column;gap:3px;text-decoration:none;color:var(--w-text-secondary);font-size:11px;font-weight:600" do %>
      <%= wf_icon(:globe, size: 20) %>
      <span>Explore</span>
    <% end %>

    <%= link_to unlocks_path, class: "w-center", style: "flex-direction:column;gap:3px;text-decoration:none;color:var(--w-text-secondary);font-size:11px;font-weight:600" do %>
      <%= wf_icon(:lock, size: 20) %>
      <span>Vault</span>
    <% end %>

    <%= link_to conversations_path, class: "w-center", style: "flex-direction:column;gap:3px;text-decoration:none;color:var(--w-text-secondary);font-size:11px;font-weight:600" do %>
      <%= wf_icon(:chat, size: 20) %>
      <span>Messages</span>
    <% end %>
  </nav>
</div>
