          <span>Photo / Video</span>
        </button>

        <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-high/60 hover:bg-surface-container-highest border border-white/[0.06] text-outline hover:text-white transition-colors cursor-pointer shrink-0">
          <span class="material-symbols-outlined text-[15px] text-primary">lock</span>
          <span>Attach Vault PPV</span>
        </button>

        <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-high/60 hover:bg-surface-container-highest border border-white/[0.06] text-outline hover:text-white transition-colors cursor-pointer shrink-0">
          <span class="material-symbols-outlined text-[15px]">mic</span>
          <span>Audio Whisper</span>
        </button>

        <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-high/60 hover:bg-surface-container-highest border border-white/[0.06] text-outline hover:text-white transition-colors cursor-pointer shrink-0">
          <span class="material-symbols-outlined text-[15px] text-emerald-400">payments</span>
          <span>UPI Request</span>
        </button>

        <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-high/60 hover:bg-surface-container-highest border border-white/[0.06] text-outline hover:text-white transition-colors cursor-pointer shrink-0">
          <span class="material-symbols-outlined text-[15px] text-[#f5b942]">auto_awesome</span>
          <span>Quick Replies</span>
        </button>
      </div>

      <!-- Chat Input Area -->
      <div class="p-4 border-t border-white/[0.06] bg-surface-container-low/70">
        <% if @conversation %>
          <%= form_with url: conversation_direct_messages_path(@conversation), method: :post, local: true, class: "relative flex items-center" do %>
            <input type="text" name="body" placeholder="Reply to @<%= other_handle %> (Enter to send, Shift+Enter for new line)..." class="w-full bg-surface-container/90 border border-white/[0.08] focus:border-primary/50 focus:ring-1 focus:ring-primary/25 rounded-full pl-5 pr-20 py-3 text-[13px] text-white placeholder:text-outline transition-all" autocomplete="off" />
            <div class="absolute right-2.5 flex items-center gap-1.5">
              <button type="button" class="w-8 h-8 rounded-full text-outline hover:text-white flex items-center justify-center transition-colors cursor-pointer" title="Insert Emoji">
                <span class="material-symbols-outlined text-[18px]">sentiment_satisfied</span>
              </button>
              <button type="submit" class="w-9 h-9 rounded-full bg-gradient-to-r from-primary to-secondary text-white flex items-center justify-center shadow-[0_0_16px_rgba(255,23,103,0.4)] hover:opacity-95 transition-transform hover:scale-105 cursor-pointer" title="Send Message">
                <span class="material-symbols-outlined text-[17px]">send</span>
              </button>
            </div>
          <% end %>
        <% else %>
          <div class="relative flex items-center">
            <input type="text" placeholder="Reply to @<%= other_handle %> (Enter to send, Shift+Enter for new line)..." class="w-full bg-surface-container/90 border border-white/[0.08] focus:border-primary/50 focus:ring-1 focus:ring-primary/25 rounded-full pl-5 pr-20 py-3 text-[13px] text-white placeholder:text-outline transition-all" />
            <div class="absolute right-2.5 flex items-center gap-1.5">
              <button type="button" class="w-8 h-8 rounded-full text-outline hover:text-white flex items-center justify-center transition-colors cursor-pointer" title="Insert Emoji">
                <span class="material-symbols-outlined text-[18px]">sentiment_satisfied</span>
              </button>
              <button type="button" class="w-9 h-9 rounded-full bg-gradient-to-r from-primary to-secondary text-white flex items-center justify-center shadow-[0_0_16px_rgba(255,23,103,0.4)] hover:opacity-95 transition-transform hover:scale-105 cursor-pointer" title="Send Message">
                <span class="material-symbols-outlined text-[17px]">send</span>
              </button>
            </div>
          </div>
        <% end %>
      </div>

      <!-- ============================================== -->
      <!-- PANE 3: Right Patron VIP Dossier / Fan About Panel -->
      <!-- (Overlay drawer: opens when clicking three-dot menu) -->
      <!-- ============================================== -->
      <aside id="patronDossierPanel" class="absolute right-0 top-0 bottom-0 w-[330px] p-5 hidden flex-col gap-5 overflow-y-auto bg-[#18171c]/95 border-l border-white/[0.08] backdrop-blur-2xl z-30 shadow-[-12px_0_35px_rgba(0,0,0,0.6)] select-none transition-all">
        
        <!-- Dossier Header -->
        <div class="flex items-center justify-between pb-3 border-b border-white/[0.06]">
          <div class="flex items-center gap-2 text-white font-bold text-[13.5px]">
            <span class="material-symbols-outlined text-[17px] text-primary">person_search</span>
            <span>Fan About &amp; Intel</span>
          </div>
          <div class="flex items-center gap-1.5">
            <button type="button" class="w-7 h-7 rounded-full bg-white/[0.04] hover:bg-white/[0.08] text-outline hover:text-white flex items-center justify-center transition-colors cursor-pointer" title="Settings">
              <span class="material-symbols-outlined text-[15px]">settings</span>
            </button>
            <button type="button" onclick="toggleFanInfo()" class="w-7 h-7 rounded-full bg-white/[0.06] hover:bg-white/[0.12] text-outline hover:text-white flex items-center justify-center transition-colors cursor-pointer" title="Close Panel">
              <span class="material-symbols-outlined text-[16px]">close</span>
            </button>
          </div>
        </div>

      <!-- Patron Identity & Location -->
      <div class="flex flex-col gap-1">
        <span class="text-outline text-[12px]"><%= stats[:location] %></span>
        <div class="flex items-center gap-2 mt-1">
          <span class="px-2 py-0.5 rounded-full bg-primary/20 border border-primary/30 text-primary text-[10px] font-mono font-bold uppercase tracking-wider">
            <%= stats[:tier] %>
          </span>
        </div>
      </div>

      <!-- Total Direct UPI Volume Bento Card -->
      <div class="p-4 rounded-xl bg-surface-container/70 border border-white/[0.05] flex flex-col gap-1">
        <span class="font-mono text-[10px] uppercase font-bold text-outline tracking-wider">TOTAL DIRECT UPI VOLUME</span>
        <div class="text-[26px] font-extrabold text-white font-mono tracking-tight mt-1">
          <%= money(stats[:spent]) %>
        </div>
        <span class="text-emerald-400 font-mono text-[11px] font-semibold mt-1 flex items-center gap-1">
          <span class="material-symbols-outlined text-[13px]">check_circle</span>
          100% P2P settled • Zero middleman
        </span>
      </div>

      <!-- Verified UPI Address -->
      <div class="p-3.5 rounded-xl bg-surface-container/70 border border-white/[0.05] flex flex-col gap-1">
        <span class="font-mono text-[10px] uppercase font-bold text-outline tracking-wider">VERIFIED UPI ID</span>
        <span class="text-white font-mono text-[13px] font-bold"><%= stats[:upi_id] %></span>
        <span class="text-outline text-[10.5px] mt-0.5">Matched to Bank KYC</span>
      </div>

      <!-- Quick Creator Actions -->
      <div class="flex flex-col gap-2 pt-1">
        <span class="font-mono text-[10px] uppercase font-bold text-outline tracking-wider mb-0.5">QUICK CREATOR ACTIONS</span>
        
        <button type="button" class="w-full py-2.5 px-3.5 rounded-xl bg-gradient-to-r from-primary to-secondary text-white text-[12px] font-bold shadow-[0_0_16px_rgba(255,23,103,0.3)] hover:opacity-95 transition-all flex items-center justify-center gap-1.5 cursor-pointer">
          <span class="material-symbols-outlined text-[15px]">lock</span>
          <span>Send Private Vault Drop</span>
        </button>

        <button type="button" class="w-full py-2 px-3.5 rounded-xl bg-surface-container-high/80 hover:bg-surface-container-highest border border-white/[0.06] text-white text-[12px] font-semibold transition-colors flex items-center justify-center gap-1.5 cursor-pointer">
          <span class="material-symbols-outlined text-[15px] text-[#f5b942]">video_call</span>
          <span>Create 1:1 Booking Slot</span>
        </button>

        <button type="button" class="w-full py-2 px-3.5 rounded-xl bg-surface-container-high/80 hover:bg-surface-container-highest border border-white/[0.06] text-white text-[12px] font-semibold transition-colors flex items-center justify-center gap-1.5 cursor-pointer">
          <span class="material-symbols-outlined text-[15px] text-emerald-400">request_quote</span>
          <span>Custom Price Quote</span>
        </button>
      </div>

      <!-- Recent Patron Activity -->
      <div class="flex flex-col gap-2 pt-2 border-t border-white/[0.04]">
        <span class="font-mono text-[10px] uppercase font-bold text-outline tracking-wider">RECENT ACTIVITY</span>
        
        <div class="flex items-center justify-between text-[11.5px] p-2 rounded-lg bg-surface-container/50">
          <span class="text-white/90">Midnight Silk Drop</span>
          <span class="text-emerald-400 font-mono font-bold">₹499 • Unlocked</span>
        </div>

        <div class="flex items-center justify-between text-[11.5px] p-2 rounded-lg bg-surface-container/50">
          <span class="text-white/90">Live Broadcast Tip</span>
          <span class="text-primary font-mono font-bold">₹500 • Instant UPI</span>
        </div>
      </div>

      <!-- Block Fan Action -->
      <div class="mt-auto pt-3 border-t border-white/[0.04]">
        <%= form_with url: creator_blocks_path, method: :post, local: true do %>
          <%= hidden_field_tag "creator_block[identifier_type]", "username" %>
          <%= hidden_field_tag "creator_block[identifier_value]", other_handle %>
          <button type="submit" class="w-full py-1.5 px-3 rounded-lg border border-white/[0.08] text-outline hover:text-rose-400 hover:border-rose-500/30 text-[11px] font-semibold transition-colors text-center cursor-pointer" data-turbo-confirm="Block @<%= other_handle %>? They will no longer be able to message you.">
            Block Fan
          </button>
        <% end %>
      </div>
      </aside>
    </main>

  </div>
</div>

<script>
  function filterInbox(type) {
    document.querySelectorAll('.inbox-tab').forEach(t => {
      t.className = "inbox-tab px-2 py-1 rounded-lg font-medium text-outline hover:text-white transition-colors cursor-pointer";
    });

    if (type === 'all') {
      document.getElementById('tabInboxAll').className = "inbox-tab px-2.5 py-1 rounded-lg font-bold bg-surface-container-highest text-white transition-colors cursor-pointer";
      document.querySelectorAll('#inboxThreadsList > div').forEach(el => el.style.display = 'flex');
    } else if (type === 'vip') {
      document.getElementById('tabInboxVIP').className = "inbox-tab px-2.5 py-1 rounded-lg font-bold bg-surface-container-highest text-white transition-colors cursor-pointer";
      document.querySelectorAll('#inboxThreadsList > div').forEach(el => {
        el.style.display = el.dataset.category && el.dataset.category.includes('vip') ? 'flex' : 'none';
      });
    } else if (type === 'dms') {
      document.getElementById('tabInboxDMs').className = "inbox-tab px-2.5 py-1 rounded-lg font-bold bg-surface-container-highest text-white transition-colors cursor-pointer";
      document.querySelectorAll('#inboxThreadsList > div').forEach(el => {
        el.style.display = el.dataset.category && el.dataset.category.includes('dms') ? 'flex' : 'none';
      });
    } else if (type === 'unread') {
      document.getElementById('tabInboxUnread').className = "inbox-tab px-2.5 py-1 rounded-lg font-bold bg-primary/20 text-primary transition-colors cursor-pointer";
      document.querySelectorAll('#inboxThreadsList > div').forEach(el => {
        el.style.display = el.dataset.category && el.dataset.category.includes('unread') ? 'flex' : 'none';
      });
    }
  }

  // Real-time thread search
  const searchInput = document.getElementById('conversationSearchInput');
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      document.querySelectorAll('#inboxThreadsList > div').forEach(el => {
        const text = el.innerText.toLowerCase();
        el.style.display = text.includes(q) ? 'flex' : 'none';
      });
    });
  }

  // Toggle Right Fan About / Patron Dossier Panel on three-dot click
  window.toggleFanInfo = function() {
    const panel = document.getElementById('patronDossierPanel');
    if (!panel) return;
    const isHidden = panel.classList.contains('hidden') || panel.style.display === 'none' || getComputedStyle(panel).display === 'none';
    if (isHidden) {
      panel.classList.remove('hidden');
      panel.classList.add('flex');
      panel.style.display = 'flex';
    } else {
      panel.classList.remove('flex');
      panel.classList.add('hidden');
      panel.style.display = 'none';
    }
  };
  window.toggleDossier = window.toggleFanInfo;

  function bindDrawerListeners() {
    const btn = document.getElementById('btnMoreFanInfo');
    if (btn) {
      btn.onclick = function(e) {
        e.preventDefault();
        window.toggleFanInfo();
      };
    }
  }
  document.addEventListener('turbo:load', bindDrawerListeners);
  document.addEventListener('DOMContentLoaded', bindDrawerListeners);
  bindDrawerListeners();

  // Scroll to bottom of chat
  const chatBox = document.getElementById('chatTimeline');
  if (chatBox) {
    chatBox.scrollTop = chatBox.scrollHeight;
  }
</script>
