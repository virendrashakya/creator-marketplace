<% content_for :title, "Messages | Wishful" %>
<% content_for :chrome, "fan" %>

<div class="w-phone">
  <header class="w-topbar w-topbar--line">
    <%= link_to unlocks_path, class: "w-icon-btn", aria: { label: "Your unlocks" } do %><%= wf_icon(:back) %><% end %>
    <span style="font-size:15px;font-weight:800">Messages</span>
    <span style="width:36px"></span>
  </header>
  <% @conversations.each do |c| %>
    <% other = c.other_party(current_user) %>
    <% last = @last_messages[c.id] %>
    <% unread = c.unread_for(current_user).positive? %>
    <%= link_to conversation_path(c), class: "w-inbox-item" do %>
      <%= wf_avatar(other, size: 44) %>
      <div class="w-grow">
        <div class="w-row w-row--between">
          <span style="font-size:14.5px;font-weight:800"><%= other.name %></span>
          <span class="w-dim" style="font-size:11px"><%= last ? wf_ago(last.created_at) : "" %></span>
        </div>
        <div class="w-ellipsis" style="font-size:13px;margin-top:2px;<%= unread ? "font-weight:700" : "color:var(--w-sub)" %>">
          <%= last ? last.body.to_s.gsub(/\[(ppv|collection):\d+\]/, "🔒 Paid media").truncate(70) : "Say hi" %>
        </div>
      </div>
      <% if unread %><span class="w-count w-count--pink"><%= c.unread_for(current_user) %></span><% end %>
    <% end %>
  <% end %>
  <% if @conversations.empty? %>
    <div class="w-center" style="padding:60px 32px;gap:8px">
      <div class="w-big-icon w-big-icon--pink"><%= wf_icon(:chat) %></div>
      <div style="font-size:17px;font-weight:800">No messages yet</div>
      <div class="w-sub" style="font-size:13.5px">Tap Message on a creator's profile to start a conversation.</div>
    </div>
  <% end %>
</div>
