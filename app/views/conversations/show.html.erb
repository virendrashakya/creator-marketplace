<%# 3k. The fan's side of a thread. %>
<% content_for :title, "#{@other.name} | Messages | Wishful" %>
<% content_for :chrome, "fan" %>
<% content_for :head do %>
  <script src="/assets/js/actioncable.js" data-turbo-track="reload" defer></script>
  <script src="/assets/js/chat.js" data-turbo-track="reload" defer></script>
<% end %>

<section class="w-chat" data-chat="dm" data-conversation-id="<%= @conversation.id %>" data-me="<%= current_user.id %>">
  <header class="w-chat-head">
    <%= link_to conversations_path, class: "w-icon-btn", aria: { label: "Back to messages" } do %><%= wf_icon(:back) %><% end %>
    <%= link_to profile_path(@other.handle), class: "w-row w-grow", style: "gap:12px" do %>
      <%= wf_avatar(@other, size: 36) %>
      <div>
        <div style="font-size:15px;font-weight:800"><%= @other.name %></div>
        <% if @close_friend %>
          <div class="w-gold" style="font-size:11.5px;font-weight:700">★ Close Friends · priority</div>
        <% else %>
          <div class="w-sub" style="font-size:11.5px">@<%= @other.handle %></div>
        <% end %>
      </div>
    <% end %>
  </header>

  <ol class="w-chat-log" data-chat-log>
    <% if @messages.any? %>
      <li class="w-chat-day"><%= @messages.first.created_at.today? ? "Today #{wf_time(@messages.first.created_at)}" : @messages.first.created_at.strftime("%-d %b, %-l:%M %p") %></li>
    <% end %>
    <% @messages.each do |m| %><%= render "conversations/message", message: m %><% end %>
  </ol>

  <%= form_with url: conversation_direct_messages_path(@conversation), method: :post, local: true, class: "w-chat-form", data: { chat_form: true } do %>
    <% if @other.wishlists.any? %>
      <%= link_to spoil_me_path(@other.handle), class: "w-round-btn w-gold", style: "width:42px;height:42px;font-weight:800;font-size:15px", title: "Send a gift", aria: { label: "Send #{@other.first_name} a gift" } do %>₹<% end %>
    <% end %>
    <label class="w-sr" for="dm_body">Message</label>
    <input type="text" name="body" id="dm_body" maxlength="2000" placeholder="Message…" autocomplete="off" class="chat-input">
    <button type="submit" class="w-chat-send" aria-label="Send"><%= wf_icon(:send) %></button>
  <% end %>
</section>
