<% content_for :title, "Explore & Trending Drops | Wishful" %>
<% content_for :chrome, "fan" %>

<div class="w-phone">
  <%# Top Bar %>
  <header class="w-topbar">
    <div class="w-row" style="gap:10px">
      <span class="w-brand-mark">W</span>
      <span style="font-size:18px;font-weight:800;letter-spacing:-.02em">Wishful</span>
    </div>
    <div class="w-topbar-actions">
      <%= render "shared/theme_switch", compact: true %>
      <%= link_to conversations_path, class: "w-icon-btn", aria: { label: "Messages" } do %>
        <%= wf_icon(:chat) %>
      <% end %>
      <%= link_to unlocks_path, class: "w-icon-btn", aria: { label: "Your Unlocks" } do %>
        <%= wf_icon(:lock) %>
      <% end %>
    </div>
  </header>

  <%# Tab Strip: Feed vs Discover %>
  <div class="w-row" style="padding:10px 16px;gap:12px;border-bottom:1px solid var(--w-lines)">
    <%= link_to feed_path, class: "w-pill", style: "background:var(--w-raised);color:var(--w-text-muted);font-weight:600;padding:6px 14px;border-radius:20px;font-size:13px;text-decoration:none" do %>
      Following
    <% end %>
    <%= link_to discover_path, class: "w-pill", style: "background:var(--w-pink);color:#fff;font-weight:700;padding:6px 14px;border-radius:20px;font-size:13px;text-decoration:none" do %>
      Explore & Drops
    <% end %>
  </div>

  <%# Categories horizontal scroller %>
  <% if @categories.any? %>
    <div style="padding:12px 16px;overflow-x:auto;display:flex;gap:8px;scrollbar-width:none">
      <%= link_to discover_path, class: "w-pill", style: "padding:5px 12px;border-radius:16px;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap;#{params[:category].blank? ? 'background:var(--w-text);color:var(--w-page)' : 'background:var(--w-cards);border:1px solid var(--w-lines);color:var(--w-text)'}" do %>
        All
      <% end %>
      <% @categories.each do |cat| %>
        <%= link_to discover_path(category: cat), class: "w-pill", style: "padding:5px 12px;border-radius:16px;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap;#{params[:category] == cat ? 'background:var(--w-pink);color:#fff' : 'background:var(--w-cards);border:1px solid var(--w-lines);color:var(--w-text)'}" do %>
          <%= cat.capitalize %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <div class="w-stack" style="padding:10px 16px 80px;gap:24px">
    <%# Upcoming or Live Sessions %>
    <% if @upcoming_lives.any? %>
      <section>
        <div class="w-row" style="justify-content:space-between;margin-bottom:10px">
          <h2 style="font-size:15px;font-weight:800;margin:0;color:var(--w-text);display:flex;align-items:center;gap:6px">
            <span style="width:8px;height:8px;background:var(--w-pink);border-radius:50%"></span>
            Live Now & Upcoming
          </h2>
        </div>
        <div class="w-stack" style="gap:8px">
          <% @upcoming_lives.each do |live| %>
            <%= link_to live_session_path(live), class: "w-card w-row", style: "padding:12px;background:var(--w-cards);border:1px solid var(--w-lines);border-radius:14px;text-decoration:none;color:var(--w-text);justify-content:space-between" do %>
              <div>
                <div style="font-size:13.5px;font-weight:800"><%= live.title %></div>
                <div class="w-sub" style="font-size:12px;margin-top:2px">@<%= live.user.handle %> · <%= live.live? ? "Streaming now" : wf_ago(live.scheduled_for) %></div>
              </div>
              <span class="w-btn" style="background:var(--w-pink);color:#fff;font-size:12px;font-weight:700;padding:6px 12px;border-radius:16px">
                <%= live.live? ? "Watch" : "RSVP" %>
              </span>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>

    <%# Trending Vault Collections %>
    <section>
      <div class="w-row" style="justify-content:space-between;margin-bottom:12px">
        <h2 style="font-size:16px;font-weight:800;margin:0;color:var(--w-text)">Trending Vault Collections</h2>
        <span class="w-sub" style="font-size:12px">Direct UPI Unlocks</span>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <% @trending_collections.each do |c| %>
          <%= link_to public_collection_path(c.user.handle, c), class: "w-card", style: "border:1px solid var(--w-lines);border-radius:14px;overflow:hidden;background:var(--w-cards);text-decoration:none;color:var(--w-text);display:flex;flex-direction:column" do %>
            <div style="position:relative;background:#000;height:180px">
              <% if (src = wf_collection_cover_src(c)) %>
                <img src="<%= src %>" alt="" style="width:100%;height:100%;object-fit:cover;display:block">
              <% end %>
              <div style="position:absolute;top:8px;right:8px;background:rgba(0,0,0,0.65);backdrop-filter:blur(8px);color:var(--w-gold);font-size:10.5px;font-weight:800;padding:3px 7px;border-radius:12px;display:flex;align-items:center;gap:3px">
                <%= wf_icon(:lock, size: 10) %>
                <%= c.paid_media_posts.count %>
              </div>
            </div>

            <div style="padding:10px;display:flex;flex-direction:column;flex-grow:1;justify-content:space-between">
              <div>
                <div style="font-size:13px;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= c.title %></div>
                <div class="w-sub" style="font-size:11.5px;margin-top:2px">@<%= c.user.handle %></div>
              </div>

              <div class="w-row" style="justify-content:space-between;margin-top:10px;align-items:center">
                <span style="font-size:13px;font-weight:800;color:var(--w-pink)">
                  <%= wf_price(c.price_cents, c.currency) %>
                </span>
                <span style="font-size:11px;color:var(--w-text-muted)">
                  <%= c.unlocks_count %> unlocked
                </span>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>

    <%# Top Creators %>
    <section>
      <div class="w-row" style="justify-content:space-between;margin-bottom:12px">
        <h2 style="font-size:16px;font-weight:800;margin:0;color:var(--w-text)">Featured Creators</h2>
      </div>

      <div class="w-stack" style="gap:10px">
        <% @featured_creators.each do |u| %>
          <div class="w-card w-row" style="padding:12px;background:var(--w-cards);border:1px solid var(--w-lines);border-radius:14px;justify-content:space-between;align-items:center">
            <div class="w-row" style="gap:12px">
              <%= link_to profile_path(u.handle) do %>
                <%= wf_avatar(u, size: 48) %>
              <% end %>
              <div>
                <div class="w-row" style="gap:4px">
                  <%= link_to profile_path(u.handle), style: "font-size:14.5px;font-weight:800;color:var(--w-text);text-decoration:none" do %>
                    <%= u.name %>
                  <% end %>
                  <%= wf_verified(size: 14) %>
                </div>
                <div class="w-sub" style="font-size:12px">@<%= u.handle %> · <%= u.followers_count %> followers</div>
                <% if u.creator_category.present? %>
                  <span style="font-size:10.5px;font-weight:700;color:var(--w-text-secondary);background:var(--w-raised);padding:2px 6px;border-radius:8px;margin-top:4px;display:inline-block">
                    <%= u.creator_category.capitalize %>
                  </span>
                <% end %>
              </div>
            </div>

            <%= link_to profile_path(u.handle), class: "w-btn", style: "background:var(--w-pink);color:#fff;font-size:12.5px;font-weight:700;padding:6px 16px;border-radius:18px;text-decoration:none" do %>
              Visit
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  </div>

  <%# Bottom Navigation Bar %>
  <nav style="position:fixed;bottom:0;left:0;right:0;max-width:480px;margin:0 auto;height:60px;background:rgba(22,22,26,0.92);backdrop-filter:blur(20px);border-top:1px solid var(--w-lines);display:flex;align-items:center;justify-content:space-around;z-index:90">
    <%= link_to feed_path, class: "w-center", style: "flex-direction:column;gap:3px;text-decoration:none;color:var(--w-text-secondary);font-size:11px;font-weight:600" do %>
      <%= wf_icon(:grid, size: 20) %>
      <span>Feed</span>
    <% end %>

    <%= link_to discover_path, class: "w-center", style: "flex-direction:column;gap:3px;text-decoration:none;color:var(--w-pink);font-size:11px;font-weight:700" do %>
      <%= wf_icon(:globe, size: 20) %>
      <span>Explore</span>
    <% end %>

    <%= link_to unlocks_path, class: "w-center", style: "flex-direction:column;gap:3px;text-decoration:none;color:var(--w-text-secondary);font-size:11px;font-weight:600" do %>
      <%= wf_icon(:lock, size: 20) %>
      <span>Vault</span>
    <% end %>

    <%= link_to conversations_path, class: "w-center", style: "flex-direction:column;gap:3px;text-decoration:none;color:var(--w-text-secondary);font-size:11px;font-weight:600" do %>
      <%= wf_icon(:chat, size: 20) %>
      <span>Messages</span>
    <% end %>
  </nav>
</div>
