<article class="public-card"><% if item.image_url.present? %><%= image_tag item.image_url, class: "public-image", alt: "" %><% else %><div class="public-image" style="display:grid;place-items:center">🎁</div><% end %><div><div class="public-title"><%= item.title %></div><div class="public-note"><%= item.note %> · ₹<%= item.remaining_cents / 100.0 %> remaining</div><% if item.status == "available" %><div style="margin-top:8px"><% if signed_in? %><%= button_to "Gift this", contribute_wishlist_item_path(item), class: "button pink", style: "padding:8px 11px;font-size:12px" %><% else %><%= link_to "Sign in to gift", sign_in_path, class: "button pink", style: "padding:8px 11px;font-size:12px" %><% end %></div><% else %><span style="color:#43845e;font-size:12px;font-weight:700">Funded — thank you!</span><% end %></div><span class="arrow">🎁</span></article>
