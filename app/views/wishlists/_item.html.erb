<% raised = item.raised_cents %>
<% target = item.target_cents.to_i %>
<% remaining = item.remaining_cents %>
<% pct = target.positive? ? [ raised * 100 / target, 100 ].min : 0 %>
<% funded = item.remaining_cents.zero? %>
<article class="wish">
  <div>
    <div class="wish-title break"><%= item.title %></div>
    <% if item.note.present? %><div class="wish-note clamp-2"><%= item.note %></div><% end %>
  </div>

  <div>
    <div class="wish-figures">
      <span class="wish-raised"><%= item.money_label(raised) %></span>
      <span class="wish-of">of <%= item.money_label(target) %></span>
    </div>
    <div class="wish-track">
      <div class="wish-bar <%= "wish-bar--funded" if funded %>" style="width: <%= pct %>%"></div>
    </div>
    <div class="wish-status <%= "wish-status--funded" if funded %>">
      <% if funded %>
        Funded, thank you
      <% elsif raised.zero? %>
        Nothing yet, be the first
      <% else %>
        <%= item.money_label(remaining) %> still needed
      <% end %>
      <span class="visually-hidden">(<%= pct %> percent funded)</span>
    </div>
  </div>

  <% if item.open_for_gifts? %>
    <% if signed_in? && item.wishlist.user.accepts_upi_manual? %>
      <%= link_to "Gift towards this", new_payment_claim_path(purchasable_type: "WishlistItem", purchasable_id: item.id),
            class: "btn btn--accent btn--block" %>
    <% elsif signed_in? %>
      <%= form_with url: contribute_wishlist_item_path(item), method: :post do %>
        <div class="field">
          <%= label_tag "gift_amount_#{item.id}", "Amount (#{minor_unit_hint(item.currency)})", class: "field-label" %>
          <%= number_field_tag :amount_cents, remaining, id: "gift_amount_#{item.id}",
                min: 1, max: remaining, step: 1, inputmode: "numeric", class: "num",
                aria: { describedby: "gift_hint_#{item.id}" } %>
          <small id="gift_hint_<%= item.id %>"><%= item.money_label(remaining) %> is <%= number_with_delimiter(remaining) %> <%= minor_unit_hint(item.currency) %>.</small>
        </div>
        <div class="field">
          <%= label_tag "gift_message_#{item.id}", "Note (optional)", class: "field-label" %>
          <%= text_field_tag :message, nil, id: "gift_message_#{item.id}", maxlength: 200, placeholder: "Say something kind" %>
        </div>
        <%= submit_tag "Gift towards this", class: "btn btn--accent btn--block", data: { disable_with: "Gifting…" } %>
      <% end %>
    <% else %>
      <%= link_to "Sign in to gift", sign_in_path, class: "btn btn--accent btn--block" %>
    <% end %>
  <% else %>
    <span class="badge badge--ok">Fully funded</span>
  <% end %>
</article>
