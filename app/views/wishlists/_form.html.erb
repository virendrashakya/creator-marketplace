<%= form_with model: @wishlist do |f| %><%= render "shared/errors", record: @wishlist %><div class="field"><%= f.label :title %><%= f.text_field :title, placeholder: "My birthday wishlist" %></div><div class="field"><%= f.label :description %><%= f.text_area :description, placeholder: "A small note for supporters" %></div><div class="field"><label><%= f.check_box :published %> Show on my public profile</label></div><div class="form-actions"><%= f.submit class: "button pink" %><%= link_to "Cancel", dashboard_path, class: "button light" %></div><% end %>
